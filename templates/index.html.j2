<!doctype html>
<html lang="de-CH">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Radar</title>
<meta name="description" content="Newsradar für Paid Search: Neuigkeiten, Studien und Trends aus ausgewählten Quellen.">
<link rel="icon" href="logo.svg" type="image/svg+xml">
<link rel="icon" href="favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="manifest" href="site.webmanifest">
<meta name="apple-mobile-web-app-title" content="Radar">
<meta property="og:type" content="website">
<meta property="og:title" content="Radar">
<meta property="og:description" content="Newsradar für Paid Search">
{% if site_url %}<meta property="og:url" content="{{ site_url }}">
<meta property="og:image" content="{{ site_url }}og.png">{% endif %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script>
  // Seitenleiste: gespeicherte Wahl, sonst auf breiten Bildschirmen aufgeklappt
  try {
    var rail = localStorage.getItem("psn-rail");
    if (rail === "collapsed" || (rail === null && window.innerWidth < 1200)) document.documentElement.classList.add("rail-collapsed");
  } catch (e) {}
</script>
<style>
/* Ruhige, moderne Flächen: neutraler Grund, weisse Karten mit feiner Kante, Systemblau */
:root {
  --bg: #f5f5f7; --card: #ffffff; --text: #0b0b0c; --label2: #6e6e76; --label3: #9a9aa1;
  --fill: rgba(118,118,128,.12); --hover: rgba(118,118,128,.08); --sep: rgba(0,0,0,.08); --accent: #0a66ff; --accent-soft: rgba(10,102,255,.1);
  --green: #1f9d55; --orange: #e8890c; --purple: #8b5cf6; --red: #e5383b; --teal: #0d9488;
  --shadow: 0 1px 2px rgba(0,0,0,.04); --shadow-lg: 0 16px 40px rgba(0,0,0,.16), 0 2px 6px rgba(0,0,0,.06);
  --glass: rgba(245,245,247,.78);
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #000000; --card: #141416; --text: #f5f5f7; --label2: #9b9ba3; --label3: #6e6e76;
    --fill: rgba(118,118,128,.24); --hover: rgba(118,118,128,.16); --sep: rgba(255,255,255,.09); --accent: #3b8bff; --accent-soft: rgba(59,139,255,.16);
    --shadow: none; --shadow-lg: 0 16px 40px rgba(0,0,0,.6); --glass: rgba(0,0,0,.72);
  }
}
:root[data-theme="dark"] {
  --bg: #000000; --card: #141416; --text: #f5f5f7; --label2: #9b9ba3; --label3: #6e6e76;
  --fill: rgba(118,118,128,.24); --hover: rgba(118,118,128,.16); --sep: rgba(255,255,255,.09); --accent: #3b8bff; --accent-soft: rgba(59,139,255,.16);
  --shadow: none; --shadow-lg: 0 16px 40px rgba(0,0,0,.6); --glass: rgba(0,0,0,.72); color-scheme: dark;
}
:root[data-theme="light"] { color-scheme: light; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-feature-settings: "cv11", "ss01"; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%; }
button, input, select { font: inherit; color: inherit; }
a { color: var(--accent); }
svg { flex: none; }

/* Grundraster: schmale Navigation links, Inhalt mittig */
.app { display: grid; grid-template-columns: 252px minmax(0, 1fr); min-height: 100vh; }
.rail { position: sticky; top: 0; height: 100vh; overflow: auto; padding: 22px 14px; border-right: 1px solid var(--sep);
  display: flex; flex-direction: column; gap: 2px; scrollbar-width: none; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); padding: 0 10px 18px; }
.brand img { width: 32px; height: 32px; border-radius: 8px; }
.brand b { font-weight: 800; font-size: 1.15rem; letter-spacing: -.03em; }
.nav button, .rail-btn { display: flex; align-items: center; gap: 12px; width: 100%; background: none; border: 0; border-radius: 10px;
  padding: 9px 10px; cursor: pointer; font-size: .95rem; font-weight: 500; text-align: left; color: var(--text); }
.nav button:hover, .rail-btn:hover { background: var(--hover); }
.nav button[aria-selected="true"], .nav button[aria-pressed="true"], .rail-btn[aria-pressed="true"] { background: var(--fill); font-weight: 650; }
.nav svg, .rail-btn svg { width: 22px; height: 22px; }
.nav .n { margin-left: auto; color: var(--label2); font-size: .8rem; font-weight: 500; }
.nav-title { font-size: .75rem; font-weight: 600; color: var(--label2); text-transform: uppercase; letter-spacing: .06em; margin: 22px 10px 6px; }
.topic-nav button { font-size: .9rem; padding: 7px 10px; }
.topic-nav .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--label3); margin: 0 3px; flex: none; }
.topic-nav .dot.w2 { background: var(--orange); } .topic-nav .dot.w3 { background: var(--red); }
.rail-foot { margin-top: auto; padding-top: 16px; }
.hero { margin-top: 4px; }

.side-search { position: relative; display: block; margin: 0 0 14px; }
.side-search svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); width: 15px; height: 15px; color: var(--label2); }
.side-search input { width: 100%; height: 36px; background: var(--fill); border: 0; border-radius: 10px; padding: 0 10px 0 33px; font-size: .92rem; }
.side-search input::placeholder { color: var(--label2); }
.side-search input:focus { outline: 2px solid var(--accent-soft); background: var(--card); }
.content { width: 100%; max-width: 700px; margin: 0 auto; padding: 24px 24px 60px; min-width: 0; }
.top { position: sticky; top: 0; z-index: 20; display: none; align-items: center; justify-content: flex-start; gap: 8px; min-height: 64px; margin: 0 -24px 4px; padding: 12px 24px;
  background: var(--glass); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid transparent; transition: border-color .2s, padding .2s; }
.top.scrolled { border-bottom-color: var(--sep); }
.eyebrow { font-size: .76rem; font-weight: 600; color: var(--label2); text-transform: uppercase; letter-spacing: .06em; margin: 0; }
.search { position: relative; flex: 1; display: none; }
.top.searching .search, .top.searching .search-cancel { display: block; }
.top.searching .chips, .top.searching .search-btn { display: none !important; }
.search-cancel { display: none; white-space: nowrap; }
.search-btn { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--fill); color: var(--text); display: grid; place-items: center; cursor: pointer; flex: none; }
.search-btn:hover { background: var(--hover); }
.search-btn svg { width: 18px; height: 18px; }
.search svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--label2); }
.search input { width: 100%; height: 42px; background: var(--fill); border: 0; border-radius: 12px; padding: 0 12px 0 36px; font-size: 16px; }
.search input::placeholder { color: var(--label2); }
.search input:focus { outline: 2px solid var(--accent-soft); background: var(--card); }

/* Themen-Chips (schmale Bildschirme) */
.chips { display: none; flex: 1; min-width: 0; gap: 8px; overflow-x: auto; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex: none; border: 0; background: var(--fill); border-radius: 999px; padding: 7px 14px; cursor: pointer; font-size: .88rem; font-weight: 550; white-space: nowrap; }
.chip:hover { background: var(--hover); }
.chip[aria-pressed="true"] { background: var(--text); color: var(--bg); }
.chip .n { opacity: .6; font-weight: 500; font-size: .85em; margin-left: 5px; }
.chip.trend { background: var(--accent-soft); color: var(--accent); }

.card { background: var(--card); border-radius: 18px; border: 1px solid var(--sep); box-shadow: var(--shadow); margin-bottom: 14px; }
.active-filter { display: flex; gap: 8px; align-items: center; margin: 4px 0 12px; font-size: .92rem; color: var(--label2); }
.active-filter button { background: var(--accent-soft); color: var(--accent); border: 0; border-radius: 999px; padding: 6px 12px; cursor: pointer; font-weight: 600; }
.link { background: none; border: 0; padding: 0; color: var(--accent); cursor: pointer; font-size: inherit; font-weight: 600; }
.muted, .n { color: var(--label2); }

/* Heute: Briefing */
.hero { padding: 22px 22px 20px; }
.hero .eyebrow { color: var(--accent); }
.brief-text { font-size: 1.12rem; line-height: 1.6; letter-spacing: -.005em; margin: 10px 0 12px; }
.brief-by { font-size: .8rem; color: var(--label2); margin: 0 0 16px; }
.chip-row { display: flex; flex-wrap: wrap; gap: 6px; }
.hero .chip { font-size: .82rem; padding: 5px 11px; }

/* Beiträge */
.post { overflow: hidden; }
.post-head { display: flex; gap: 10px; align-items: center; padding: 14px 18px 8px; }
.avatar { position: relative; width: 38px; height: 38px; border-radius: 10px; flex: none; display: grid; place-items: center;
  font-weight: 700; font-size: .8rem; color: #fff; background: hsl(var(--h, 210) 55% 50%); overflow: hidden; box-shadow: inset 0 0 0 1px var(--sep); }
.avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #fff; }
.who { min-width: 0; flex: 1; line-height: 1.3; }
.who .src { display: block; background: none; border: 0; padding: 0; font-weight: 600; font-size: .93rem; cursor: pointer;
  max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: left; }
.who .src:hover { text-decoration: underline; }
.who .sub { color: var(--label2); font-size: .8rem; }
.badge { border-radius: 999px; padding: 3px 9px; font-size: .72rem; font-weight: 600; background: rgba(31,157,85,.12); color: var(--green); }
.post-body { padding: 0 18px 12px; }
.post-body h2 { font-size: 1.12rem; font-weight: 700; letter-spacing: -.015em; line-height: 1.32; margin: 0 0 5px; }
.post-body h2 a { color: inherit; text-decoration: none; }
.post-body h2 a:hover { text-decoration: underline; }
.post-body p { margin: 0; font-size: .94rem; color: var(--label2); overflow-wrap: anywhere; }
.tags { display: flex; flex-wrap: wrap; gap: 6px; }
.tag { background: var(--fill); border: 0; border-radius: 999px; padding: 3px 10px; color: var(--text); font-size: .8rem; font-weight: 550; cursor: pointer; }
.tag:hover { background: var(--accent-soft); color: var(--accent); }
.post-img { display: block; margin: 2px 18px 6px; border-radius: 12px; overflow: hidden; background: var(--fill); }
.post-img img { width: 100%; max-height: 360px; aspect-ratio: 1.91 / 1; object-fit: cover; display: block; }
.actions { position: relative; display: flex; justify-content: flex-end; gap: 2px; padding: 2px 10px 8px; }
.actions > button { display: flex; gap: 6px; align-items: center; background: none; border: 0; padding: 8px 12px; min-height: 40px;
  color: var(--label2); font-size: .86rem; font-weight: 550; cursor: pointer; border-radius: 10px; }
.actions > button:hover { background: var(--hover); color: var(--text); }
.actions svg { width: 19px; height: 19px; }
.post.is-fav .act-favs { color: var(--purple); }
.post.is-blog .act-blog { color: var(--teal); }
.post.is-fav .act-favs svg path, .post.is-blog .act-blog svg path { fill: currentColor; }
.menu { position: absolute; right: 8px; bottom: 48px; z-index: 5; background: var(--card); border-radius: 14px; border: 1px solid var(--sep); box-shadow: var(--shadow-lg); padding: 6px; min-width: 260px; }
.menu button { display: block; width: 100%; text-align: left; background: none; border: 0; padding: 10px 12px; border-radius: 8px; cursor: pointer; font-size: .93rem; font-weight: 550; }
.menu button:hover { background: var(--hover); }
.seen-line { display: flex; align-items: center; gap: 12px; color: var(--label2); font-size: .8rem; font-weight: 600; margin: 8px 0 22px; }
.seen-line::before, .seen-line::after { content: ""; flex: 1; border-top: 1px solid var(--sep); }
.empty { color: var(--label2); padding: 48px 20px; text-align: center; }

/* Gemerkt */
.seg { display: inline-flex; background: var(--fill); border-radius: 10px; padding: 2px; }
.seg button { background: none; border: 0; border-radius: 8px; padding: 6px 14px; cursor: pointer; font-weight: 550; font-size: .88rem; }
.seg button[aria-pressed="true"] { background: var(--card); box-shadow: 0 1px 3px rgba(0,0,0,.12); font-weight: 650; }
.list-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 4px 0 14px; flex-wrap: wrap; }
.form { padding: 18px; display: grid; gap: 10px; }
.form input, .form select, .form textarea { width: 100%; background: var(--fill); border: 0; border-radius: 10px; padding: 10px 12px; font-size: 16px; }
.form textarea { font: inherit; font-size: 16px; line-height: 1.45; resize: vertical; min-height: 44px; field-sizing: content; }
.form input:focus, .form select:focus, .form textarea:focus { outline: 2px solid var(--accent-soft); background: var(--card); }
.form .row { display: flex; gap: 10px; flex-wrap: wrap; }
.form .row > * { flex: 1 1 160px; }
.form label { font-size: .84rem; color: var(--label2); font-weight: 500; }
.form label input, .form label select { margin-top: 4px; }
.form label input[type=number] { width: 90px; }
.form .check { display: flex; gap: 8px; align-items: center; color: var(--text); font-size: .93rem; }
.form .check input { width: auto; margin: 0; }
.btn { background: var(--accent); color: #fff; border: 0; border-radius: 999px; padding: 9px 18px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; }
.btn.plain { background: var(--fill); color: var(--text); }

/* Profil-Umschalter */
.profile-seg { display: flex; margin: 0 0 16px; }
#admin .group-title:first-child { margin-top: 0; }
.profile-seg button { flex: 1; text-align: center; white-space: nowrap; padding: 7px 6px; font-size: .86rem; }
#savedHint { font-size: .85rem; }

/* Briefing-Feed */
.month { font-size: 1.15rem; font-weight: 800; letter-spacing: -.02em; margin: 30px 4px 12px; }
#briefingView .month:first-of-type { margin-top: 6px; }
.trend-now { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 4px 0 6px; font-size: .85rem; }
.trend-now .n { margin-right: 4px; }
.hero.day { margin-bottom: 22px; }
.day-head { margin: 0 0 6px; }
.day-week { display: block; font-size: .8rem; font-weight: 650; color: var(--accent); text-transform: uppercase; letter-spacing: .05em; }
.day-date { font-size: 1.6rem; font-weight: 800; letter-spacing: -.03em; line-height: 1.15; margin: 2px 0 0; }
.hero.day .chip-row { margin: 4px 0 10px; }

/* Briefing: die drei wichtigsten Punkte */
.points { margin: 4px 0 14px; border-top: 1px solid var(--sep); }
.points-title { font-size: .74rem; font-weight: 650; color: var(--label2); text-transform: uppercase; letter-spacing: .06em; margin: 14px 0 4px; }
.point { display: flex; gap: 12px; padding: 10px 0; text-decoration: none; color: var(--text); border-bottom: 1px solid var(--sep); }
.point:last-child { border-bottom: 0; }
.point img { width: 26px; height: 26px; border-radius: 7px; flex: none; background: var(--fill); margin-top: 2px; }
.point b { display: block; font-size: .95rem; font-weight: 650; line-height: 1.35; }
.point .why { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: .88rem; color: var(--text); opacity: .8; margin-top: 2px; line-height: 1.45; }
.point .src { display: block; font-size: .76rem; color: var(--label2); margin-top: 3px; }
.point:hover b { text-decoration: underline; }

/* Einstellungen: gruppierte Listen wie in den iOS-Einstellungen */
.group-title { font-size: .76rem; font-weight: 650; color: var(--label2); text-transform: uppercase; letter-spacing: .06em; margin: 26px 6px 8px; display: flex; gap: 6px; }
#admin .group-title:first-child { margin-top: 4px; }
.group { padding: 0; overflow: hidden; margin-bottom: 6px; }
.group-note { font-size: .8rem; color: var(--label2); margin: 0 6px 6px; line-height: 1.45; }
.row { border-top: 1px solid var(--sep); }
.group > .row:first-child, .group > .setting:first-child { border-top: 0; }
.row > summary { list-style: none; display: flex; align-items: center; gap: 12px; padding: 11px 14px; min-height: 58px; cursor: pointer; }
.row > summary::-webkit-details-marker { display: none; }
.row > summary:hover { background: var(--hover); }
.row.line { display: flex; align-items: center; gap: 10px; padding: 10px 14px; min-height: 52px; }
.row.line input { flex: 1; min-width: 0; background: var(--fill); border: 0; border-radius: 10px; padding: 9px 12px; font-size: 16px; }
.fav { width: 32px; height: 32px; border-radius: 8px; flex: none; background: var(--fill); object-fit: cover; }
.plus { width: 32px; height: 32px; border-radius: 8px; flex: none; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); font-size: 1.2rem; font-weight: 600; }
.row .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--label3); margin: 0 10px; flex: none; }
.row .dot.w2 { background: var(--orange); } .row .dot.w3 { background: var(--red); }
.row-main { flex: 1; min-width: 0; }
.row-main b { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-weight: 600; font-size: .95rem; line-height: 1.3; overflow-wrap: anywhere; }
.row-main > span { display: block; font-size: .8rem; color: var(--label2); }
.chev { width: 16px; height: 16px; color: var(--label3); flex: none; transition: transform .2s; }
details[open] > summary .chev { transform: rotate(90deg); }
.row-body { padding: 2px 14px 16px 58px; }
.votes { display: flex; gap: 2px; }
.vote { width: 36px; height: 36px; border-radius: 50%; border: 0; background: none; color: var(--label3); display: grid; place-items: center; cursor: pointer; }
.vote:hover { background: var(--fill); color: var(--text); }
.vote svg { width: 19px; height: 19px; }
.vote[data-vote="1"][aria-pressed="true"] { color: var(--green); background: rgba(31,157,85,.12); }
.vote[data-vote="-1"][aria-pressed="true"] { color: var(--orange); background: rgba(232,137,12,.12); }
.vote[data-vote="1"][aria-pressed="true"] svg path, .vote[data-vote="-1"][aria-pressed="true"] svg path { fill: currentColor; }
.row.is-muted .row-main b { color: var(--label2); text-decoration: line-through; }
.facts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; margin: 0 0 14px; }
.facts span { display: block; font-size: .76rem; color: var(--label2); }
.facts b { font-size: .92rem; font-weight: 600; overflow-wrap: anywhere; }
.row-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.btn.danger { color: var(--red); }
.hits { margin: 0 0 12px; padding-left: 18px; font-size: .88rem; line-height: 1.45; }
.hits li { margin: 4px 0; }
.x { width: 32px; height: 32px; border-radius: 50%; border: 0; background: var(--fill); color: var(--label2); cursor: pointer; flex: none; }
.x:hover { color: var(--red); }
.setting { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding: 12px 14px; min-height: 52px; border-top: 1px solid var(--sep); font-size: .95rem; }
.setting.stack { flex-direction: column; align-items: stretch; gap: 8px; }
.setting.end { justify-content: flex-end; }
.setting .ctl { display: flex; align-items: center; gap: 8px; color: var(--label2); font-size: .9rem; }
.setting input[type=number] { width: 70px; text-align: center; }
.setting input[type=number], .setting select, .setting textarea, .form.flat input, .form.flat select, .form.flat textarea {
  background: var(--fill); border: 0; border-radius: 10px; padding: 8px 10px; font-size: 16px; color: var(--text); }
.setting textarea, .form.flat textarea { width: 100%; font: inherit; font-size: 16px; line-height: 1.45; resize: vertical; field-sizing: content; min-height: 42px; }
.form.flat { padding: 0; display: grid; gap: 10px; }
.form.flat .row2 { display: flex; gap: 10px; flex-wrap: wrap; } .form.flat .row2 > * { flex: 1 1 140px; }
.switch { appearance: none; -webkit-appearance: none; width: 50px; height: 30px; border-radius: 999px; background: var(--fill); position: relative; cursor: pointer; flex: none; transition: background .2s; margin: 0; }
.switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 26px; height: 26px; border-radius: 50%; background: #fff; box-shadow: 0 2px 4px rgba(0,0,0,.2); transition: transform .2s; }
.switch:checked { background: var(--green); }
.switch:checked::after { transform: translateX(20px); }

/* Tab-Leiste unten (Handy), durchscheinend */
.tabbar { display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; background: var(--glass); border-top: 1px solid var(--sep);
  -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); padding-bottom: env(safe-area-inset-bottom); }
.tabbar .in { display: flex; }
.tabbar button { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; background: none; border: 0;
  padding: 8px 0 6px; color: var(--label3); font-size: .68rem; font-weight: 600; cursor: pointer; }
.tabbar button[aria-selected="true"] { color: var(--accent); }
.tabbar svg { width: 25px; height: 25px; }

.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: 28px; z-index: 30; background: rgba(28,28,30,.92); color: #fff;
  -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); border-radius: 14px; padding: 11px 16px; font-size: .9rem; font-weight: 500;
  display: flex; gap: 16px; align-items: center; box-shadow: var(--shadow-lg); width: max-content; max-width: calc(100vw - 32px); }
.toast button { background: none; border: 0; color: #64d2ff; font-weight: 700; cursor: pointer; }
footer { color: var(--label2); font-size: .8rem; padding: 8px 0 24px; }

/* Nach unten ziehen zum Neuladen (nur in der App vom Home-Bildschirm, Browser können das selbst) */
.ptr { position: fixed; left: 50%; top: calc(76px + env(safe-area-inset-top)); z-index: 25; width: 40px; height: 40px; margin-left: -20px;
  border-radius: 50%; background: var(--card); box-shadow: var(--shadow-lg); display: grid; place-items: center; color: var(--label2);
  opacity: 0; transform: translateY(-70px); pointer-events: none; transition: transform .25s ease, opacity .25s ease; }
.ptr svg { width: 22px; height: 22px; }
.ptr.ready { color: var(--accent); }
.ptr.loading svg { animation: ptr-spin .7s linear infinite; }
@keyframes ptr-spin { to { transform: rotate(360deg); } }

/* App vom Home-Bildschirm: Streifen hinter der Statusleiste (Uhrzeit, Notch), damit beim Scrollen
   nichts durchscheint; im Browser ist der Abstand 0 und der Streifen unsichtbar */
body::before { content: ""; position: fixed; left: 0; right: 0; top: 0; height: env(safe-area-inset-top); background: var(--bg); z-index: 40; }
body { -webkit-tap-highlight-color: transparent; }
.tabbar button, .chip, .actions > button { touch-action: manipulation; -webkit-user-select: none; user-select: none; }
@media (display-mode: standalone) {
  html, body { overscroll-behavior-y: none; }   /* kein Gummiband; Neuladen über das eigene Ziehen nach unten */
}

/* Handy und schmale Fenster */
@media (max-width: 900px) {
  .app { grid-template-columns: minmax(0, 1fr); }
  .rail { display: none; }
  .content { padding: 0 16px calc(96px + env(safe-area-inset-bottom)); }
  .top { display: flex; margin: 0 -16px 4px; padding: calc(10px + env(safe-area-inset-top)) 16px 10px; min-height: 60px; }
  .chips { display: flex; margin-right: -16px; padding-right: 16px; }
  .tabbar { display: block; }
  .toast { bottom: calc(84px + env(safe-area-inset-bottom)); }
}
@media (max-width: 520px) {
  .row-body { padding-left: 14px; }
  .actions .lbl { display: none; }
  .card { border-radius: 16px; }
  .brief-text { font-size: 1.05rem; }
}

/* ===== Instagram-Stil: weisser Grund, schmale Icon-Leiste, Story-Kreise, Beiträge ohne Karten ===== */
:root { --bg: #ffffff; --panel: #fafafa; --sep: #dbdbdb; --sep-soft: #efefef; --ig: linear-gradient(45deg, #f9ce34, #ee2a7b 55%, #6228d7); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg: #000000; --panel: #121212; --sep: #262626; --sep-soft: #1c1c1c; } }
:root[data-theme="dark"] { --bg: #000000; --panel: #121212; --sep: #262626; --sep-soft: #1c1c1c; }
:root[data-theme="light"] { --bg: #ffffff; --panel: #fafafa; --sep: #dbdbdb; --sep-soft: #efefef; }

.app { grid-template-columns: 236px minmax(0, 1fr); }
.rail { width: 236px; padding: 26px 12px 18px; border-right: 1px solid var(--sep); align-items: stretch; gap: 6px; }
.rail .brand { display: flex; align-items: center; gap: 10px; padding: 0 12px 22px; }
.rail .brand img { width: 30px; height: 30px; border-radius: 8px; }
.rail .brand b { font-weight: 800; font-size: 1.2rem; letter-spacing: -.03em; }
.rail .nav { display: flex; flex-direction: column; gap: 4px; }
.rail .nav button { position: relative; height: 48px; padding: 0 12px; gap: 14px; border-radius: 12px; font-size: .97rem; }
.rail .nav button svg { width: 26px; height: 26px; }
.rail .nav button[aria-selected="true"] { background: none; color: var(--text); font-weight: 750; }
.rail .nav button[aria-selected="true"] svg { stroke-width: 2.6; }
.rail .nav button:hover { background: var(--hover); }
.badge-dot { position: absolute; top: 10px; left: 30px; width: 8px; height: 8px; border-radius: 50%; background: var(--red); }
.rail-foot { margin-top: auto; }
#railToggle { color: var(--label2); }
/* eingeklappt: nur Icons */
html.rail-collapsed .app { grid-template-columns: 76px minmax(0, 1fr); }
html.rail-collapsed .rail { width: 76px; padding-left: 0; padding-right: 0; align-items: center; }
html.rail-collapsed .rail .lbl { display: none; }
html.rail-collapsed .rail .brand { padding: 0 0 22px; }
html.rail-collapsed .rail .nav button { width: 48px; padding: 0; justify-content: center; }
html.rail-collapsed #railToggle svg { transform: scaleX(-1); }

.content { max-width: 630px; padding: 18px 20px 60px; }

/* Chip-Reihe oben: Suchen, Alle, Themen */
.top { position: static; display: flex; min-height: 0; margin: 0 0 16px; padding: 0; background: none; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none; }
.top.searching { padding: 2px 0; }
.top .chips { display: flex; flex: 1; min-width: 0; gap: 8px; overflow-x: auto; padding: 2px 0 4px; margin: 0; scrollbar-width: none; }
.chip { display: inline-flex; align-items: center; gap: 6px; }
.chip[aria-pressed="true"] { background: var(--text); color: var(--bg); }
.search-chip { background: none; box-shadow: inset 0 0 0 1px var(--sep); }
.search-chip svg { width: 15px; height: 15px; }
.top.searching .chips { display: none !important; }

/* Briefing: ruhige Fläche statt Karte */
.card { border-radius: 14px; border: 1px solid var(--sep); box-shadow: none; }
.hero { background: var(--panel); border-color: var(--sep-soft); margin-bottom: 36px; }

/* Beiträge wie Posts */
.post.card { background: none; border: 0; border-bottom: 1px solid var(--sep); border-radius: 0; margin: 0 0 28px; padding: 6px 0 18px; }
.post-head { padding: 0 0 12px; }
.avatar { width: 36px; height: 36px; border-radius: 50%; box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--sep); }
.who .src { font-weight: 650; font-size: .92rem; }
.post-body { padding: 0 0 8px; }
.post-body h2 { font-size: 1.05rem; }
.tags-wrap { padding-bottom: 10px; }
.post-img { margin: 0 0 6px; border-radius: 6px; border: 1px solid var(--sep-soft); }
.post-img img { max-height: none; aspect-ratio: 1.91 / 1; }
.actions { justify-content: flex-start; gap: 2px; padding: 4px 0 0; margin: 0 -10px; }
.actions .spacer { flex: 1; }
.act-up[aria-pressed="true"] { color: var(--green); }
.act-down[aria-pressed="true"] { color: var(--orange); }
.act-up[aria-pressed="true"] svg path, .act-down[aria-pressed="true"] svg path { fill: currentColor; }
.actions svg { width: 24px; height: 24px; }
.actions > button { color: var(--text); }
.actions .lbl { display: none; }
.seen-line { margin: 4px 0 22px; }

/* Einstellungen-Gruppen und Formulare auf weissem Grund */
.group { background: var(--panel); border-color: var(--sep-soft); }

/* Tab-Leiste unten: nur Icons */
.tabbar { background: var(--bg); border-top: 1px solid var(--sep); -webkit-backdrop-filter: none; backdrop-filter: none;
  padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); }
.tabbar button { font-size: .66rem; font-weight: 600; gap: 3px; padding: 8px 0 6px; color: var(--label2); }
.tabbar button svg { width: 25px; height: 25px; color: var(--text); }
.tabbar button[aria-selected="true"] span { color: var(--text); font-weight: 750; }
.tabbar button[aria-selected="true"] { color: var(--text); }
.tabbar button[aria-selected="true"] svg { stroke-width: 2.6; }

@media (max-width: 900px) {
  .app, html.rail-collapsed .app { grid-template-columns: minmax(0, 1fr); }
  .content { padding: 0 0 calc(80px + env(safe-area-inset-bottom)); max-width: none; }
  /* Chip-Reihe ganz oben; gleitet beim Runterscrollen weg und ist beim Hochscrollen sofort wieder da */
  .top { display: flex; position: sticky; top: 0; z-index: 20; margin: 0 0 8px; padding: calc(30px + env(safe-area-inset-top)) 0 10px;
    background: var(--bg); border-bottom: 1px solid var(--sep); transition: transform .22s ease; }
  .top.away { transform: translateY(-100%); }
  .top.searching { padding: 8px 16px 10px; }
  .top .chips { padding: 0 14px 2px; }
  .hero, .active-filter, .list-head, #admin, #savedHead, #listFeed, .empty, footer, .seen-line, .trend-now, .month, .profile-seg { margin-left: 12px; margin-right: 12px; }
  .trend-now { margin-top: 8px; }
  #briefingView, .profile-seg { margin-top: calc(34px + env(safe-area-inset-top)); }
  .hero { margin-top: 10px; }
  .post.card { margin: 0 0 22px; padding: 6px 0 14px; }
  .hero { margin-bottom: 28px; }
  .post-head, .post-body, .tags-wrap { padding-left: 14px; padding-right: 14px; }
  .post-img { margin: 0 0 4px; border-radius: 0; border-left: 0; border-right: 0; }
  .actions { padding: 4px 4px 0; margin: 0; }
}

/* Chips: Gruppen je Tab; auf breiten Bildschirmen umbrechen statt seitlich abschneiden */
.chipset { display: contents; }
.chipset[hidden] { display: none !important; }
.chip.team { background: rgba(31,157,85,.12); color: var(--green); }
.chip.team[aria-pressed="true"] { background: var(--green); color: #fff; }
@media (min-width: 901px) {
  .top .chips { flex-wrap: wrap; overflow: visible; row-gap: 8px; }
}

/* Typ-Abzeichen in Entdecken */
.badge.t-studie { background: rgba(139,92,246,.12); color: var(--purple); }
.badge.t-kennzahlen { background: rgba(10,102,255,.1); color: var(--accent); }
.badge.t-best-practice { background: rgba(13,148,136,.12); color: var(--teal); }
.badge.t-news { background: var(--fill); color: var(--label2); }
.badge.t-diskussion { background: rgba(232,137,12,.12); color: var(--orange); }

/* Auch bei …, Zähler am Daumen */
.post-body p.also { margin-top: 6px; font-size: .84rem; }
.post-body p.also a { color: var(--label2); font-weight: 600; text-decoration: none; }
.post-body p.also a:hover { text-decoration: underline; }
.actions .cnt { font-size: .86rem; font-weight: 650; min-width: 0; }
.actions .cnt:empty { display: none; }

/* Schalter «in meinem Feed» in der Quellen-Zeile */
.toggle { width: 50px; height: 30px; border-radius: 999px; border: 0; background: var(--fill); position: relative; cursor: pointer; flex: none; padding: 0; transition: background .2s; }
.toggle::after { content: ""; position: absolute; top: 2px; left: 2px; width: 26px; height: 26px; border-radius: 50%; background: #fff; box-shadow: 0 2px 4px rgba(0,0,0,.2); transition: transform .2s; }
.toggle[aria-checked="true"] { background: var(--green); }
.toggle[aria-checked="true"]::after { transform: translateX(20px); }
.row.is-off .row-main b, .row.is-off .fav { opacity: .5; }

/* Vorschläge oben im Feed */
.suggestion { padding: 16px 18px; margin-bottom: 22px; background: var(--panel); border-color: var(--sep-soft); }
.suggestion p { margin: 0 0 12px; font-size: .95rem; font-weight: 550; }
@media (max-width: 900px) { #suggest { margin: 10px 12px 0; } }
</style>
</head>
<body>
{% set ico_feed %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4" width="17" height="16" rx="3"/><path d="M7.5 9h9M7.5 13h9M7.5 17h5"/></svg>{% endset %}
{% set ico_studies %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V11M10 20V5M16 20v-6M21 20H3"/></svg>{% endset %}
{% set ico_community %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12z"/></svg>{% endset %}
{% set ico_saved %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><path d="M6 3.5h12v17l-6-4-6 4v-17z"/></svg>{% endset %}
{% set ico_gear %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>{% endset %}
{% set ico_brief %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/></svg>{% endset %}
{% set ico_discover %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2z"/></svg>{% endset %}
{% set ico_sources %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h10M4 12h16M4 18h10"/><circle cx="18" cy="6" r="2"/><circle cx="18" cy="18" r="2"/></svg>{% endset %}
{% set tabs = [("feed", "Feed", ico_feed), ("discover", "Entdecken", ico_discover), ("briefing", "Briefing", ico_brief), ("saved", "Gemerkt", ico_saved), ("sources", "Quellen", ico_sources)] %}

<div class="app">
  {# ---------- Navigation links (Desktop) ---------- #}
  <aside class="rail">
    <a class="brand" href="./" aria-label="Radar" title="Radar"><img src="logo.svg" alt=""><b class="lbl">Radar</b></a>
    <nav class="nav" aria-label="Bereiche">
      {% for key, label, icon in tabs %}
      <button type="button" data-tab="{{ key }}" aria-selected="{{ 'true' if loop.first else 'false' }}" title="{{ label }}">{{ icon }}<span class="lbl">{{ label }}</span>{% if key == "saved" %}<span class="badge-dot" id="nSavedSide"></span>{% endif %}</button>
      {% endfor %}
    </nav>
    <div class="rail-foot nav">
      <button type="button" id="railToggle" title="Leiste einklappen" aria-expanded="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4" width="17" height="16" rx="3"/><path d="M9 4v16"/></svg><span class="lbl">Einklappen</span></button>
    </div>
  </aside>

  <div class="content">
    {# Such-Chip und Themen als Chips; im Suchmodus ersetzt das Suchfeld die Chips #}
    <div class="top" id="top">
      <div class="chips topic-nav" id="chips" role="group" aria-label="Themen">
        <button class="chip search-chip open-search" type="button" title="Suchen (/)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4-4"/></svg>Suchen</button>
        <button class="chip" type="button" data-topic="" data-type="" aria-pressed="true" id="chipAll">Alle</button>
        <span class="chipset" data-for="feed">
          <button class="chip team" type="button" data-team="1" aria-pressed="false" id="teamChip" hidden title="Artikel, die jemand anderes aus dem Team hochgevotet hat">Team-Tipps<span class="n" id="nTeam"></span></button>
          {% for t in topics if topic_counts[t] %}
          <button class="chip" type="button" data-topic="{{ t }}" aria-pressed="false">{{ t }}<span class="n">{{ topic_counts[t] }}</span></button>
          {% endfor %}
        </span>
        <span class="chipset" data-for="discover">
          {% for t in types if type_counts[t] %}
          <button class="chip" type="button" data-type="{{ t }}" aria-pressed="false">{{ t }}<span class="n">{{ type_counts[t] }}</span></button>
          {% endfor %}
        </span>
      </div>
      <label class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4-4"/></svg>
        <input type="search" id="q" placeholder="In Radar suchen" aria-label="Suche" enterkeyhint="search">
      </label>
      <button class="link search-cancel" type="button" id="searchCancel">Abbrechen</button>
    </div>

    {# ---------- Briefing-Feed: ein Briefing pro Tag, neueste zuerst ---------- #}
    <section id="briefingView" hidden>
      {% if trends %}
      <div class="trend-now"><span class="n">Jetzt im Trend</span>
        {% for t in trends %}<button class="chip trend" type="button" data-q="{{ t.term }}" title="{{ t.count }} Beiträge von {{ t.sources }} Quellen in den letzten 3 Tagen">↗ {{ t.term }}</button>{% endfor %}
      </div>
      {% endif %}
      {% for b in briefings %}
      {% if loop.first or b.month != briefings[loop.index0 - 1].month %}<h3 class="month">{{ b.month }}</h3>{% endif %}
      <article class="card hero day">
        <header class="day-head">
          <span class="day-week">{{ b.weekday }}{% if b.relative %} · {{ b.relative }}{% endif %}</span>
          <h2 class="day-date">{{ b.daymonth }}</h2>
        </header>
        <p class="brief-text">{{ b.text }}</p>
        {% if b.points %}
        <div class="points">
          <p class="points-title">Das Wichtigste</p>
          {% for pt in b.points %}
          <a class="point" href="{{ pt.link }}" target="_blank" rel="noopener nofollow external">
            <img src="https://www.google.com/s2/favicons?domain={{ pt.domain }}&amp;sz=64" alt="" loading="lazy" onerror="this.style.visibility='hidden'">
            <div><b>{{ pt.title }}</b>{% if pt.why %}<span class="why">{{ pt.why }}</span>{% endif %}<span class="src">{{ pt.source }}</span></div>
          </a>
          {% endfor %}
        </div>
        {% endif %}
        {% for title, refs in [("Studien", b.studies), ("Aus der Community", b.community)] if refs %}
        <div class="points">
          <p class="points-title">{{ title }}</p>
          {% for pt in refs %}
          <a class="point" href="{{ pt.link }}" target="_blank" rel="noopener nofollow external">
            <img src="https://www.google.com/s2/favicons?domain={{ pt.domain }}&amp;sz=64" alt="" loading="lazy" onerror="this.style.visibility='hidden'">
            <div><b>{{ pt.title }}</b><span class="src">{{ pt.source }}</span></div>
          </a>
          {% endfor %}
        </div>
        {% endfor %}
        {% if b.topics %}
        <div class="chip-row">{% for t in b.topics %}<button class="chip" type="button" data-topic="{{ t.topic }}">{{ t.topic }}<span class="n">{{ t.count }}</span></button>{% endfor %}</div>
        {% endif %}
        <p class="brief-by">{% if b.by == "ki" %}Von KI zusammengefasst aus {{ b.total }} Beiträgen.{% else %}Automatisch zusammengestellt aus {{ b.total }} Beiträgen.{% endif %}</p>
      </article>
      {% else %}
      <p class="empty">Noch keine Briefings.</p>
      {% endfor %}
    </section>

  <main>
    <p class="active-filter" id="activeFilter" hidden>Gefiltert: <button type="button" id="clearFilter"></button></p>

    {# ---------- Gemerkt ---------- #}
    <section id="savedHead" hidden>
      <div class="list-head">
        <div class="n" id="savedHint">Zum späteren Lesen, auf all deinen Geräten</div>
        <div>
          <button class="btn plain" type="button" id="copyList">Kopieren</button>
          <button class="btn" type="button" id="addBtn">+ Link</button>
        </div>
      </div>
      <form class="card form" id="addForm" hidden>
        <input type="url" id="addUrl" placeholder="Link zu einem Artikel von anderswo" required>
        <input type="text" id="addTitle" placeholder="Titel (optional)">
        <select id="addTopic"><option value="">Thema (optional)</option>{% for t in topics %}<option>{{ t }}</option>{% endfor %}</select>
        <div><button class="btn" type="submit">Ablegen</button> <button class="link" type="button" id="addCancel">Abbrechen</button></div>
      </form>
    </section>

    <div id="suggest" hidden></div>
    <div id="feed">
    {% for item in items %}
    <article class="card post" data-id="{{ item.id }}" data-kind="{{ 'entdecken' if item.category == 'Entdecken' else 'feed' }}" data-cat="{{ item.category }}"
      data-source="{{ item.source }}" data-domain="{{ item.domain }}" data-seen="{{ item.first_seen }}" data-published="{{ item.published }}"
      data-topics="{{ item.topics|join('|') }}" data-weight="{{ item.weight }}" data-type="{{ item.type }}" data-rel="{{ item.rel }}"
      data-text="{{ (item.title ~ ' ' ~ item.snippet ~ ' ' ~ item.source ~ ' ' ~ item.topics|join(' '))|lower }}">
      <header class="post-head">
        <span class="avatar" aria-hidden="true">{{ item.source[:2]|upper }}<img src="https://www.google.com/s2/favicons?domain={{ item.domain }}&amp;sz=128" alt="" loading="lazy" onerror="this.remove()"></span>
        <div class="who">
          <button class="src" type="button" title="Nur diese Quelle zeigen">{{ item.source }}</button>
          <span class="sub"><time datetime="{{ item.published }}">{{ item.published[8:10] }}.{{ item.published[5:7] }}.{{ item.published[0:4] }}</time>{% if item.search == "KI-Websuche" %} · KI-Websuche{% endif %}</span>
        </div>
        {% if item.category in ("Entdecken", "Community") or item.type in ("Studie", "Kennzahlen") %}<span class="badge t-{{ item.type|lower|replace(' ', '-') }}">{{ item.type }}</span>{% endif %}
      </header>
      <div class="post-body">
        <h2><a href="{{ item.link }}" target="_blank" rel="noopener nofollow external">{{ item.title }}</a></h2>
        {% if item.snippet %}<p>{{ item.snippet }}</p>{% endif %}
        {% if item.also %}<p class="also">Auch bei {% for a in item.also[:3] %}<a href="{{ a.link }}" target="_blank" rel="noopener nofollow external">{{ a.source }}</a>{{ ", " if not loop.last }}{% endfor %}{% if item.also|length > 3 %} und {{ item.also|length - 3 }} weiteren{% endif %}</p>{% endif %}
      </div>
      {% if item.topics %}<div class="post-body tags-wrap"><div class="tags">{% for t in item.topics %}<button class="tag" type="button" data-topic="{{ t }}">{{ t }}</button>{% endfor %}</div></div>{% endif %}
      {% if item.image %}
      <a class="post-img" href="{{ item.link }}" target="_blank" rel="noopener nofollow external" tabindex="-1" aria-hidden="true">
        <img src="{{ item.image }}" alt="" loading="lazy" decoding="async" onerror="this.parentNode.remove()">
      </a>
      {% endif %}
      <div class="actions">
        <button class="act-up" type="button" data-act="up" title="Guter Artikel" aria-label="Guter Artikel" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v11H3V10h4zm0 0 4-8a3 3 0 0 1 3 3v4h5.5a2 2 0 0 1 2 2.3l-1.4 8A2 2 0 0 1 18.1 21H7"/></svg><span class="cnt"></span></button>
        <button class="act-down" type="button" data-act="down" title="Nicht relevant" aria-label="Nicht relevant" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 14V3h4v11h-4zm0 0-4 8a3 3 0 0 1-3-3v-4H4.5a2 2 0 0 1-2-2.3l1.4-8A2 2 0 0 1 5.9 3H17"/></svg></button>
        <button class="act-share" type="button" data-act="share" title="Teilen" aria-label="Teilen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2.5 10 14"/><path d="m21.5 2.5-7 19-4.5-7.5L2.5 9.5l19-7z"/></svg></button>
        <span class="spacer"></span>
        <button class="act-favs" type="button" data-act="save" title="Merken" aria-label="Merken"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4V3z"/></svg></button>
      </div>
    </article>
    {% endfor %}
    </div>
    <div id="listFeed" hidden></div>
    <p class="empty" id="empty" hidden></p>

    {# ---------- Quellen und Einstellungen ---------- #}
    <section id="admin" hidden>
      <h3 class="group-title">Quellen <span class="n">{{ stats|length }}</span></h3>
      <div class="card group">
        {% for s in stats %}
        <details class="row" data-source="{{ s.name }}" data-standard="{{ 1 if s.standard else 0 }}">
          <summary>
            <img class="fav" src="https://www.google.com/s2/favicons?domain={{ s.domain }}&amp;sz=64" alt="" loading="lazy" onerror="this.style.visibility='hidden'">
            <div class="row-main"><b>{{ s.name }}</b><span>{{ s.category }} · {{ s.count }} {{ "Beitrag" if s.count == 1 else "Beiträge" }}{% if not s.standard %} · aufgenommen{% if s.by %} von {{ s.by }}{% endif %}{% endif %}<span class="eng"></span></span></div>
            <button class="toggle" type="button" role="switch" aria-checked="false" aria-label="{{ s.name }} in meinem Feed" title="In meinem Feed"></button>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
          </summary>
          <div class="row-body">
            <div class="facts">
              <div><span>Votes (30 Tage)</span><b class="f-votes">–</b></div>
              <div><span>Geöffnet (30 Tage)</span><b class="f-clicks">–</b></div>
              <div><span>Ø Relevanz</span><b>{{ s.rel if s.rel is not none else "–" }}</b></div>
              <div><span>Letzter Beitrag</span><b>{% if s.latest %}{{ s.latest[8:10] }}.{{ s.latest[5:7] }}.{% else %}–{% endif %}</b></div>
              <div><span>Themen-Treffer</span><b>{{ s.topic_share ~ " %" if s.topic_share is not none else "–" }}</b></div>
              <div><span>Feed</span><b>{{ s.host }}</b></div>
            </div>
          </div>
        </details>
        {% endfor %}
        <details class="row" id="addSource">
          <summary><span class="plus">+</span><div class="row-main"><b>Quelle aufnehmen</b><span>Website, Blog oder Feed</span></div><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></summary>
          <div class="row-body">
            <form class="form flat" id="sourceForm">
              <input type="url" id="srcUrl" placeholder="https://…" required>
              <div class="row2">
                <select id="srcCat" aria-label="Kategorie">{% for c in categories %}<option{% if c == "News" %} selected{% endif %}>{{ c }}</option>{% endfor %}</select>
                <input type="text" id="srcName" placeholder="Name (optional)">
              </div>
              <button class="btn" type="submit">Aufnehmen</button>
            </form>
          </div>
        </details>
      </div>
      <p class="group-note">Der Schalter bestimmt, was in <b>deinem</b> Feed steht; andere sehen ihre eigene Auswahl.
        Eine neue Quelle steht in deinem Feed, für andere bleibt sie aus, bis sie sie anschalten. Das Briefing und
        «Team-Tipps» berücksichtigen alle Quellen. Den Feed einer neuen Website sucht der nächste Abruf.</p>

      <h3 class="group-title">Regeln für alle Quellen</h3>
      <form class="card group" id="rulesForm">
        <label class="setting"><span>Titel mindestens</span><span class="ctl"><input type="number" id="ruleWords" min="0" max="30" value="{{ rules.min_woerter or 0 }}"> Wörter</span></label>
        <label class="setting"><span>Nur Beiträge mit Thema</span>
          <select id="ruleWeight">
            {% for v, label in [(0, "aus"), (1, "irgendein Thema"), (2, "ab «wichtig»"), (3, "nur «sehr wichtig»")] %}
            <option value="{{ v }}"{% if (rules.mindest_gewicht or 0) == v %} selected{% endif %}>{{ label }}</option>{% endfor %}
          </select></label>
        <label class="setting"><span>Stellenanzeigen ausblenden</span><input class="switch" type="checkbox" id="ruleJobs"{% if rules.stellenanzeigen_ausblenden is not sameas false %} checked{% endif %}></label>
        <div class="setting stack"><span>Begriffe im Titel ausschliessen</span>
          <textarea id="ruleExclude" rows="1" placeholder="z.B. webinar, podcast">{{ (rules.ausschliessen or [])|join(', ') }}</textarea></div>
        <div class="setting end"><button class="btn" type="submit">Regeln speichern</button></div>
      </form>
      <p class="group-note">Gelten für jede Quelle gleich. Liefert eine Quelle damit nichts Brauchbares, besser entfernen statt eine Ausnahme machen.</p>

      <h3 class="group-title">Themen</h3>
      <div class="card group">
        {% for t in topic_defs %}
        <details class="row">
          <summary>
            <span class="dot w{{ t.gewicht or 1 }}"></span>
            <div class="row-main"><b>{{ t.name }}</b><span>{{ ["", "normal", "wichtig", "sehr wichtig"][t.gewicht or 1] }} · {{ topic_counts[t.name] }} {{ "Beitrag" if topic_counts[t.name] == 1 else "Beiträge" }}</span></div>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
          </summary>
          <div class="row-body">
            <form class="form flat topic-form" data-name="{{ t.name }}">
              <select name="gewicht" aria-label="Gewicht">{% for v, label in [(1, "normal"), (2, "wichtig"), (3, "sehr wichtig")] %}<option value="{{ v }}"{% if (t.gewicht or 1) == v %} selected{% endif %}>{{ label }}</option>{% endfor %}</select>
              <textarea name="stichwoerter" rows="2" aria-label="Stichwörter">{% for w in t.stichwoerter %}{{ ('"' ~ w ~ '"') if w != w.strip() else w }}{{ ", " if not loop.last }}{% endfor %}</textarea>
              <div class="row-actions">
                <button class="btn" type="submit">Speichern</button>
                <button class="btn plain danger" type="button" data-op="topic_remove" data-name="{{ t.name }}" data-confirm="Thema {{ t.name }} entfernen?">Entfernen</button>
              </div>
            </form>
          </div>
        </details>
        {% endfor %}
        <details class="row">
          <summary><span class="plus">+</span><div class="row-main"><b>Thema hinzufügen</b><span>Name, Gewicht, Stichwörter</span></div><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></summary>
          <div class="row-body">
            <form class="form flat topic-form" data-name="">
              <input type="text" name="name" placeholder="Name, z.B. YouTube" required>
              <select name="gewicht" aria-label="Gewicht"><option value="1">normal</option><option value="2">wichtig</option><option value="3">sehr wichtig</option></select>
              <textarea name="stichwoerter" rows="2" placeholder="Stichwörter mit Komma, z.B. youtube, video ads, ctv" required></textarea>
              <button class="btn" type="submit">Thema anlegen</button>
            </form>
          </div>
        </details>
      </div>
      <p class="group-note">Ein Beitrag erhält ein Thema, wenn eines der Stichwörter in Titel oder Anriss steht. Ein Stichwort in
        Anführungszeichen mit Leerzeichen trifft nur ganze Wörter (" rsa " trifft nicht «Versa»).</p>

      <h3 class="group-title">Suchbegriffe für Entdecken</h3>
      <div class="card group">
        {% for b in search_defs %}
        <div class="row line"><div class="row-main"><b>{{ b }}</b></div>
          <button class="x" type="button" data-op="search_remove" data-term="{{ b }}" data-confirm="Suchbegriff {{ b }} entfernen?" aria-label="Entfernen">✕</button></div>
        {% endfor %}
        <form class="row line" id="searchForm">
          <input type="text" id="searchTerm" placeholder='Neuer Begriff, z.B. "Consent Mode" Google' required>
          <button class="btn" type="submit">Hinzufügen</button>
        </form>
      </div>
      <p class="group-note">Gesucht wird in Google News (USA, Grossbritannien, Irland, Deutschland, Österreich, Schweiz),
        dazu einmal pro Woche eine KI-Websuche. Die KI ordnet jeden Fund ein; in «Entdecken» erscheint, was relevant genug ist.</p>

      <h3 class="group-title">Darstellung</h3>
      <div class="card group"><div class="setting"><span>Farbschema</span>
        <div class="seg" id="themeSeg"><button type="button" data-theme="" aria-pressed="true">Auto</button><button type="button" data-theme="light" aria-pressed="false">Hell</button><button type="button" data-theme="dark" aria-pressed="false">Dunkel</button></div></div></div>

      <h3 class="group-title">Letzter Lauf</h3>
      <div class="card group">
        <div class="setting"><span>Stand</span><span class="n"><time id="generated" datetime="{{ generated }}">{{ generated[:16]|replace("T", " ") }} UTC</time></span></div>
        <div class="setting"><span>Angemeldet</span><span class="n" id="me">–</span></div>
        <div class="setting"><span>KI diesen Monat</span><span class="n">{{ "%.2f"|format(ai_cost.spent) }} von {{ "%.2f"|format(ai_cost.budget) }} USD · {{ ai_cost.calls }} Aufrufe</span></div>
        <div class="setting"><span>Letzte KI-Websuche</span><span class="n">{% if ai_cost.last_websearch %}{{ ai_cost.last_websearch[8:10] }}.{{ ai_cost.last_websearch[5:7] }}.{{ ai_cost.last_websearch[0:4] }}{% else %}noch keine{% endif %}</span></div>
        <div class="setting"><span>Einstellungen aus</span><span class="n">{{ config_origin }}</span></div>
        {% for k, v in notes.items() %}<div class="setting stack"><span>{{ k }}</span><span class="n">{{ v }}</span></div>{% endfor %}
        {% for e in errors %}<div class="setting stack"><span>{{ e.source }}</span><span class="n">{{ e.error }}</span></div>{% endfor %}
        {% if repo %}<div class="setting end"><a class="btn plain" href="https://github.com/{{ repo }}/actions/workflows/build.yml" target="_blank" rel="noopener nofollow external">Abruf auf GitHub</a></div>{% endif %}
      </div>
      <p class="group-note">Läuft automatisch alle 3 Stunden; Änderungen hier stossen einen Abruf an.</p>
    </section>

    <footer>Inhalte gehören den jeweiligen Quellen.</footer>
  </main>
  </div>
</div>

<nav class="tabbar" aria-label="Bereiche">
  <div class="in">
    {% for key, label, icon in tabs %}
    <button type="button" data-tab="{{ key }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ icon }}<span>{{ label }}</span></button>
    {% endfor %}
  </div>
</nav>

<div class="ptr" id="ptr" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><path d="M20 4v5h-5"/></svg></div>
<div class="toast" id="toast" hidden><span id="toastText"></span><button type="button" id="toastUndo">Rückgängig</button></div>

<script>
(function () {
  var store = {
    get: function (k, d) { try { var v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
    set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  };
  var $ = function (id) { return document.getElementById(id); };
  var $$ = function (sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); };
  // Gewichte der Reihenfolge (Einstellung «gewichtung» in sources.yaml)
  var RANK = Object.assign({ halbwertszeit_stunden: 36, vote: 2, klick: 0.5, artikel: 0.2, quelle: 0.25, thema: 0.08,
    relevanz: 0.1, schub_min: -0.3, schub_max: 0.5 }, {{ ranking|tojson }});

  // Farbschema
  var root = document.documentElement, theme = store.get("psn-theme", "");
  function applyTheme() {
    if (theme) root.setAttribute("data-theme", theme); else root.removeAttribute("data-theme");
    $$("#themeSeg button").forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.theme === theme ? "true" : "false"); });
  }
  applyTheme();
  $$("#themeSeg button").forEach(function (b) {
    b.addEventListener("click", function () { theme = b.dataset.theme; store.set("psn-theme", theme); applyTheme(); });
  });

  // Datumsangaben
  var dateFmt = new Intl.DateTimeFormat("de-CH", { day: "numeric", month: "long" });
  function fmt(iso) {
    var d = new Date(iso), h = (Date.now() - d) / 36e5;
    if (h < 1) return "Gerade eben";
    if (h < 24) return "Vor " + Math.floor(h) + " Std.";
    if (h < 48) return "Gestern";
    return dateFmt.format(d);
  }
  $$(".post time").forEach(function (t) { t.textContent = fmt(t.dateTime); });
  $("generated").textContent = new Intl.DateTimeFormat("de-CH", { dateStyle: "medium", timeStyle: "short" }).format(new Date($("generated").dateTime));

  function hue(s) { var h = 0; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return h; }
  function paintAvatar(post) { post.querySelector(".avatar").style.setProperty("--h", hue(post.dataset.source)); }

  var feed = $("feed"), listFeed = $("listFeed");
  var posts = Array.prototype.slice.call(feed.querySelectorAll(".post"));
  posts.forEach(paintAvatar);
  var seenLine = document.createElement("div");
  seenLine.className = "seen-line"; seenLine.textContent = "Bis hier gelesen";

  // Was seit dem letzten Besuch neu ist, steht im Feed oben; darunter die Linie "Bis hier gelesen"
  var lastVisit = store.get("psn-last-visit", null);
  store.set("psn-last-visit", new Date().toISOString());
  function isNew(p) { return !!lastVisit && p.dataset.seen > lastVisit; }

  // ---------- Daten des Teams (API) ----------
  // Online: Votes, Klicks und Gemerkt liegen in der Datenbank. Ohne API (z.B. Datei lokal geöffnet)
  // bleiben eigene Votes und Gemerkt in diesem Browser.
  var server = { online: false, me: "", articles: {}, votes: {}, sources: {}, suggestions: [], autoRebuild: false };
  var localVotes = store.get("psn-avotes", {});
  var localSources = store.get("psn-sources", {});
  var saved = store.get("psn-favs", {});
  var clicked = {};

  function api(path, body) {
    var opts = body ? { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) } : { cache: "no-store" };
    opts.credentials = "same-origin";
    return fetch("api/" + path, opts).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (d) {
        if (!r.ok) throw new Error(d.error || "Fehler " + r.status);
        return d;
      });
    });
  }
  // Eigene Quellenwahl: 1 = an, -1 = aus; sonst gilt, ob die Quelle Standard ist
  var STANDARD = {};
  $$("#admin details[data-source]").forEach(function (r) { STANDARD[r.dataset.source] = r.dataset.standard === "1"; });
  function mySources() { return server.online ? server.sources : localSources; }
  function inMyFeed(name) {
    var v = mySources()[name];
    return v === 1 ? true : v === -1 ? false : STANDARD[name] !== false;
  }
  function reloadState() {
    return api("state").then(function (d) {
      server = Object.assign(d, { online: true });
      saved = {};
      d.saved.forEach(function (f) { saved[f.id] = f; });
      computeSourceAvg();
      render();
      return d;
    });
  }
  function myVote(id) { return (server.online ? server.votes : localVotes)[id] || 0; }
  function counts(id) { return server.articles[id] || (server.articles[id] = { up: 0, down: 0, team: 0, clicks: 0 }); }
  function ref(post) { return { id: post.dataset.id, source: post.dataset.source, domain: post.dataset.domain, kind: post.dataset.kind || "feed" }; }

  // ---------- Reihenfolge ----------
  // Aktualität (Halbwertszeit) mal (1 + Schub); der Schub kommt aus Votes und Klicks am Artikel,
  // dem Schnitt der Quelle über ihre Beiträge der letzten 30 Tage, dem Thema und der KI-Relevanz
  var sourceAvg = {};
  function engagement(id) { var c = counts(id); return RANK.vote * (c.up - c.down) + RANK.klick * c.clicks; }
  function computeSourceAvg() {
    var sum = {}, n = {};
    posts.forEach(function (p) {
      var s = p.dataset.source;
      sum[s] = (sum[s] || 0) + engagement(p.dataset.id); n[s] = (n[s] || 0) + 1;
    });
    sourceAvg = {};
    Object.keys(sum).forEach(function (s) { sourceAvg[s] = sum[s] / n[s]; });
  }
  function score(p) {
    var boost = RANK.artikel * Math.tanh(engagement(p.dataset.id) / 3)
      + RANK.quelle * Math.tanh(sourceAvg[p.dataset.source] || 0)
      + RANK.thema * (+p.dataset.weight || 0);
    if (p.dataset.kind === "entdecken") boost += RANK.relevanz * ((+p.dataset.rel || 3) - 3);
    boost = Math.min(RANK.schub_max, Math.max(RANK.schub_min, boost));
    var hours = Math.max(0, (Date.now() - new Date(p.dataset.published)) / 36e5);
    return Math.pow(0.5, hours / RANK.halbwertszeit_stunden) * (1 + boost);
  }

  // ---------- Darstellung ----------
  var state = { tab: "feed", topic: "", type: "", team: false, source: "", q: "" };
  var TABS = {
    // Feed: eigene Quellen; «Team-Tipps» zeigt, was andere gut fanden, aus allen Quellen
    feed: function (p) { return p.dataset.kind === "feed" && p.dataset.cat !== "Community" && (state.team || inMyFeed(p.dataset.source)); },
    discover: function (p) { return p.dataset.kind === "entdecken" || (p.dataset.cat === "Community" && inMyFeed(p.dataset.source)); }
  };
  var EMPTY = {
    feed: "Keine Beiträge für diese Auswahl.",
    discover: "Keine Funde für diese Auswahl.",
    saved: "Noch nichts gemerkt. Über das Lesezeichen bei einem Beitrag oder «+ Link» landet es hier."
  };

  function matches(p) {
    var terms = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    return TABS[state.tab](p)
      && (!state.topic || p.dataset.topics.split("|").indexOf(state.topic) !== -1)
      && (!state.type || p.dataset.type === state.type)
      && (!state.team || counts(p.dataset.id).team > 0)
      && (!state.source || p.dataset.source === state.source)
      && terms.every(function (t) { return p.dataset.text.indexOf(t) !== -1; });
  }
  function decorate(p) {
    var id = p.dataset.id, v = myVote(id), c = counts(id), up = p.querySelector(".act-up");
    up.setAttribute("aria-pressed", v === 1 ? "true" : "false");
    p.querySelector(".act-down").setAttribute("aria-pressed", v === -1 ? "true" : "false");
    up.querySelector(".cnt").textContent = c.up > 0 ? c.up : "";
    up.title = c.team ? c.team + (c.team === 1 ? " Person" : " Personen") + " aus dem Team fanden das gut" : "Guter Artikel";
    p.classList.toggle("is-fav", !!saved[id]);
  }

  function snapshot(post) {
    var a = post.querySelector("h2 a"), p = post.querySelector(".post-body p:not(.also)"), img = post.querySelector(".post-img img");
    return { id: post.dataset.id, title: a.textContent, link: a.href, source: post.dataset.source, domain: post.dataset.domain,
      kind: post.dataset.kind, category: post.dataset.cat, type: post.dataset.type, published: post.dataset.published,
      snippet: p ? p.textContent : "", image: img ? img.src : null, topics: post.dataset.topics, saved: new Date().toISOString() };
  }
  function buildSavedPost(f) {
    var live = feed.querySelector('.post[data-id="' + CSS.escape(f.id) + '"]');
    if (live) { var c = live.cloneNode(true); c.hidden = false; return c; }
    // Nicht (mehr) im Feed: aus dem gespeicherten Stand aufbauen
    var tpl = posts[0].cloneNode(true);
    tpl.hidden = false;
    Object.assign(tpl.dataset, { id: f.id, source: f.source, cat: f.category, kind: f.kind || "feed", published: f.published,
      topics: f.topics || "", domain: f.domain || "", type: f.type || "" });
    var av = tpl.querySelector(".avatar"), favicon = av.querySelector("img");
    av.firstChild.textContent = f.source.slice(0, 2).toUpperCase();
    if (favicon) { if (f.domain) favicon.src = "https://www.google.com/s2/favicons?domain=" + encodeURIComponent(f.domain) + "&sz=128"; else favicon.remove(); }
    tpl.querySelector(".src").textContent = f.source;
    tpl.querySelector(".sub").textContent = f.category === "Abgelegt" ? "Selbst abgelegt" : fmt(f.published);
    var a = tpl.querySelector("h2 a"); a.textContent = f.title; a.href = f.link;
    var p = tpl.querySelector(".post-body p:not(.also)"); if (p) { p.textContent = f.snippet || ""; p.hidden = !f.snippet; }
    ["tags-wrap", "badge", "post-img", "also"].forEach(function (cls) { var el = tpl.querySelector("." + cls); if (el) el.remove(); });
    if (f.topics) {
      var wrap = document.createElement("div"), box = document.createElement("div");
      wrap.className = "post-body tags-wrap"; box.className = "tags";
      f.topics.split("|").forEach(function (t) {
        var b = document.createElement("button"); b.className = "tag"; b.type = "button"; b.dataset.topic = t; b.textContent = t; box.appendChild(b);
      });
      wrap.appendChild(box); tpl.querySelector(".actions").before(wrap);
    }
    return tpl;
  }

  // Vorschläge oben im Feed: «aufnehmen?» und «entfernen?»
  function renderSuggestions(show) {
    var box = $("suggest");
    box.innerHTML = "";
    box.hidden = !show || !server.suggestions.length;
    server.suggestions.forEach(function (s) {
      var card = document.createElement("div"), p = document.createElement("p"), row = document.createElement("div");
      card.className = "card suggestion"; p.textContent = s.text; row.className = "row-actions";
      [["accept", s.kind === "add" ? "Aufnehmen" : "Entfernen", "btn"], ["dismiss", "Nein, danke", "btn plain"]].forEach(function (o) {
        var b = document.createElement("button");
        b.type = "button"; b.className = o[2]; b.textContent = o[1];
        b.addEventListener("click", function () {
          api("suggestion", { key: s.key, action: o[0], name: s.name }).then(function (d) {
            toast(d.message + (d.rebuild ? " Radar holt die Beiträge in ein paar Minuten." : ""));
            return reloadState();
          }).catch(function (e) { toast(e.message); });
        });
        row.appendChild(b);
      });
      card.appendChild(p); card.appendChild(row); box.appendChild(card);
    });
  }

  function renderAdmin() {
    $("me").textContent = server.online ? server.me : "offline";
    $$("#admin details[data-source]").forEach(function (row) {
      var name = row.dataset.source, up = 0, down = 0, clicks = 0;
      posts.forEach(function (p) {
        if (p.dataset.source !== name) return;
        var c = counts(p.dataset.id); up += c.up; down += c.down; clicks += c.clicks;
      });
      row.querySelector(".f-votes").textContent = server.online ? "▲ " + up + "  ▼ " + down : "–";
      row.querySelector(".f-clicks").textContent = server.online ? clicks : "–";
      row.querySelector(".eng").textContent = up || down ? " · ▲ " + up + " ▼ " + down : "";
      var on = inMyFeed(name);
      row.querySelector(".toggle").setAttribute("aria-checked", on ? "true" : "false");
      row.classList.toggle("is-off", !on);
    });
  }

  function render() {
    var tab = state.tab, isSaved = tab === "saved", admin = tab === "sources", brief = tab === "briefing", shown = 0;
    var filtered = !!(state.topic || state.type || state.team || state.source || state.q);
    $("nSavedSide").hidden = !Object.keys(saved).length;
    $$("[data-tab]").forEach(function (b) { b.setAttribute("aria-selected", b.dataset.tab === tab ? "true" : "false"); });
    $("briefingView").hidden = !brief;
    $("top").hidden = brief || admin || isSaved;
    $$(".chipset").forEach(function (c) { c.hidden = c.dataset.for !== tab; });
    $$("#chips [data-topic], #chips [data-type]").forEach(function (b) {
      var on = b.id === "chipAll" ? !(state.topic || state.type || state.team) : b.dataset.topic ? b.dataset.topic === state.topic : b.dataset.type === state.type;
      b.setAttribute("aria-pressed", on ? "true" : "false");
    });
    var team = posts.filter(function (p) { return p.dataset.kind === "feed" && p.dataset.cat !== "Community" && counts(p.dataset.id).team > 0; }).length;
    $("teamChip").hidden = !team; $("nTeam").textContent = team || "";
    $("teamChip").setAttribute("aria-pressed", state.team ? "true" : "false");
    $("admin").hidden = !admin;
    $("savedHead").hidden = !isSaved;
    feed.hidden = admin || isSaved || brief;
    listFeed.hidden = !isSaved;
    $("activeFilter").hidden = admin || isSaved || brief || !(state.topic || state.source);
    $("clearFilter").textContent = (state.source ? state.source : "#" + state.topic) + "  ✕";
    renderSuggestions(tab === "feed" && !filtered);

    if (admin) {
      renderAdmin();
    } else if (isSaved) {
      listFeed.innerHTML = "";
      Object.keys(saved).map(function (id) { return saved[id]; })
        .sort(function (a, b) { return b.saved.localeCompare(a.saved); })
        .forEach(function (f) { var p = buildSavedPost(f); paintAvatar(p); decorate(p); listFeed.appendChild(p); shown++; });
    } else if (!brief) {
      var useNew = tab === "feed", scores = new Map();
      posts.forEach(function (p) { scores.set(p, score(p)); });
      posts.sort(function (a, b) {
        var na = useNew && isNew(a), nb = useNew && isNew(b);
        return na !== nb ? (na ? -1 : 1) : scores.get(b) - scores.get(a);
      });
      var lineAfter = null;
      posts.forEach(function (p) {
        decorate(p);
        var ok = matches(p);
        p.hidden = !ok;
        if (ok) { shown++; if (useNew && isNew(p)) lineAfter = p; }
        feed.appendChild(p);
      });
      var lastShown = posts.filter(function (p) { return !p.hidden; }).pop();
      if (lineAfter && !filtered && lineAfter !== lastShown) lineAfter.after(seenLine); else seenLine.remove();
    }
    $("empty").hidden = admin || brief || shown > 0;
    $("empty").textContent = EMPTY[tab] || "";
  }

  // Direktlinks: #discover, #briefing, #saved, #sources öffnen den jeweiligen Tab
  var HASH_TABS = ["feed", "discover", "briefing", "saved", "sources"];
  function syncHash() {
    history.replaceState(null, "", state.tab === "feed" ? location.pathname + location.search : "#" + state.tab);
  }
  function go(changes) { Object.assign(state, changes); render(); syncHash(); window.scrollTo(0, 0); }
  function filterTab() { return TABS[state.tab] ? state.tab : "feed"; }

  $$("[data-tab]").forEach(function (b) {
    b.addEventListener("click", function () {
      var next = b.dataset.tab;
      // Filter gehören zum Tab: Typen gibt es nur in Entdecken, Team-Tipps nur im Feed
      go({ tab: next, type: next === "discover" ? state.type : "", team: next === "feed" ? state.team : "" });
    });
  });
  function setQuery(value) {
    $("q").value = value;
    state.q = value; state.tab = filterTab(); render();
  }
  $("q").addEventListener("input", function (e) { setQuery(e.target.value); });
  function openSearch() {
    if (!TABS[state.tab]) go({ tab: "feed" });
    $("top").classList.add("searching"); window.scrollTo(0, 0); $("q").focus();
  }
  function closeSearch() {
    $("top").classList.remove("searching");
    if (state.q) setQuery("");
  }
  $$(".open-search").forEach(function (b) { b.addEventListener("click", openSearch); });
  // Seitenleiste auf- und zuklappen, Wahl merken
  function syncRail() {
    var collapsed = root.classList.contains("rail-collapsed");
    $("railToggle").setAttribute("aria-expanded", collapsed ? "false" : "true");
    $("railToggle").title = collapsed ? "Leiste aufklappen" : "Leiste einklappen";
    $("railToggle").querySelector(".lbl").textContent = collapsed ? "Aufklappen" : "Einklappen";
  }
  $("railToggle").addEventListener("click", function () {
    root.classList.toggle("rail-collapsed");
    try { localStorage.setItem("psn-rail", root.classList.contains("rail-collapsed") ? "collapsed" : "expanded"); } catch (e) {}
    syncRail();
  });
  syncRail();
  $("searchCancel").addEventListener("click", closeSearch);
  $("q").addEventListener("keydown", function (e) { if (e.key === "Escape") closeSearch(); });
  document.addEventListener("keydown", function (e) {
    if (e.key === "/" && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) {
      e.preventDefault();
      openSearch();
    }
  });
  // Chip-Reihe: beim Runterscrollen ausblenden, bei jeder Bewegung nach oben sofort zeigen
  var lastY = window.scrollY;
  window.addEventListener("scroll", function () {
    var y = window.scrollY, top = $("top");
    if (y < lastY || y < 60 || top.classList.contains("searching")) top.classList.remove("away");
    else if (y > lastY + 4) top.classList.add("away");
    lastY = y;
  }, { passive: true });
  $("clearFilter").addEventListener("click", function () { go({ topic: "", source: "" }); });

  // Hinweis unten mit "Rückgängig"
  var toastTimer, undoFn;
  function toast(text, undo) {
    $("toastText").textContent = text; undoFn = undo; $("toastUndo").hidden = !undo; $("toast").hidden = false;
    clearTimeout(toastTimer); toastTimer = setTimeout(function () { $("toast").hidden = true; }, 4000);
  }
  $("toastUndo").addEventListener("click", function () { if (undoFn) undoFn(); $("toast").hidden = true; });

  // ---------- Aktionen ----------
  function setVote(post, value) {
    var a = ref(post), before = myVote(a.id), c = counts(a.id);
    if (before === 1) c.up--; else if (before === -1) c.down--;
    if (value === 1) c.up++; else if (value === -1) c.down++;
    var votes = server.online ? server.votes : localVotes;
    if (value) votes[a.id] = value; else delete votes[a.id];
    if (server.online) {
      api("vote", Object.assign({ value: value }, a)).catch(function () { toast("Nicht gespeichert – keine Verbindung"); });
    } else {
      store.set("psn-avotes", localVotes);
    }
    computeSourceAvg();
    $$('.post[data-id="' + CSS.escape(a.id) + '"]').forEach(decorate);
  }
  function setSaved(post, on) {
    var item = on ? snapshot(post) : null, id = post.dataset.id;
    if (on) saved[id] = item; else delete saved[id];
    if (server.online) api("save", { id: id, item: item }).catch(function () { toast("Nicht gespeichert – keine Verbindung"); });
    else store.set("psn-favs", saved);
  }
  // Geöffnete Artikel zählen (einmal pro Artikel und Person)
  function track(post) {
    var a = ref(post);
    if (!server.online || clicked[a.id]) return;
    clicked[a.id] = true;
    var body = JSON.stringify(a);
    if (navigator.sendBeacon) navigator.sendBeacon("api/click", new Blob([body], { type: "application/json" }));
    else fetch("api/click", { method: "POST", headers: { "content-type": "application/json" }, body: body, keepalive: true, credentials: "same-origin" });
    counts(a.id).clicks++;
  }
  function onOpen(e) {
    var link = e.target.closest(".post h2 a, .post .post-img");
    if (link) track(link.closest(".post"));
  }
  document.addEventListener("click", onOpen, true);
  document.addEventListener("auxclick", onOpen, true);

  document.addEventListener("click", function (e) {
    var qBtn = e.target.closest("[data-q]");
    if (qBtn) { $("q").value = qBtn.dataset.q; $("top").classList.add("searching"); go({ q: qBtn.dataset.q, topic: "", type: "", team: false, source: "", tab: "feed" }); return; }
    if (e.target.closest("#teamChip")) { go({ team: !state.team, topic: "", source: "" }); return; }
    if (e.target.closest("#chipAll")) { go({ topic: "", type: "", team: false, source: "" }); return; }
    var typeBtn = e.target.closest("#chips [data-type]");
    if (typeBtn) { go({ type: typeBtn.dataset.type === state.type ? "" : typeBtn.dataset.type }); return; }
    var topicBtn = e.target.closest("[data-topic]");
    if (topicBtn) { go({ topic: topicBtn.dataset.topic, team: false, source: "", tab: filterTab() }); return; }
    var srcBtn = e.target.closest(".src");
    if (srcBtn) { go({ source: srcBtn.closest(".post").dataset.source, topic: "", tab: filterTab() }); return; }
    var btn = e.target.closest("[data-act]");
    if (!btn) return;
    var post = btn.closest(".post"), act = btn.dataset.act;
    if (act === "share") {
      var link = post.querySelector("h2 a");
      var data = { title: link.textContent, text: link.textContent + " (" + post.dataset.source + ")", url: link.href };
      if (navigator.share) { navigator.share(data).catch(function () {}); }
      else { navigator.clipboard.writeText(data.title + "\n" + data.url).then(function () { toast("Link kopiert"); }); }
      return;
    }
    if (act === "up" || act === "down") {
      var want = act === "up" ? 1 : -1, before = myVote(post.dataset.id), next = before === want ? 0 : want;
      setVote(post, next);
      toast(next === 1 ? "Als gut markiert" : next === -1 ? "Als nicht relevant markiert" : "Bewertung entfernt",
        function () { setVote(post, before); });
      return;
    }
    if (act === "save") {
      var adding = !saved[post.dataset.id];
      setSaved(post, adding);
      render();
      toast(adding ? "Gemerkt" : "Entfernt");
    }
  });

  // Links von anderswo ablegen
  $("addBtn").addEventListener("click", function () { $("addForm").hidden = false; $("addUrl").focus(); });
  $("addCancel").addEventListener("click", function () { $("addForm").reset(); $("addForm").hidden = true; });
  $("addForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var url = $("addUrl").value.trim(), host;
    try { host = new URL(url).hostname.replace(/^www\./, ""); } catch (err) { return; }
    var now = new Date().toISOString(), id = "manual:" + url;
    saved[id] = { id: id, link: url, source: host, domain: host, category: "Abgelegt", kind: "feed",
      title: $("addTitle").value.trim() || url.replace(/^https?:\/\/(www\.)?/, "").slice(0, 120),
      published: now, snippet: "", image: null, topics: $("addTopic").value, saved: now };
    if (server.online) api("save", { id: id, item: saved[id] }).catch(function () { toast("Nicht gespeichert – keine Verbindung"); });
    else store.set("psn-favs", saved);
    $("addForm").reset(); $("addForm").hidden = true;
    render(); toast("Abgelegt");
  });
  $("copyList").addEventListener("click", function () {
    var text = Object.keys(saved).map(function (id) { var f = saved[id]; return "- " + f.title + " (" + f.source + ")\n  " + f.link; }).join("\n");
    if (!text) { toast("Liste ist leer"); return; }
    navigator.clipboard.writeText(text).then(function () { toast("Liste kopiert"); });
  });

  // ---------- Einstellungen ändern ----------
  function change(body, done) {
    if (!server.online) { toast("Ändern geht nur in der Online-Version"); return; }
    api("config", body).then(function (d) {
      toast(d.message + (d.rebuild ? " Radar baut neu, in ein paar Minuten sichtbar." : d.message.indexOf("Feed.") > 0 ? "" : " Wirkt beim nächsten Abruf."));
      if (done) done();
      reloadState();
    }).catch(function (e) { toast(e.message); });
  }
  $("sourceForm").addEventListener("submit", function (e) {
    e.preventDefault();
    change({ op: "source_add", url: $("srcUrl").value.trim(), kategorie: $("srcCat").value, name: $("srcName").value.trim() },
      function () { $("sourceForm").reset(); });
  });
  $$(".topic-form").forEach(function (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      change({ op: "topic_save", name: form.dataset.name || form.elements.name.value.trim(),
        gewicht: form.elements.gewicht.value, stichwoerter: form.elements.stichwoerter.value });
    });
  });
  $("rulesForm").addEventListener("submit", function (e) {
    e.preventDefault();
    change({ op: "rules_save", min_woerter: $("ruleWords").value, mindest_gewicht: $("ruleWeight").value,
      stellenanzeigen_ausblenden: $("ruleJobs").checked, ausschliessen: $("ruleExclude").value });
  });
  $("searchForm").addEventListener("submit", function (e) {
    e.preventDefault();
    change({ op: "search_add", term: $("searchTerm").value.trim() }, function () { $("searchForm").reset(); });
  });
  $("admin").addEventListener("click", function (e) {
    // Schalter in der Quellen-Zeile: ohne die Zeile auf- oder zuzuklappen
    var sw = e.target.closest(".toggle");
    if (sw) {
      e.preventDefault();
      var name = sw.closest("[data-source]").dataset.source, on = !inMyFeed(name);
      mySources()[name] = on ? 1 : -1;
      if (server.online) api("my-source", { source: name, on: on }).catch(function () { toast("Nicht gespeichert – keine Verbindung"); });
      else store.set("psn-sources", localSources);
      computeSourceAvg(); render();
      toast(on ? name + " ist in deinem Feed" : name + " ist aus deinem Feed", function () {
        mySources()[name] = on ? -1 : 1;
        if (server.online) api("my-source", { source: name, on: !on }).catch(function () {});
        else store.set("psn-sources", localSources);
        render();
      });
      return;
    }
    var op = e.target.closest("[data-op]");
    if (op && confirm(op.dataset.confirm)) change({ op: op.dataset.op, name: op.dataset.name, term: op.dataset.term });
  });
  // Textfelder wachsen mit dem Inhalt (Rückfall für Browser ohne field-sizing)
  function autosize(el) { el.style.height = "auto"; el.style.height = el.scrollHeight + 2 + "px"; }
  $$("#admin textarea").forEach(function (t) { t.addEventListener("input", function () { autosize(t); }); });
  $$("#admin details").forEach(function (d) {
    d.addEventListener("toggle", function () { if (d.open) d.querySelectorAll("textarea").forEach(autosize); });
  });

  // Nach unten ziehen zum Neuladen: nur in der App vom Home-Bildschirm (dort fehlt es); ?ptr=1 zum Testen
  (function () {
    var standalone = window.matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
    if (!standalone && !/[?&]ptr=1/.test(location.search)) return;
    var ptr = $("ptr"), icon = ptr.querySelector("svg"), startY = null, pull = 0, TRIGGER = 70, MAX = 110;
    function place(offset, animate) {
      ptr.style.transition = animate ? "" : "none";
      ptr.style.transform = "translateY(" + (offset - 70) + "px)";
      ptr.style.opacity = Math.min(offset / TRIGGER, 1);
    }
    document.addEventListener("touchstart", function (e) {
      startY = window.scrollY <= 0 ? e.touches[0].clientY : null;
      pull = 0;
    }, { passive: true });
    document.addEventListener("touchmove", function (e) {
      if (startY === null) return;
      pull = Math.min(Math.max(0, e.touches[0].clientY - startY) * 0.5, MAX);
      place(pull, false);
      icon.style.transform = "rotate(" + pull * 3 + "deg)";
      ptr.classList.toggle("ready", pull >= TRIGGER);
    }, { passive: true });
    document.addEventListener("touchend", function () {
      if (startY === null) return;
      startY = null;
      if (pull >= TRIGGER) {
        place(TRIGGER, true);
        icon.style.transform = "";
        ptr.classList.add("loading");
        setTimeout(function () { location.reload(); }, 250);
      } else {
        place(0, true);
        ptr.classList.remove("ready");
      }
    });
  })();

  (function () {
    var h = location.hash.slice(1);
    if (h === "settings") h = "sources";
    if (HASH_TABS.indexOf(h) !== -1) state.tab = h;
  })();
  computeSourceAvg();
  render();

  // Team-Daten laden; Gemerktes aus der Zeit vor der Datenbank einmal hochladen
  api("state").then(function (d) {
    var before = saved;
    server = Object.assign(d, { online: true });
    saved = {};
    d.saved.forEach(function (f) { saved[f.id] = f; });
    if (!d.saved.length && Object.keys(before).length && !store.get("psn-favs-migrated", false)) {
      Object.keys(before).forEach(function (id) { saved[id] = before[id]; api("save", { id: id, item: before[id] }).catch(function () {}); });
      store.set("psn-favs-migrated", true);
    }
    computeSourceAvg();
    render();
  }).catch(function () { /* offline: lokale Votes, Quellenwahl und Gemerkt */ });
})();
</script>
</body>
</html>
