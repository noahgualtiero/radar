<!doctype html>
<html lang="de-CH">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<title>Radar</title>
<link rel="icon" href="logo.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="logo.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% if password_hash %}
<script>
  // Passwort-Sperre: blendet die Seite aus, bis das Passwort einmal eingegeben wurde
  try { if (localStorage.getItem("psn-auth") !== "{{ password_hash }}") document.documentElement.classList.add("locked"); }
  catch (e) { document.documentElement.classList.add("locked"); }
</script>
{% endif %}
<style>
/* Farben nach den iOS-Systemfarben (Hintergrund gruppiert, Labels, Trennlinien, Systemblau) */
:root {
  --bg: #f2f2f7; --card: #ffffff; --fill: rgba(120,120,128,.12); --text: #000000;
  --label2: rgba(60,60,67,.6); --label3: rgba(60,60,67,.3); --sep: rgba(60,60,67,.18);
  --accent: #007aff; --accent-soft: rgba(0,122,255,.1); --orange: #ff9500; --purple: #af52de; --red: #ff3b30; --green: #34c759;
  --bar: rgba(249,249,249,.82); --shadow: 0 1px 2px rgba(0,0,0,.04), 0 4px 16px rgba(0,0,0,.04);
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #000000; --card: #1c1c1e; --fill: rgba(118,118,128,.24); --text: #ffffff;
    --label2: rgba(235,235,245,.6); --label3: rgba(235,235,245,.3); --sep: rgba(84,84,88,.6);
    --accent: #0a84ff; --accent-soft: rgba(10,132,255,.18); --orange: #ff9f0a; --purple: #bf5af2; --red: #ff453a; --green: #30d158;
    --bar: rgba(22,22,24,.82); --shadow: none;
  }
}
:root[data-theme="dark"] {
  --bg: #000000; --card: #1c1c1e; --fill: rgba(118,118,128,.24); --text: #ffffff;
  --label2: rgba(235,235,245,.6); --label3: rgba(235,235,245,.3); --sep: rgba(84,84,88,.6);
  --accent: #0a84ff; --accent-soft: rgba(10,132,255,.18); --orange: #ff9f0a; --purple: #bf5af2; --red: #ff453a; --green: #30d158;
  --bar: rgba(22,22,24,.82); --shadow: none; color-scheme: dark;
}
:root[data-theme="light"] { color-scheme: light; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.47 Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-feature-settings: "cv11", "ss01"; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%; }
button, input, select { font: inherit; color: inherit; }
a { color: var(--accent); }
svg { flex: none; }

/* Navigationsleiste oben: durchscheinend wie bei iOS */
.navbar { position: sticky; top: 0; z-index: 20; background: var(--bar); border-bottom: .5px solid var(--sep);
  -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); padding-top: env(safe-area-inset-top); }
.navbar .in { max-width: 1100px; margin: 0 auto; padding: 8px 20px; display: flex; gap: 12px; align-items: center; }
.brand { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--text); flex: none; }
.brand img { width: 30px; height: 30px; border-radius: 7px; }
.brand b { font-weight: 800; font-size: 1.12rem; letter-spacing: -.02em; }
.search { flex: 1; min-width: 0; max-width: 420px; margin-left: auto; position: relative; }
.search svg { position: absolute; left: 9px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--label2); }
.search input { width: 100%; background: var(--fill); border: 0; border-radius: 10px; padding: 8px 10px 8px 32px; font-size: 16px; }
.search input:focus { outline: 2px solid var(--accent-soft); }
.icon { background: none; border: 0; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center;
  cursor: pointer; color: var(--accent); flex: none; }
.icon:hover, .icon[aria-pressed="true"] { background: var(--fill); }
.icon svg { width: 22px; height: 22px; }

/* Grundraster: Seitenleiste auf dem Desktop, Tab-Leiste auf dem Handy */
.shell { max-width: 1100px; margin: 0 auto; padding: 0 20px; display: grid; grid-template-columns: 236px minmax(0, 640px); gap: 36px; justify-content: center; }
.sidebar { position: sticky; top: 64px; align-self: start; max-height: calc(100vh - 64px); overflow: auto; padding: 22px 0 40px; scrollbar-width: none; }
.side-nav button { display: flex; align-items: center; gap: 12px; width: 100%; background: none; border: 0; border-radius: 10px;
  padding: 8px 10px; cursor: pointer; font-size: .97rem; font-weight: 500; text-align: left; }
.side-nav button:hover { background: var(--fill); }
.side-nav button[aria-selected="true"], .side-nav button[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
.side-nav svg { width: 22px; height: 22px; color: var(--accent); }
.side-nav .n { margin-left: auto; color: var(--label2); font-size: .82rem; font-weight: 500; }
.side-title { font-size: .8rem; font-weight: 600; color: var(--label2); margin: 22px 10px 6px; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--label3); margin: 0 7px; }
.dot.w2 { background: var(--orange); } .dot.w3 { background: var(--red); }

main { padding: 22px 0 60px; min-width: 0; }
.page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin: 0 0 14px; }
.eyebrow { font-size: .8rem; font-weight: 600; color: var(--label2); text-transform: uppercase; letter-spacing: .04em; margin: 0; }
.large-title { font-size: 2.1rem; font-weight: 800; letter-spacing: -.03em; line-height: 1.1; margin: 2px 0 0; }

/* Themen-Chips (Handy) */
.chips { display: none; gap: 8px; overflow-x: auto; margin: 0 -20px 14px; padding: 0 20px 2px; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex: none; border: 0; background: var(--card); box-shadow: var(--shadow); border-radius: 999px; padding: 7px 14px;
  cursor: pointer; font-size: .88rem; font-weight: 500; white-space: nowrap; }
.chip[aria-pressed="true"] { background: var(--accent); color: #fff; }
.chip .n { opacity: .65; font-size: .82em; margin-left: 4px; }

.card { background: var(--card); border-radius: 16px; box-shadow: var(--shadow); margin-bottom: 16px; }
.active-filter { display: flex; gap: 8px; align-items: center; margin: 0 0 14px; font-size: .9rem; color: var(--label2); }
.active-filter button { background: var(--accent-soft); color: var(--accent); border: 0; border-radius: 999px; padding: 5px 12px; cursor: pointer; font-weight: 600; }
.link { background: none; border: 0; padding: 0; color: var(--accent); cursor: pointer; font-size: inherit; font-weight: 500; }
.muted, .n { color: var(--label2); }

/* Briefing */
.briefing { padding: 18px 20px; }
.briefing-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
.briefing h2 { font-size: 1.2rem; font-weight: 700; letter-spacing: -.02em; margin: 0; }
.briefing .date { color: var(--label2); font-size: .85rem; }
.brief-topic { margin-top: 16px; }
.brief-topic > .head { display: flex; align-items: baseline; gap: 6px; }
.brief-topic > .head button { font-weight: 700; font-size: .95rem; }
.brief-topic ol { margin: 6px 0 0; padding: 0; list-style: none; }
.brief-topic li { padding: 7px 0; border-top: .5px solid var(--sep); font-size: .93rem; line-height: 1.4; }
.brief-topic li a { color: var(--text); text-decoration: none; font-weight: 500; }
.brief-topic li a:hover { color: var(--accent); }
.brief-topic li .n { display: block; font-size: .8rem; margin-top: 1px; }
.brief-line { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: .88rem; }
.brief-line .chip { box-shadow: none; background: var(--fill); font-size: .82rem; padding: 5px 12px; }
.multi { margin-top: 14px; font-size: .9rem; }
.multi a { color: var(--text); font-weight: 500; }

/* Beiträge */
.post { overflow: hidden; }
.post-head { display: flex; gap: 11px; align-items: center; padding: 14px 16px 10px; }
.avatar { position: relative; width: 38px; height: 38px; border-radius: 50%; flex: none; display: grid; place-items: center;
  font-weight: 700; font-size: .8rem; color: #fff; background: hsl(var(--h, 210) 55% 50%); overflow: hidden; box-shadow: 0 0 0 .5px var(--sep); }
.avatar img { position: absolute; inset: 0; width: 100%; height: 100%; padding: 7px; background: #fff; object-fit: contain; }
.who { min-width: 0; flex: 1; line-height: 1.25; }
.who .src { display: block; background: none; border: 0; padding: 0; font-weight: 600; font-size: .95rem; cursor: pointer;
  max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: left; }
.who .src:hover { color: var(--accent); }
.who .sub { color: var(--label2); font-size: .8rem; }
.badge { border-radius: 6px; padding: 2px 8px; font-size: .72rem; font-weight: 600; background: var(--accent-soft); color: var(--accent); }
.post-body { padding: 0 16px 12px; }
.post-body h2 { font-size: 1.12rem; font-weight: 700; letter-spacing: -.015em; line-height: 1.32; margin: 0 0 6px; }
.post-body h2 a { color: inherit; text-decoration: none; }
.post-body h2 a:hover { color: var(--accent); }
.post-body p { margin: 0; color: var(--label2); font-size: .94rem; overflow-wrap: anywhere; }
.tags { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px; }
.tag { background: var(--fill); border: 0; border-radius: 999px; padding: 3px 10px; color: var(--text); font-size: .8rem; font-weight: 500; cursor: pointer; }
.tag:hover { background: var(--accent-soft); color: var(--accent); }
.post-img { display: block; margin: 0 16px 4px; border-radius: 12px; overflow: hidden; background: var(--fill); }
.post-img img { width: 100%; max-height: 360px; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
.actions { position: relative; display: flex; justify-content: flex-end; gap: 4px; padding: 4px 8px 8px; }
.actions > button { display: flex; gap: 6px; align-items: center; background: none; border: 0; padding: 8px 12px; min-height: 40px;
  color: var(--label2); font-size: .86rem; font-weight: 500; cursor: pointer; border-radius: 10px; }
.actions > button:hover { background: var(--fill); color: var(--text); }
.actions svg { width: 20px; height: 20px; }
.post.is-fav .act-favs { color: var(--orange); }
.post.is-blog .act-blog { color: var(--purple); }
.post.is-fav .act-favs svg path, .post.is-blog .act-blog svg path { fill: currentColor; }
.menu { position: absolute; right: 8px; bottom: 48px; z-index: 5; background: var(--card); border-radius: 13px;
  box-shadow: 0 10px 40px rgba(0,0,0,.2), 0 0 0 .5px var(--sep); min-width: 250px; overflow: hidden; }
.menu button { display: block; width: 100%; text-align: left; background: none; border: 0; padding: 12px 16px; cursor: pointer; font-size: .95rem; }
.menu button + button { border-top: .5px solid var(--sep); }
.menu button:hover { background: var(--fill); }
.menu .destructive { color: var(--red); }
.seen-line { display: flex; align-items: center; gap: 12px; color: var(--label2); font-size: .8rem; font-weight: 500; margin: 8px 0 24px; }
.seen-line::before, .seen-line::after { content: ""; flex: 1; border-top: .5px solid var(--sep); }
.empty { color: var(--label2); padding: 48px 20px; text-align: center; }

/* Gemerkt */
.seg { display: inline-flex; background: var(--fill); border-radius: 9px; padding: 2px; }
.seg button { background: none; border: 0; border-radius: 7px; padding: 5px 14px; cursor: pointer; font-weight: 500; font-size: .88rem; }
.seg button[aria-pressed="true"] { background: var(--card); box-shadow: 0 1px 3px rgba(0,0,0,.12); font-weight: 600; }
.list-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
.add-form { padding: 16px; display: grid; gap: 10px; }
.add-form input, .add-form select { width: 100%; background: var(--fill); border: 0; border-radius: 10px; padding: 10px 12px; font-size: 16px; }
.btn { background: var(--accent); color: #fff; border: 0; border-radius: 999px; padding: 8px 16px; font-weight: 600; cursor: pointer; }
.btn.plain { background: var(--fill); color: var(--accent); }

/* Pflege */
.admin { padding: 18px 20px; }
.admin h2 { font-size: 1.05rem; font-weight: 700; margin: 0 0 4px; }
.admin .lead { color: var(--label2); font-size: .84rem; margin: 0 0 12px; }
.table { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: .86rem; }
th, td { text-align: left; padding: 9px 10px 9px 0; border-bottom: .5px solid var(--sep); vertical-align: top; }
th { color: var(--label2); font-weight: 600; font-size: .76rem; white-space: nowrap; }
.num { text-align: right; }
.vote-up { color: var(--green); font-weight: 600; } .vote-down { color: var(--red); font-weight: 600; }
.hits { margin: 6px 0 0; padding-left: 18px; font-size: .85rem; }
.admin ul.plain { list-style: none; padding: 0; margin: 0; font-size: .92rem; }
.admin ul.plain li { display: flex; justify-content: space-between; gap: 8px; padding: 9px 0; border-bottom: .5px solid var(--sep); }

/* Tab-Leiste unten (Handy) */
.tabbar { display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; background: var(--bar); border-top: .5px solid var(--sep);
  -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); padding-bottom: env(safe-area-inset-bottom); }
.tabbar .in { display: flex; }
.tabbar button { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; background: none; border: 0;
  padding: 7px 0 5px; color: var(--label2); font-size: .66rem; font-weight: 500; cursor: pointer; }
.tabbar button[aria-selected="true"] { color: var(--accent); }
.tabbar svg { width: 25px; height: 25px; }

.toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 30; background: rgba(30,30,32,.92); color: #fff;
  -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); border-radius: 14px; padding: 11px 16px; font-size: .9rem;
  display: flex; gap: 16px; align-items: center; box-shadow: 0 8px 30px rgba(0,0,0,.25); white-space: nowrap; }
.toast button { background: none; border: 0; color: #64d2ff; font-weight: 600; cursor: pointer; }
footer { color: var(--label2); font-size: .8rem; padding: 4px 0 24px; }

/* Passwort-Sperre */
.gate { display: none; }
html.locked .navbar, html.locked .shell, html.locked .tabbar { display: none; }
html.locked .gate { display: grid; place-items: center; min-height: 100vh; padding: 24px; }
.gate form { width: 100%; max-width: 320px; text-align: center; }
.gate img { width: 72px; height: 72px; border-radius: 16px; box-shadow: 0 8px 24px rgba(0,0,0,.15); }
.gate h1 { font-size: 1.6rem; font-weight: 800; letter-spacing: -.02em; margin: 16px 0 4px; }
.gate p { color: var(--label2); margin: 0 0 20px; font-size: .92rem; }
.gate input { width: 100%; background: var(--card); border: 0; border-radius: 12px; padding: 13px 14px; font-size: 16px;
  box-shadow: var(--shadow), 0 0 0 .5px var(--sep); text-align: center; }
.gate input:focus { outline: 2px solid var(--accent); }
.gate .btn { width: 100%; margin-top: 10px; padding: 12px; font-size: 1rem; }
.gate .err { color: var(--red); font-size: .88rem; margin-top: 10px; min-height: 1.3em; }

@media (max-width: 900px) {
  .shell { grid-template-columns: minmax(0, 640px); }
  .sidebar { display: none; }
  .chips { display: flex; }
  .tabbar { display: block; }
  main { padding-bottom: calc(90px + env(safe-area-inset-bottom)); }
  .toast { bottom: calc(76px + env(safe-area-inset-bottom)); }
}
@media (max-width: 520px) {
  .navbar .in, .shell { padding-left: 16px; padding-right: 16px; }
  .chips { margin: 0 -16px 14px; padding: 0 16px 2px; }
  .large-title { font-size: 1.9rem; }
  main .card { margin-left: -6px; margin-right: -6px; }
  .actions .lbl { display: none; }
}
</style>
</head>
<body>
{# Symbole im Stil der SF Symbols #}
{% set ico_feed %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 9h10M7 13h10M7 17h6"/></svg>{% endset %}
{% set ico_studies %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>{% endset %}
{% set ico_community %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12z"/></svg>{% endset %}
{% set ico_saved %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4V3z"/></svg>{% endset %}
{% set tabs = [("feed", "Feed", ico_feed), ("studies", "Studien", ico_studies), ("community", "Community", ico_community), ("saved", "Gemerkt", ico_saved)] %}

{% if password_hash %}
<div class="gate">
  <form id="gateForm">
    <img src="logo.svg" alt="">
    <h1>Radar</h1>
    <p>Bitte Passwort eingeben.</p>
    <input type="password" id="gatePw" autocomplete="current-password" aria-label="Passwort" autofocus>
    <button class="btn" type="submit">Öffnen</button>
    <div class="err" id="gateErr"></div>
  </form>
</div>
<script>
  (function () {
    var HASH = "{{ password_hash }}";
    document.getElementById("gateForm").addEventListener("submit", function (e) {
      e.preventDefault();
      var pw = document.getElementById("gatePw").value;
      crypto.subtle.digest("SHA-256", new TextEncoder().encode(pw)).then(function (buf) {
        var hex = Array.prototype.map.call(new Uint8Array(buf), function (b) { return b.toString(16).padStart(2, "0"); }).join("");
        if (hex === HASH) {
          try { localStorage.setItem("psn-auth", HASH); } catch (err) {}
          document.documentElement.classList.remove("locked");
        } else {
          document.getElementById("gateErr").textContent = "Falsches Passwort.";
        }
      });
    });
  })();
</script>
{% endif %}

<header class="navbar">
  <div class="in">
    <a class="brand" href="./" aria-label="Radar"><img src="logo.svg" alt=""><b>Radar</b></a>
    <label class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="q" placeholder="Suchen" aria-label="Suche">
    </label>
    <button class="icon" id="adminBtn" type="button" aria-pressed="false" title="Quellen und Einstellungen" aria-label="Quellen und Einstellungen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
    </button>
  </div>
</header>

<div class="shell">
  <aside class="sidebar">
    <nav class="side-nav" aria-label="Bereiche">
      {% for key, label, icon in tabs %}
      <button type="button" data-tab="{{ key }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ icon }}{{ label }}{% if key == "saved" %}<span class="n" id="nSavedSide"></span>{% endif %}</button>
      {% endfor %}
    </nav>
    <p class="side-title">Themen</p>
    <nav class="side-nav topic-nav" aria-label="Themen">
      <button type="button" data-topic="" aria-pressed="true"><span class="dot"></span>Alle Themen</button>
      {% for t in topics if topic_counts[t] %}
      <button type="button" data-topic="{{ t }}" aria-pressed="false" title="Gewicht {{ weights[t] }}"><span class="dot w{{ weights[t] }}"></span>{{ t }}<span class="n">{{ topic_counts[t] }}</span></button>
      {% endfor %}
    </nav>
  </aside>

  <main>
    <div class="page-head">
      <div>
        <p class="eyebrow" id="eyebrow"><time class="today"></time></p>
        <h1 class="large-title" id="pageTitle">Feed</h1>
      </div>
    </div>

    <div class="chips topic-nav" id="chips" role="group" aria-label="Themen">
      <button class="chip" type="button" data-topic="" aria-pressed="true">Alle</button>
      {% for t in topics if topic_counts[t] %}
      <button class="chip" type="button" data-topic="{{ t }}" aria-pressed="false">{{ t }}<span class="n">{{ topic_counts[t] }}</span></button>
      {% endfor %}
    </div>

    <p class="active-filter" id="activeFilter" hidden>Gefiltert: <button type="button" id="clearFilter"></button></p>

    {# ---------- Briefing ---------- #}
    {% set brief = yesterday.topics[:3] %}
    {% if brief or rising or stories %}
    <section class="card briefing" id="briefing">
      <div class="briefing-head">
        <h2>Briefing</h2>
        <button class="link" type="button" id="briefToggle">Einklappen</button>
      </div>
      <div id="briefBody">
        {% if brief %}
        <span class="date">Das Wichtigste vom <time class="day" datetime="{{ yesterday.date }}">{{ yesterday.date }}</time></span>
        {% for row in brief %}
        <div class="brief-topic">
          <div class="head"><button class="link" type="button" data-topic="{{ row.topic }}">{{ row.topic }}</button><span class="n">{{ row.count }} Beiträge</span></div>
          <ol>{% for a in row.articles[:2] %}<li><a href="{{ a.link }}" target="_blank" rel="noopener">{{ a.title }}</a><span class="n">{{ a.source }}</span></li>{% endfor %}</ol>
        </div>
        {% endfor %}
        {% endif %}
        {% if stories %}
        <div class="multi"><span class="n">Mehrfach berichtet:</span>
          {% for c in stories[:2] %}<a href="{{ c.articles[0].link }}" target="_blank" rel="noopener">{{ c.title }}</a> <span class="n">({{ c.sources }} Quellen)</span>{% if not loop.last %} · {% endif %}{% endfor %}
        </div>
        {% endif %}
        {% if rising %}
        <div class="brief-line"><span class="n">Im Trend</span>
          {% for r in rising %}<button class="chip" type="button" data-topic="{{ r.topic }}" title="{{ r.recent }} Beiträge in 3 Tagen, {{ r.ratio }}× so viele wie üblich">↑ {{ r.topic }}</button>{% endfor %}
        </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    {% if community %}
    <section class="card briefing" id="communityBrief" hidden>
      <h2>Diese Woche</h2>
      <div class="brief-line">
        {% for t, n in community %}<button class="chip" type="button" data-topic="{{ t }}">{{ t }} · {{ n }}</button>{% endfor %}
      </div>
    </section>
    {% endif %}

    {# ---------- Gemerkt ---------- #}
    <section id="savedHead" hidden>
      <div class="list-head">
        <div class="seg" id="seg">
          <button type="button" data-list="favs" aria-pressed="true">Gemerkt <span class="n" id="nFavs">0</span></button>
          <button type="button" data-list="blog" aria-pressed="false">Blog-Ideen <span class="n" id="nBlog">0</span></button>
        </div>
        <div>
          <button class="btn plain" type="button" id="copyList">Kopieren</button>
          <button class="btn" type="button" id="addBtn">+ Link</button>
        </div>
      </div>
      <form class="card add-form" id="addForm" hidden>
        <input type="url" id="addUrl" placeholder="Link zu einem Artikel von anderswo" required>
        <input type="text" id="addTitle" placeholder="Titel (optional)">
        <select id="addTopic"><option value="">Thema (optional)</option>{% for t in topics %}<option>{{ t }}</option>{% endfor %}</select>
        <div><button class="btn" type="submit">Ablegen</button> <button class="link" type="button" id="addCancel">Abbrechen</button></div>
      </form>
    </section>

    <div id="feed">
    {% for item in items %}
    <article class="card post" data-id="{{ item.id }}" data-cat="{{ item.category }}" data-source="{{ item.source }}"
      data-domain="{{ item.domain }}" data-seen="{{ item.first_seen }}" data-published="{{ item.published }}"
      data-topics="{{ item.topics|join('|') }}" data-weight="{{ item.weight }}" data-study="{{ 1 if item.study else 0 }}"
      data-text="{{ (item.title ~ ' ' ~ item.snippet ~ ' ' ~ item.source ~ ' ' ~ item.topics|join(' '))|lower }}">
      <header class="post-head">
        <span class="avatar" aria-hidden="true">{{ item.source[:2]|upper }}<img src="https://www.google.com/s2/favicons?domain={{ item.domain }}&amp;sz=64" alt="" loading="lazy" onerror="this.remove()"></span>
        <div class="who">
          <button class="src" type="button" title="Nur diese Quelle zeigen">{{ item.source }}</button>
          <span class="sub"><time datetime="{{ item.published }}">{{ item.published[8:10] }}.{{ item.published[5:7] }}.{{ item.published[0:4] }}</time></span>
        </div>
        {% if item.study %}<span class="badge">Studie</span>{% endif %}
      </header>
      <div class="post-body">
        <h2><a href="{{ item.link }}" target="_blank" rel="noopener">{{ item.title }}</a></h2>
        {% if item.snippet %}<p>{{ item.snippet }}</p>{% endif %}
      </div>
      {% if item.image %}
      <a class="post-img" href="{{ item.link }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
        <img src="{{ item.image }}" alt="" loading="lazy" decoding="async" onerror="this.parentNode.remove()">
      </a>
      {% endif %}
      {% if item.topics %}<div class="post-body tags-wrap"><div class="tags">{% for t in item.topics %}<button class="tag" type="button" data-topic="{{ t }}">{{ t }}</button>{% endfor %}</div></div>{% endif %}
      <div class="actions">
        <button class="act-favs" type="button" data-act="favs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4V3z"/></svg><span class="lbl">Merken</span></button>
        <button class="act-blog" type="button" data-act="blog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4L16.5 3.5z"/></svg><span class="lbl">Blog-Idee</span></button>
        <button class="more" type="button" data-act="menu" aria-label="Weitere Aktionen"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg></button>
      </div>
    </article>
    {% endfor %}
    </div>
    <div id="listFeed" hidden></div>
    <p class="empty" id="empty" hidden></p>

    {# ---------- Pflege ---------- #}
    <section id="admin" hidden>
      <div class="card admin">
        <h2>Quellen</h2>
        <p class="lead">Feste Quellen aus <code>sources.yaml</code>, letzte {{ max_age_days }} Tage. «Themen» = Anteil der Beiträge mit Themen-Treffer.
          Bewertung und Gemerkt stammen aus diesem Browser.</p>
        <div class="table"><table>
          <thead><tr><th>Quelle</th><th class="num">Beiträge</th><th class="num">Themen</th><th>Letzter</th><th>Bewertung</th><th class="num">Gemerkt</th></tr></thead>
          <tbody>
          {% for s in stats %}
            <tr data-source="{{ s.name }}">
              <td><strong>{{ s.name }}</strong><br><span class="n">{{ s.category }} · {{ s.host }}{% if s.filtered %} · gefiltert{% endif %}</span></td>
              <td class="num">{{ s.count }}</td>
              <td class="num">{{ s.topic_share ~ " %" if s.topic_share is not none else "–" }}</td>
              <td>{% if s.latest %}<time datetime="{{ s.latest }}">{{ s.latest[8:10] }}.{{ s.latest[5:7] }}.</time>{% else %}–{% endif %}</td>
              <td class="c-vote">–</td><td class="num c-saved">0</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      </div>

      <div class="card admin">
        <h2>Stummgeschaltete Quellen</h2>
        <ul class="plain" id="mutedList"></ul>
        <p class="lead" id="mutedEmpty">Keine. Über «⋯» bei einem Beitrag lässt sich eine Quelle stummschalten.</p>
      </div>

      {% if unknown %}
      <div class="card admin">
        <h2>Vorschläge für neue Quellen</h2>
        <p class="lead">Seiten, die bei den Google-News-Suchbegriffen auftauchen und noch keine feste Quelle sind, häufigste zuerst.
          Passt eine, den Feed mit <code>find_feed.py</code> suchen und in <code>sources.yaml</code> aufnehmen.</p>
        <div class="table"><table>
          <thead><tr><th>Seite</th><th class="num">Treffer</th><th>Zuletzt</th></tr></thead>
          <tbody>
          {% for u in unknown[:40] %}
            <tr><td><a href="https://{{ u.domain }}" target="_blank" rel="noopener">{{ u.domain }}</a>
                <details><summary class="n">Artikel zeigen</summary><ul class="hits">
                  {% for a in u.articles %}<li><a href="{{ a.link }}" target="_blank" rel="noopener">{{ a.title }}</a></li>{% endfor %}
                </ul></details></td>
              <td class="num">{{ u.count }}</td>
              <td><time datetime="{{ u.latest }}">{{ u.latest[8:10] }}.{{ u.latest[5:7] }}.</time></td></tr>
          {% endfor %}
          </tbody>
        </table></div>
      </div>
      {% endif %}

      <div class="card admin">
        <h2>Darstellung</h2>
        <div class="seg" id="themeSeg"><button type="button" data-theme="" aria-pressed="true">Automatisch</button><button type="button" data-theme="light" aria-pressed="false">Hell</button><button type="button" data-theme="dark" aria-pressed="false">Dunkel</button></div>
      </div>

      <div class="card admin">
        <h2>Letzter Lauf</h2>
        <p class="lead">Stand: <time id="generated" datetime="{{ generated }}">{{ generated[:16]|replace("T", " ") }} UTC</time> · {{ stats|length }} feste Quellen</p>
        {% if errors %}
        <ul class="plain">{% for e in errors %}<li><span>{{ e.source }}</span><span class="n">{{ e.error }}</span></li>{% endfor %}</ul>
        {% else %}<p class="lead">Alle Quellen erreichbar.</p>{% endif %}
      </div>
    </section>

    <footer>Inhalte gehören den jeweiligen Quellen.</footer>
  </main>
</div>

<nav class="tabbar" aria-label="Bereiche">
  <div class="in">
    {% for key, label, icon in tabs %}
    <button type="button" data-tab="{{ key }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ icon }}{{ label }}</button>
    {% endfor %}
  </div>
</nav>

<div class="toast" id="toast" hidden><span id="toastText"></span><button type="button" id="toastUndo">Widerrufen</button></div>

<script>
(function () {
  var store = {
    get: function (k, d) { try { var v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
    set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  };
  var $ = function (id) { return document.getElementById(id); };
  var $$ = function (sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); };
  var DAY = 864e5, BOOST = 2 * DAY, WEIGHT_SHIFT = DAY / 4;
  var TITLES = { feed: "Feed", studies: "Studien", community: "Community", saved: "Gemerkt", admin: "Quellen" };

  // Farbschema
  var root = document.documentElement, theme = store.get("psn-theme", "");
  function applyTheme() {
    if (theme) root.setAttribute("data-theme", theme); else root.removeAttribute("data-theme");
    $$("#themeSeg button").forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.theme === theme ? "true" : "false"); });
  }
  applyTheme();
  $$("#themeSeg button").forEach(function (b) {
    b.addEventListener("click", function () { theme = b.dataset.theme; store.set("psn-theme", theme); applyTheme(); });
  });

  // Datumsangaben
  var dateFmt = new Intl.DateTimeFormat("de-CH", { day: "numeric", month: "long" });
  var dayFmt = new Intl.DateTimeFormat("de-CH", { weekday: "long", day: "numeric", month: "long" });
  function fmt(iso) {
    var d = new Date(iso), h = (Date.now() - d) / 36e5;
    if (h < 1) return "Gerade eben";
    if (h < 24) return "Vor " + Math.floor(h) + " Std.";
    if (h < 48) return "Gestern";
    return dateFmt.format(d);
  }
  $$(".post time").forEach(function (t) { t.textContent = fmt(t.dateTime); });
  $$("time.day").forEach(function (t) { t.textContent = dayFmt.format(new Date(t.dateTime + "T12:00:00")); });
  $$("time.today").forEach(function (t) { t.textContent = dayFmt.format(new Date()); });
  $("generated").textContent = new Intl.DateTimeFormat("de-CH", { dateStyle: "medium", timeStyle: "short" }).format(new Date($("generated").dateTime));

  function hue(s) { var h = 0; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return h; }
  function paintAvatar(post) { post.querySelector(".avatar").style.setProperty("--h", hue(post.dataset.source)); }

  var feed = $("feed"), listFeed = $("listFeed");
  var posts = Array.prototype.slice.call(feed.querySelectorAll(".post"));
  posts.forEach(paintAvatar);
  var seenLine = document.createElement("div");
  seenLine.className = "seen-line"; seenLine.textContent = "Bis hier gelesen";

  // Was seit dem letzten Besuch neu ist, steht oben; darunter die Linie "Bis hier gelesen"
  var lastVisit = store.get("psn-last-visit", null);
  store.set("psn-last-visit", new Date().toISOString());
  function isNew(p) { return !!lastVisit && p.dataset.seen > lastVisit; }

  // Im Browser gespeichert: Bewertung je Quelle (+1 mehr, -1 stumm), Gemerkt, Blog-Ideen
  var votes = store.get("psn-votes", {});
  var lists = { favs: store.get("psn-favs", {}), blog: store.get("psn-blog", {}) };
  var briefOpen = store.get("psn-brief-open", true);

  function snapshot(post) {
    var a = post.querySelector("h2 a"), p = post.querySelector(".post-body p"), img = post.querySelector(".post-img img");
    return { id: post.dataset.id, title: a.textContent, link: a.href, source: post.dataset.source, domain: post.dataset.domain,
      category: post.dataset.cat, published: post.dataset.published, snippet: p ? p.textContent : "",
      image: img ? img.src : null, topics: post.dataset.topics, saved: new Date().toISOString() };
  }

  var state = { tab: "feed", list: "favs", admin: false, topic: "", source: "", q: "" };
  var TABS = {
    feed: function (p) { return p.dataset.cat !== "Community"; },
    studies: function (p) { return p.dataset.study === "1"; },
    community: function (p) { return p.dataset.cat === "Community"; }
  };
  var EMPTY = {
    feed: "Keine Beiträge für diese Auswahl.", studies: "Keine Studien für diese Auswahl.", community: "Keine Community-Beiträge für diese Auswahl.",
    favs: "Noch nichts gemerkt. Über «Merken» bei einem Beitrag oder «+ Link» landet es hier.",
    blog: "Noch keine Blog-Ideen. Über «Blog-Idee» bei einem Beitrag oder «+ Link» landet es hier."
  };

  function score(p) {
    return new Date(p.dataset.published).getTime() + (votes[p.dataset.source] > 0 ? BOOST : 0) + (+p.dataset.weight || 0) * WEIGHT_SHIFT;
  }
  function matches(p) {
    var terms = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    return TABS[state.tab](p) && !(votes[p.dataset.source] < 0)
      && (!state.topic || p.dataset.topics.split("|").indexOf(state.topic) !== -1)
      && (!state.source || p.dataset.source === state.source)
      && terms.every(function (t) { return p.dataset.text.indexOf(t) !== -1; });
  }
  function decorate(p) {
    p.classList.toggle("is-fav", !!lists.favs[p.dataset.id]);
    p.classList.toggle("is-blog", !!lists.blog[p.dataset.id]);
  }

  function buildSavedPost(f) {
    var live = feed.querySelector('.post[data-id="' + CSS.escape(f.id) + '"]');
    if (live) { var c = live.cloneNode(true); c.hidden = false; return c; }
    // Nicht (mehr) im Feed: aus dem gespeicherten Stand aufbauen
    var tpl = posts[0].cloneNode(true);
    tpl.hidden = false;
    Object.assign(tpl.dataset, { id: f.id, source: f.source, cat: f.category, published: f.published, topics: f.topics || "", domain: f.domain || "" });
    var av = tpl.querySelector(".avatar"), favicon = av.querySelector("img");
    av.firstChild.textContent = f.source.slice(0, 2).toUpperCase();
    if (favicon) { if (f.domain) favicon.src = "https://www.google.com/s2/favicons?domain=" + encodeURIComponent(f.domain) + "&sz=64"; else favicon.remove(); }
    tpl.querySelector(".src").textContent = f.source;
    tpl.querySelector(".sub").textContent = f.category === "Abgelegt" ? "Selbst abgelegt" : fmt(f.published);
    var a = tpl.querySelector("h2 a"); a.textContent = f.title; a.href = f.link;
    var p = tpl.querySelector(".post-body p"); if (p) { p.textContent = f.snippet || ""; p.hidden = !f.snippet; }
    ["tags-wrap", "badge", "post-img"].forEach(function (cls) { var el = tpl.querySelector("." + cls); if (el) el.remove(); });
    if (f.topics) {
      var wrap = document.createElement("div"), box = document.createElement("div");
      wrap.className = "post-body tags-wrap"; box.className = "tags";
      f.topics.split("|").forEach(function (t) {
        var b = document.createElement("button"); b.className = "tag"; b.type = "button"; b.dataset.topic = t; b.textContent = t; box.appendChild(b);
      });
      wrap.appendChild(box); tpl.querySelector(".actions").before(wrap);
    }
    return tpl;
  }

  function renderAdmin() {
    $$("#admin tr[data-source]").forEach(function (tr) {
      var name = tr.dataset.source, v = votes[name] || 0, cell = tr.querySelector(".c-vote");
      cell.textContent = v > 0 ? "▲ mehr" : v < 0 ? "stumm" : "–";
      cell.className = "c-vote " + (v > 0 ? "vote-up" : v < 0 ? "vote-down" : "");
      tr.querySelector(".c-saved").textContent = ["favs", "blog"].reduce(function (sum, l) {
        return sum + Object.keys(lists[l]).filter(function (id) { return lists[l][id].source === name; }).length;
      }, 0);
    });
    var muted = Object.keys(votes).filter(function (n) { return votes[n] < 0; }).sort(), ul = $("mutedList");
    ul.innerHTML = "";
    muted.forEach(function (name) {
      var li = document.createElement("li"), b = document.createElement("button");
      li.appendChild(document.createTextNode(name));
      b.className = "link"; b.type = "button"; b.textContent = "Zurückholen";
      b.addEventListener("click", function () { delete votes[name]; store.set("psn-votes", votes); render(); });
      li.appendChild(b); ul.appendChild(li);
    });
    $("mutedEmpty").hidden = muted.length > 0;
  }

  function render() {
    var tab = state.tab, saved = tab === "saved", shown = 0, admin = state.admin;
    var filtered = !!(state.topic || state.source || state.q);
    var nFavs = Object.keys(lists.favs).length, nBlog = Object.keys(lists.blog).length;
    $("nFavs").textContent = nFavs; $("nBlog").textContent = nBlog;
    $("nSavedSide").textContent = nFavs + nBlog || "";
    $("pageTitle").textContent = TITLES[admin ? "admin" : tab];
    $("adminBtn").setAttribute("aria-pressed", admin ? "true" : "false");
    $$("[data-tab]").forEach(function (b) { b.setAttribute("aria-selected", !admin && b.dataset.tab === tab ? "true" : "false"); });
    $$(".topic-nav [data-topic]").forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.topic === state.topic ? "true" : "false"); });
    $("admin").hidden = !admin;
    $("chips").hidden = admin || saved;
    var briefing = $("briefing"), communityBrief = $("communityBrief");
    if (briefing) {
      briefing.hidden = admin || tab !== "feed" || filtered;
      $("briefBody").hidden = !briefOpen;
      $("briefToggle").textContent = briefOpen ? "Einklappen" : "Aufklappen";
    }
    if (communityBrief) communityBrief.hidden = admin || tab !== "community" || filtered;
    $("savedHead").hidden = admin || !saved;
    feed.hidden = admin || saved;
    listFeed.hidden = admin || !saved;
    $("activeFilter").hidden = admin || saved || !(state.topic || state.source);
    $("clearFilter").textContent = (state.source ? state.source : state.topic) + "  ✕";

    if (admin) {
      renderAdmin();
    } else if (saved) {
      listFeed.innerHTML = "";
      Object.keys(lists[state.list]).map(function (id) { return lists[state.list][id]; })
        .sort(function (a, b) { return b.saved.localeCompare(a.saved); })
        .forEach(function (f) { var p = buildSavedPost(f); paintAvatar(p); decorate(p); listFeed.appendChild(p); shown++; });
    } else {
      posts.sort(function (a, b) {
        var na = isNew(a), nb = isNew(b);
        return na !== nb ? (na ? -1 : 1) : score(b) - score(a);
      });
      var lineAfter = null;
      posts.forEach(function (p) {
        decorate(p);
        var ok = matches(p);
        p.hidden = !ok;
        if (ok) { shown++; if (isNew(p)) lineAfter = p; }
        feed.appendChild(p);
      });
      var lastShown = posts.filter(function (p) { return !p.hidden; }).pop();
      if (lineAfter && !filtered && lineAfter !== lastShown) lineAfter.after(seenLine); else seenLine.remove();
    }
    $("empty").hidden = admin || shown > 0;
    $("empty").textContent = EMPTY[saved ? state.list : tab];
  }

  function go(changes) { Object.assign(state, changes); render(); window.scrollTo(0, 0); }
  function filterTab() { return TABS[state.tab] ? state.tab : "feed"; }

  $$("[data-tab]").forEach(function (b) { b.addEventListener("click", function () { go({ tab: b.dataset.tab, admin: false }); }); });
  $("adminBtn").addEventListener("click", function () { go({ admin: !state.admin }); });
  $("q").addEventListener("input", function (e) { state.q = e.target.value; state.admin = false; render(); });
  $("clearFilter").addEventListener("click", function () { go({ topic: "", source: "" }); });
  var briefToggle = $("briefToggle");
  if (briefToggle) briefToggle.addEventListener("click", function () { briefOpen = !briefOpen; store.set("psn-brief-open", briefOpen); render(); });
  $$("#seg button").forEach(function (b) {
    b.addEventListener("click", function () {
      $$("#seg button").forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      go({ list: b.dataset.list });
    });
  });

  // Hinweis unten mit "Widerrufen"
  var toastTimer, undoFn;
  function toast(text, undo) {
    $("toastText").textContent = text; undoFn = undo; $("toastUndo").hidden = !undo; $("toast").hidden = false;
    clearTimeout(toastTimer); toastTimer = setTimeout(function () { $("toast").hidden = true; }, 4000);
  }
  $("toastUndo").addEventListener("click", function () { if (undoFn) undoFn(); $("toast").hidden = true; });

  function closeMenus() { $$(".menu").forEach(function (m) { m.remove(); }); }
  function openMenu(post, anchor) {
    closeMenus();
    var src = post.dataset.source, menu = document.createElement("div");
    menu.className = "menu";
    var boost = document.createElement("button"), mute = document.createElement("button");
    boost.type = mute.type = "button";
    boost.textContent = votes[src] > 0 ? "«Mehr von " + src + "» aufheben" : "Mehr von " + src;
    mute.textContent = src + " stummschalten";
    mute.className = "destructive";
    boost.addEventListener("click", function () {
      if (votes[src] > 0) delete votes[src]; else votes[src] = 1;
      store.set("psn-votes", votes); closeMenus(); render();
      toast(votes[src] > 0 ? src + " erscheint weiter oben" : "Zurückgesetzt");
    });
    mute.addEventListener("click", function () {
      var before = votes[src];
      votes[src] = -1; store.set("psn-votes", votes); closeMenus(); render();
      toast(src + " stummgeschaltet", function () {
        if (before === undefined) delete votes[src]; else votes[src] = before;
        store.set("psn-votes", votes); render();
      });
    });
    menu.appendChild(boost); menu.appendChild(mute);
    anchor.parentNode.appendChild(menu);
  }

  document.addEventListener("click", function (e) {
    if (!e.target.closest(".menu") && !e.target.closest("[data-act=menu]")) closeMenus();
    var topicBtn = e.target.closest("[data-topic]");
    if (topicBtn) { go({ topic: topicBtn.dataset.topic, source: "", tab: filterTab(), admin: false }); return; }
    var srcBtn = e.target.closest(".src");
    if (srcBtn) { go({ source: srcBtn.closest(".post").dataset.source, topic: "", tab: filterTab() }); return; }
    var btn = e.target.closest("[data-act]");
    if (!btn) return;
    var post = btn.closest(".post"), act = btn.dataset.act;
    if (act === "menu") { openMenu(post, btn); return; }
    var list = lists[act], id = post.dataset.id, adding = !list[id];
    if (adding) list[id] = snapshot(post); else delete list[id];
    store.set("psn-" + act, list);
    render();
    toast(adding ? (act === "favs" ? "Gemerkt" : "Als Blog-Idee gemerkt") : "Entfernt");
  });

  // Links von anderswo ablegen
  $("addBtn").addEventListener("click", function () { $("addForm").hidden = false; $("addUrl").focus(); });
  $("addCancel").addEventListener("click", function () { $("addForm").reset(); $("addForm").hidden = true; });
  $("addForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var url = $("addUrl").value.trim(), host;
    try { host = new URL(url).hostname.replace(/^www\./, ""); } catch (err) { return; }
    var now = new Date().toISOString();
    lists[state.list]["manual:" + url] = { id: "manual:" + url, link: url, source: host, domain: host, category: "Abgelegt",
      title: $("addTitle").value.trim() || url.replace(/^https?:\/\/(www\.)?/, "").slice(0, 120),
      published: now, snippet: "", image: null, topics: $("addTopic").value, saved: now };
    store.set("psn-" + state.list, lists[state.list]);
    $("addForm").reset(); $("addForm").hidden = true;
    render(); toast("Abgelegt");
  });
  $("copyList").addEventListener("click", function () {
    var list = lists[state.list];
    var text = Object.keys(list).map(function (id) { var f = list[id]; return "- " + f.title + " (" + f.source + ")\n  " + f.link; }).join("\n");
    if (!text) { toast("Liste ist leer"); return; }
    navigator.clipboard.writeText(text).then(function () { toast("Liste kopiert"); });
  });

  render();
})();
</script>
</body>
</html>
