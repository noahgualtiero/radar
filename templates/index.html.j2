<!doctype html>
<html lang="de-CH">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#242526" media="(prefers-color-scheme: dark)">
<title>Radar</title>
<meta name="description" content="Newsradar für Paid Search: Neuigkeiten, Studien und Trends aus ausgewählten Quellen.">
<link rel="icon" href="logo.svg" type="image/svg+xml">
<link rel="icon" href="favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="manifest" href="site.webmanifest">
<meta name="apple-mobile-web-app-title" content="Radar">
<meta property="og:type" content="website">
<meta property="og:title" content="Radar">
<meta property="og:description" content="Newsradar für Paid Search">
{% if site_url %}<meta property="og:url" content="{{ site_url }}">
<meta property="og:image" content="{{ site_url }}og.png">{% endif %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% if password_hash %}
<script>
  // Passwort-Sperre: blendet die Seite aus, bis das Passwort einmal eingegeben wurde
  try { if (localStorage.getItem("psn-auth") !== "{{ password_hash }}") document.documentElement.classList.add("locked"); }
  catch (e) { document.documentElement.classList.add("locked"); }
</script>
{% endif %}
<style>
/* Ruhige, moderne Flächen: neutraler Grund, weisse Karten mit feiner Kante, Systemblau */
:root {
  --bg: #f5f5f7; --card: #ffffff; --text: #0b0b0c; --label2: #6e6e76; --label3: #9a9aa1;
  --fill: rgba(118,118,128,.12); --hover: rgba(118,118,128,.08); --sep: rgba(0,0,0,.08); --accent: #0a66ff; --accent-soft: rgba(10,102,255,.1);
  --green: #1f9d55; --orange: #e8890c; --purple: #8b5cf6; --red: #e5383b; --teal: #0d9488;
  --shadow: 0 1px 2px rgba(0,0,0,.04); --shadow-lg: 0 16px 40px rgba(0,0,0,.16), 0 2px 6px rgba(0,0,0,.06);
  --glass: rgba(245,245,247,.78);
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #000000; --card: #141416; --text: #f5f5f7; --label2: #9b9ba3; --label3: #6e6e76;
    --fill: rgba(118,118,128,.24); --hover: rgba(118,118,128,.16); --sep: rgba(255,255,255,.09); --accent: #3b8bff; --accent-soft: rgba(59,139,255,.16);
    --shadow: none; --shadow-lg: 0 16px 40px rgba(0,0,0,.6); --glass: rgba(0,0,0,.72);
  }
}
:root[data-theme="dark"] {
  --bg: #000000; --card: #141416; --text: #f5f5f7; --label2: #9b9ba3; --label3: #6e6e76;
  --fill: rgba(118,118,128,.24); --hover: rgba(118,118,128,.16); --sep: rgba(255,255,255,.09); --accent: #3b8bff; --accent-soft: rgba(59,139,255,.16);
  --shadow: none; --shadow-lg: 0 16px 40px rgba(0,0,0,.6); --glass: rgba(0,0,0,.72); color-scheme: dark;
}
:root[data-theme="light"] { color-scheme: light; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-feature-settings: "cv11", "ss01"; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%; }
button, input, select { font: inherit; color: inherit; }
a { color: var(--accent); }
svg { flex: none; }

/* Grundraster: schmale Navigation links, Inhalt mittig */
.app { display: grid; grid-template-columns: 252px minmax(0, 1fr); min-height: 100vh; }
.rail { position: sticky; top: 0; height: 100vh; overflow: auto; padding: 22px 14px; border-right: 1px solid var(--sep);
  display: flex; flex-direction: column; gap: 2px; scrollbar-width: none; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); padding: 0 10px 18px; }
.brand img { width: 32px; height: 32px; border-radius: 8px; }
.brand b { font-weight: 800; font-size: 1.15rem; letter-spacing: -.03em; }
.nav button, .rail-btn { display: flex; align-items: center; gap: 12px; width: 100%; background: none; border: 0; border-radius: 10px;
  padding: 9px 10px; cursor: pointer; font-size: .95rem; font-weight: 500; text-align: left; color: var(--text); }
.nav button:hover, .rail-btn:hover { background: var(--hover); }
.nav button[aria-selected="true"], .nav button[aria-pressed="true"], .rail-btn[aria-pressed="true"] { background: var(--fill); font-weight: 650; }
.nav svg, .rail-btn svg { width: 22px; height: 22px; }
.nav .n { margin-left: auto; color: var(--label2); font-size: .8rem; font-weight: 500; }
.nav-title { font-size: .75rem; font-weight: 600; color: var(--label2); text-transform: uppercase; letter-spacing: .06em; margin: 22px 10px 6px; }
.topic-nav button { font-size: .9rem; padding: 7px 10px; }
.topic-nav .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--label3); margin: 0 3px; flex: none; }
.topic-nav .dot.w2 { background: var(--orange); } .topic-nav .dot.w3 { background: var(--red); }
.rail-foot { margin-top: auto; padding-top: 16px; }
.hero { margin-top: 4px; }

.side-search { position: relative; display: block; margin: 0 0 14px; }
.side-search svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); width: 15px; height: 15px; color: var(--label2); }
.side-search input { width: 100%; height: 36px; background: var(--fill); border: 0; border-radius: 10px; padding: 0 10px 0 33px; font-size: .92rem; }
.side-search input::placeholder { color: var(--label2); }
.side-search input:focus { outline: 2px solid var(--accent-soft); background: var(--card); }
.content { width: 100%; max-width: 700px; margin: 0 auto; padding: 24px 24px 60px; min-width: 0; }
.top { position: sticky; top: 0; z-index: 20; display: none; align-items: center; justify-content: flex-start; gap: 8px; min-height: 64px; margin: 0 -24px 4px; padding: 12px 24px;
  background: var(--glass); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid transparent; transition: border-color .2s, padding .2s; }
.top.scrolled { border-bottom-color: var(--sep); }
.eyebrow { font-size: .76rem; font-weight: 600; color: var(--label2); text-transform: uppercase; letter-spacing: .06em; margin: 0; }
.search { position: relative; flex: 1; display: none; }
.top.searching .search, .top.searching .search-cancel { display: block; }
.top.searching .chips, .top.searching .search-btn { display: none !important; }
.search-cancel { display: none; white-space: nowrap; }
.search-btn { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--fill); color: var(--text); display: grid; place-items: center; cursor: pointer; flex: none; }
.search-btn:hover { background: var(--hover); }
.search-btn svg { width: 18px; height: 18px; }
.search svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--label2); }
.search input { width: 100%; height: 42px; background: var(--fill); border: 0; border-radius: 12px; padding: 0 12px 0 36px; font-size: 16px; }
.search input::placeholder { color: var(--label2); }
.search input:focus { outline: 2px solid var(--accent-soft); background: var(--card); }

/* Themen-Chips (schmale Bildschirme) */
.chips { display: none; flex: 1; min-width: 0; gap: 8px; overflow-x: auto; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex: none; border: 0; background: var(--fill); border-radius: 999px; padding: 7px 14px; cursor: pointer; font-size: .88rem; font-weight: 550; white-space: nowrap; }
.chip:hover { background: var(--hover); }
.chip[aria-pressed="true"] { background: var(--text); color: var(--bg); }
.chip .n { opacity: .6; font-weight: 500; font-size: .85em; margin-left: 5px; }
.chip.trend { background: var(--accent-soft); color: var(--accent); }

.card { background: var(--card); border-radius: 18px; border: 1px solid var(--sep); box-shadow: var(--shadow); margin-bottom: 14px; }
.active-filter { display: flex; gap: 8px; align-items: center; margin: 4px 0 12px; font-size: .92rem; color: var(--label2); }
.active-filter button { background: var(--accent-soft); color: var(--accent); border: 0; border-radius: 999px; padding: 6px 12px; cursor: pointer; font-weight: 600; }
.link { background: none; border: 0; padding: 0; color: var(--accent); cursor: pointer; font-size: inherit; font-weight: 600; }
.muted, .n { color: var(--label2); }

/* Heute: Briefing */
.hero { padding: 22px 22px 20px; }
.hero .eyebrow { color: var(--accent); }
.brief-text { font-size: 1.12rem; line-height: 1.6; letter-spacing: -.005em; margin: 10px 0 12px; }
.brief-by { font-size: .8rem; color: var(--label2); margin: 0 0 16px; }
.chip-row { display: flex; flex-wrap: wrap; gap: 6px; }
.hero .chip { font-size: .82rem; padding: 5px 11px; }

/* Beiträge */
.post { overflow: hidden; }
.post-head { display: flex; gap: 10px; align-items: center; padding: 14px 18px 8px; }
.avatar { position: relative; width: 38px; height: 38px; border-radius: 10px; flex: none; display: grid; place-items: center;
  font-weight: 700; font-size: .8rem; color: #fff; background: hsl(var(--h, 210) 55% 50%); overflow: hidden; box-shadow: inset 0 0 0 1px var(--sep); }
.avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #fff; }
.who { min-width: 0; flex: 1; line-height: 1.3; }
.who .src { display: block; background: none; border: 0; padding: 0; font-weight: 600; font-size: .93rem; cursor: pointer;
  max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: left; }
.who .src:hover { text-decoration: underline; }
.who .sub { color: var(--label2); font-size: .8rem; }
.badge { border-radius: 999px; padding: 3px 9px; font-size: .72rem; font-weight: 600; background: rgba(31,157,85,.12); color: var(--green); }
.post-body { padding: 0 18px 12px; }
.post-body h2 { font-size: 1.12rem; font-weight: 700; letter-spacing: -.015em; line-height: 1.32; margin: 0 0 5px; }
.post-body h2 a { color: inherit; text-decoration: none; }
.post-body h2 a:hover { text-decoration: underline; }
.post-body p { margin: 0; font-size: .94rem; color: var(--label2); overflow-wrap: anywhere; }
.tags { display: flex; flex-wrap: wrap; gap: 6px; }
.tag { background: var(--fill); border: 0; border-radius: 999px; padding: 3px 10px; color: var(--text); font-size: .8rem; font-weight: 550; cursor: pointer; }
.tag:hover { background: var(--accent-soft); color: var(--accent); }
.post-img { display: block; margin: 2px 18px 6px; border-radius: 12px; overflow: hidden; background: var(--fill); }
.post-img img { width: 100%; max-height: 360px; aspect-ratio: 1.91 / 1; object-fit: cover; display: block; }
.actions { position: relative; display: flex; justify-content: flex-end; gap: 2px; padding: 2px 10px 8px; }
.actions > button { display: flex; gap: 6px; align-items: center; background: none; border: 0; padding: 8px 12px; min-height: 40px;
  color: var(--label2); font-size: .86rem; font-weight: 550; cursor: pointer; border-radius: 10px; }
.actions > button:hover { background: var(--hover); color: var(--text); }
.actions svg { width: 19px; height: 19px; }
.post.is-fav .act-favs { color: var(--purple); }
.post.is-blog .act-blog { color: var(--teal); }
.post.is-fav .act-favs svg path, .post.is-blog .act-blog svg path { fill: currentColor; }
.menu { position: absolute; right: 8px; bottom: 48px; z-index: 5; background: var(--card); border-radius: 14px; border: 1px solid var(--sep); box-shadow: var(--shadow-lg); padding: 6px; min-width: 260px; }
.menu button { display: block; width: 100%; text-align: left; background: none; border: 0; padding: 10px 12px; border-radius: 8px; cursor: pointer; font-size: .93rem; font-weight: 550; }
.menu button:hover { background: var(--hover); }
.seen-line { display: flex; align-items: center; gap: 12px; color: var(--label2); font-size: .8rem; font-weight: 600; margin: 8px 0 22px; }
.seen-line::before, .seen-line::after { content: ""; flex: 1; border-top: 1px solid var(--sep); }
.empty { color: var(--label2); padding: 48px 20px; text-align: center; }

/* Gemerkt */
.seg { display: inline-flex; background: var(--fill); border-radius: 10px; padding: 2px; }
.seg button { background: none; border: 0; border-radius: 8px; padding: 6px 14px; cursor: pointer; font-weight: 550; font-size: .88rem; }
.seg button[aria-pressed="true"] { background: var(--card); box-shadow: 0 1px 3px rgba(0,0,0,.12); font-weight: 650; }
.list-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 4px 0 14px; flex-wrap: wrap; }
.form { padding: 18px; display: grid; gap: 10px; }
.form input, .form select, .form textarea { width: 100%; background: var(--fill); border: 0; border-radius: 10px; padding: 10px 12px; font-size: 16px; }
.form textarea { font: inherit; font-size: 16px; line-height: 1.45; resize: vertical; min-height: 44px; field-sizing: content; }
.form input:focus, .form select:focus, .form textarea:focus { outline: 2px solid var(--accent-soft); background: var(--card); }
.form .row { display: flex; gap: 10px; flex-wrap: wrap; }
.form .row > * { flex: 1 1 160px; }
.form label { font-size: .84rem; color: var(--label2); font-weight: 500; }
.form label input, .form label select { margin-top: 4px; }
.form label input[type=number] { width: 90px; }
.form .check { display: flex; gap: 8px; align-items: center; color: var(--text); font-size: .93rem; }
.form .check input { width: auto; margin: 0; }
.btn { background: var(--accent); color: #fff; border: 0; border-radius: 999px; padding: 9px 18px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; }
.btn.plain { background: var(--fill); color: var(--text); }

/* Briefing: die drei wichtigsten Punkte */
.points { margin: 4px 0 14px; border-top: 1px solid var(--sep); }
.points-title { font-size: .74rem; font-weight: 650; color: var(--label2); text-transform: uppercase; letter-spacing: .06em; margin: 14px 0 4px; }
.point { display: flex; gap: 12px; padding: 10px 0; text-decoration: none; color: var(--text); border-bottom: 1px solid var(--sep); }
.point:last-child { border-bottom: 0; }
.point img { width: 26px; height: 26px; border-radius: 7px; flex: none; background: var(--fill); margin-top: 2px; }
.point b { display: block; font-size: .95rem; font-weight: 650; line-height: 1.35; }
.point .why { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: .88rem; color: var(--text); opacity: .8; margin-top: 2px; line-height: 1.45; }
.point .src { display: block; font-size: .76rem; color: var(--label2); margin-top: 3px; }
.point:hover b { text-decoration: underline; }

/* Einstellungen: gruppierte Listen wie in den iOS-Einstellungen */
.group-title { font-size: .76rem; font-weight: 650; color: var(--label2); text-transform: uppercase; letter-spacing: .06em; margin: 26px 6px 8px; display: flex; gap: 6px; }
#admin .group-title:first-child { margin-top: 4px; }
.group { padding: 0; overflow: hidden; margin-bottom: 6px; }
.group-note { font-size: .8rem; color: var(--label2); margin: 0 6px 6px; line-height: 1.45; }
.row { border-top: 1px solid var(--sep); }
.group > .row:first-child, .group > .setting:first-child { border-top: 0; }
.row > summary { list-style: none; display: flex; align-items: center; gap: 12px; padding: 11px 14px; min-height: 58px; cursor: pointer; }
.row > summary::-webkit-details-marker { display: none; }
.row > summary:hover { background: var(--hover); }
.row.line { display: flex; align-items: center; gap: 10px; padding: 10px 14px; min-height: 52px; }
.row.line input { flex: 1; min-width: 0; background: var(--fill); border: 0; border-radius: 10px; padding: 9px 12px; font-size: 16px; }
.fav { width: 32px; height: 32px; border-radius: 8px; flex: none; background: var(--fill); object-fit: cover; }
.plus { width: 32px; height: 32px; border-radius: 8px; flex: none; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); font-size: 1.2rem; font-weight: 600; }
.row .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--label3); margin: 0 10px; flex: none; }
.row .dot.w2 { background: var(--orange); } .row .dot.w3 { background: var(--red); }
.row-main { flex: 1; min-width: 0; }
.row-main b { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-weight: 600; font-size: .95rem; line-height: 1.3; overflow-wrap: anywhere; }
.row-main > span { display: block; font-size: .8rem; color: var(--label2); }
.chev { width: 16px; height: 16px; color: var(--label3); flex: none; transition: transform .2s; }
details[open] > summary .chev { transform: rotate(90deg); }
.row-body { padding: 2px 14px 16px 58px; }
.votes { display: flex; gap: 2px; }
.vote { width: 36px; height: 36px; border-radius: 50%; border: 0; background: none; color: var(--label3); display: grid; place-items: center; cursor: pointer; }
.vote:hover { background: var(--fill); color: var(--text); }
.vote svg { width: 19px; height: 19px; }
.vote[data-vote="1"][aria-pressed="true"] { color: var(--green); background: rgba(31,157,85,.12); }
.vote[data-vote="-1"][aria-pressed="true"] { color: var(--orange); background: rgba(232,137,12,.12); }
.vote[data-vote="1"][aria-pressed="true"] svg path, .vote[data-vote="-1"][aria-pressed="true"] svg path { fill: currentColor; }
.row.is-muted .row-main b { color: var(--label2); text-decoration: line-through; }
.facts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; margin: 0 0 14px; }
.facts span { display: block; font-size: .76rem; color: var(--label2); }
.facts b { font-size: .92rem; font-weight: 600; overflow-wrap: anywhere; }
.row-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.btn.danger { color: var(--red); }
.hits { margin: 0 0 12px; padding-left: 18px; font-size: .88rem; line-height: 1.45; }
.hits li { margin: 4px 0; }
.x { width: 32px; height: 32px; border-radius: 50%; border: 0; background: var(--fill); color: var(--label2); cursor: pointer; flex: none; }
.x:hover { color: var(--red); }
.setting { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding: 12px 14px; min-height: 52px; border-top: 1px solid var(--sep); font-size: .95rem; }
.setting.stack { flex-direction: column; align-items: stretch; gap: 8px; }
.setting.end { justify-content: flex-end; }
.setting .ctl { display: flex; align-items: center; gap: 8px; color: var(--label2); font-size: .9rem; }
.setting input[type=number] { width: 70px; text-align: center; }
.setting input[type=number], .setting select, .setting textarea, .form.flat input, .form.flat select, .form.flat textarea {
  background: var(--fill); border: 0; border-radius: 10px; padding: 8px 10px; font-size: 16px; color: var(--text); }
.setting textarea, .form.flat textarea { width: 100%; font: inherit; font-size: 16px; line-height: 1.45; resize: vertical; field-sizing: content; min-height: 42px; }
.form.flat { padding: 0; display: grid; gap: 10px; }
.form.flat .row2 { display: flex; gap: 10px; flex-wrap: wrap; } .form.flat .row2 > * { flex: 1 1 140px; }
.switch { appearance: none; -webkit-appearance: none; width: 50px; height: 30px; border-radius: 999px; background: var(--fill); position: relative; cursor: pointer; flex: none; transition: background .2s; margin: 0; }
.switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 26px; height: 26px; border-radius: 50%; background: #fff; box-shadow: 0 2px 4px rgba(0,0,0,.2); transition: transform .2s; }
.switch:checked { background: var(--green); }
.switch:checked::after { transform: translateX(20px); }

/* Tab-Leiste unten (Handy), durchscheinend */
.tabbar { display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; background: var(--glass); border-top: 1px solid var(--sep);
  -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); padding-bottom: env(safe-area-inset-bottom); }
.tabbar .in { display: flex; }
.tabbar button { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; background: none; border: 0;
  padding: 8px 0 6px; color: var(--label3); font-size: .68rem; font-weight: 600; cursor: pointer; }
.tabbar button[aria-selected="true"] { color: var(--accent); }
.tabbar svg { width: 25px; height: 25px; }

.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: 28px; z-index: 30; background: rgba(28,28,30,.92); color: #fff;
  -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); border-radius: 14px; padding: 11px 16px; font-size: .9rem; font-weight: 500;
  display: flex; gap: 16px; align-items: center; box-shadow: var(--shadow-lg); width: max-content; max-width: calc(100vw - 32px); }
.toast button { background: none; border: 0; color: #64d2ff; font-weight: 700; cursor: pointer; }
footer { color: var(--label2); font-size: .8rem; padding: 8px 0 24px; }

/* Nach unten ziehen zum Neuladen (nur in der App vom Home-Bildschirm, Browser können das selbst) */
.ptr { position: fixed; left: 50%; top: calc(76px + env(safe-area-inset-top)); z-index: 25; width: 40px; height: 40px; margin-left: -20px;
  border-radius: 50%; background: var(--card); box-shadow: var(--shadow-lg); display: grid; place-items: center; color: var(--label2);
  opacity: 0; transform: translateY(-70px); pointer-events: none; transition: transform .25s ease, opacity .25s ease; }
.ptr svg { width: 22px; height: 22px; }
.ptr.ready { color: var(--accent); }
.ptr.loading svg { animation: ptr-spin .7s linear infinite; }
@keyframes ptr-spin { to { transform: rotate(360deg); } }

/* Passwort-Sperre */
.gate { display: none; }
html.locked .app, html.locked .tabbar { display: none; }
html.locked .gate { display: grid; place-items: center; min-height: 100vh; padding: 24px; }
.gate form { width: 100%; max-width: 340px; text-align: center; }
.gate img { width: 72px; height: 72px; border-radius: 17px; box-shadow: var(--shadow-lg); }
.gate h1 { font-size: 1.7rem; font-weight: 800; letter-spacing: -.03em; margin: 18px 0 4px; }
.gate p { color: var(--label2); margin: 0 0 22px; font-size: .95rem; }
.gate input { width: 100%; background: var(--card); border: 1px solid var(--sep); border-radius: 12px; padding: 13px 14px; font-size: 16px; text-align: center; }
.gate input:focus { outline: 2px solid var(--accent-soft); }
.gate .btn { width: 100%; margin-top: 10px; padding: 12px; font-size: 1rem; }
.gate .err { color: var(--red); font-size: .88rem; margin-top: 10px; min-height: 1.3em; }

/* Handy und schmale Fenster */
@media (max-width: 900px) {
  .app { grid-template-columns: minmax(0, 1fr); }
  .rail { display: none; }
  .content { padding: 0 16px calc(96px + env(safe-area-inset-bottom)); }
  .top { display: flex; margin: 0 -16px 4px; padding: calc(10px + env(safe-area-inset-top)) 16px 10px; min-height: 60px; }
  .chips { display: flex; margin-right: -16px; padding-right: 16px; }
  .tabbar { display: block; }
  .toast { bottom: calc(84px + env(safe-area-inset-bottom)); }
}
@media (max-width: 520px) {
  .row-body { padding-left: 14px; }
  .actions .lbl { display: none; }
  .card { border-radius: 16px; }
  .brief-text { font-size: 1.05rem; }
}
</style>
</head>
<body>
{% set ico_feed %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4" width="17" height="16" rx="3"/><path d="M7.5 9h9M7.5 13h9M7.5 17h5"/></svg>{% endset %}
{% set ico_studies %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V11M10 20V5M16 20v-6M21 20H3"/></svg>{% endset %}
{% set ico_community %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12z"/></svg>{% endset %}
{% set ico_saved %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><path d="M6 3.5h12v17l-6-4-6 4v-17z"/></svg>{% endset %}
{% set ico_gear %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>{% endset %}
{% set tabs = [("feed", "Feed", ico_feed), ("studies", "Studien", ico_studies), ("community", "Community", ico_community), ("saved", "Gemerkt", ico_saved)] %}

{% if password_hash %}
<div class="gate">
  <form id="gateForm">
    <img src="logo.svg" alt="">
    <h1>Radar</h1>
    <p>Bitte Passwort eingeben.</p>
    <input type="password" id="gatePw" autocomplete="current-password" placeholder="Passwort" aria-label="Passwort" autofocus>
    <button class="btn" type="submit">Öffnen</button>
    <div class="err" id="gateErr"></div>
  </form>
</div>
<script>
  (function () {
    var HASH = "{{ password_hash }}";
    document.getElementById("gateForm").addEventListener("submit", function (e) {
      e.preventDefault();
      var pw = document.getElementById("gatePw").value;
      crypto.subtle.digest("SHA-256", new TextEncoder().encode(pw)).then(function (buf) {
        var hex = Array.prototype.map.call(new Uint8Array(buf), function (b) { return b.toString(16).padStart(2, "0"); }).join("");
        if (hex === HASH) {
          try { localStorage.setItem("psn-auth", HASH); } catch (err) {}
          document.documentElement.classList.remove("locked");
        } else {
          document.getElementById("gateErr").textContent = "Falsches Passwort.";
        }
      });
    });
  })();
</script>
{% endif %}

<div class="app">
  {# ---------- Navigation links (Desktop) ---------- #}
  <aside class="rail">
    <a class="brand" href="./" aria-label="Radar"><img src="logo.svg" alt=""><b>Radar</b></a>
    <label class="side-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="qSide" placeholder="Suchen" aria-label="Suche" title="Suchen (/)">
    </label>
    <nav class="nav" aria-label="Bereiche">
      {% for key, label, icon in tabs %}
      <button type="button" data-tab="{{ key }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ icon }}{{ label }}{% if key == "saved" %}<span class="n" id="nSavedSide"></span>{% endif %}</button>
      {% endfor %}
    </nav>
    <p class="nav-title">Themen</p>
    <nav class="nav topic-nav" aria-label="Themen">
      <button type="button" data-topic="" aria-pressed="true"><span class="dot"></span>Alle Themen</button>
      {% for t in topics if topic_counts[t] %}
      <button type="button" data-topic="{{ t }}" aria-pressed="false" title="{{ ['', 'normal', 'wichtig', 'sehr wichtig'][weights[t]] }}"><span class="dot w{{ weights[t] }}"></span>{{ t }}<span class="n">{{ topic_counts[t] }}</span></button>
      {% endfor %}
    </nav>
    <div class="rail-foot nav"><button type="button" data-tab="settings" aria-selected="false">{{ ico_gear }}Einstellungen</button></div>
  </aside>

  <div class="content">
    {# Kopf: Lupe vorne, dann Themen-Chips (Handy); die Lupe klappt das Suchfeld auf #}
    <header class="top" id="top">
      <button class="search-btn" type="button" id="searchBtn" aria-label="Suchen" title="Suchen (/)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <div class="chips topic-nav" id="chips" role="group" aria-label="Themen">
        <button class="chip" type="button" data-topic="" aria-pressed="true">Alle</button>
        {% for t in topics if topic_counts[t] %}
        <button class="chip" type="button" data-topic="{{ t }}" aria-pressed="false">{{ t }}<span class="n">{{ topic_counts[t] }}</span></button>
        {% endfor %}
      </div>
      <label class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" id="q" placeholder="In Radar suchen" aria-label="Suche" enterkeyhint="search">
      </label>
      <button class="link search-cancel" type="button" id="searchCancel">Abbrechen</button>
    </header>

    {# ---------- Briefing oben im Feed ---------- #}
    <section class="card hero" id="briefing">
      <p class="eyebrow">Briefing · {{ briefing.label }}</p>
      <p class="brief-text">{{ briefing.text }}</p>
      {% if briefing.points %}
      <div class="points">
        <p class="points-title">Das Wichtigste</p>
        {% for pt in briefing.points %}
        <a class="point" href="{{ pt.link }}" target="_blank" rel="noopener nofollow external">
          <img src="https://www.google.com/s2/favicons?domain={{ pt.domain }}&amp;sz=64" alt="" loading="lazy" onerror="this.style.visibility='hidden'">
          <div><b>{{ pt.title }}</b>{% if pt.why %}<span class="why">{{ pt.why }}</span>{% endif %}<span class="src">{{ pt.source }}</span></div>
        </a>
        {% endfor %}
      </div>
      {% endif %}
      <p class="brief-by">{% if briefing.by == "ki" %}Von KI zusammengefasst aus {{ briefing.total }} Beiträgen.{% else %}Automatisch zusammengestellt aus {{ briefing.total }} Beiträgen.{% endif %}</p>
      {% if briefing.topics or trends %}
      <div class="chip-row">
        {% for t in trends %}<button class="chip trend" type="button" data-q="{{ t.term }}" title="Im Trend: {{ t.count }} Beiträge von {{ t.sources }} Quellen in den letzten 3 Tagen">↗ {{ t.term }}</button>{% endfor %}
        {% for row in briefing.topics %}<button class="chip" type="button" data-topic="{{ row.topic }}">{{ row.topic }}<span class="n">{{ row.count }}</span></button>{% endfor %}
      </div>
      {% endif %}
    </section>

    {% if community %}
    <section class="card hero" id="communityBrief" hidden>
      <p class="eyebrow">Diese Woche in der Community</p>
      <div class="chip-row" style="margin-top:12px">{% for t, n in community %}<button class="chip" type="button" data-topic="{{ t }}">{{ t }}<span class="n">{{ n }}</span></button>{% endfor %}</div>
    </section>
    {% endif %}

  <main>
    <p class="active-filter" id="activeFilter" hidden>Gefiltert: <button type="button" id="clearFilter"></button></p>

    {# ---------- Gemerkt ---------- #}
    <section id="savedHead" hidden>
      <div class="list-head">
        <div class="seg" id="seg">
          <button type="button" data-list="favs" aria-pressed="true">Gemerkt <span class="n" id="nFavs">0</span></button>
          <button type="button" data-list="blog" aria-pressed="false">Blog-Ideen <span class="n" id="nBlog">0</span></button>
        </div>
        <div>
          <button class="btn plain" type="button" id="copyList">Kopieren</button>
          <button class="btn" type="button" id="addBtn">+ Link</button>
        </div>
      </div>
      <form class="card form" id="addForm" hidden>
        <input type="url" id="addUrl" placeholder="Link zu einem Artikel von anderswo" required>
        <input type="text" id="addTitle" placeholder="Titel (optional)">
        <select id="addTopic"><option value="">Thema (optional)</option>{% for t in topics %}<option>{{ t }}</option>{% endfor %}</select>
        <div><button class="btn" type="submit">Ablegen</button> <button class="link" type="button" id="addCancel">Abbrechen</button></div>
      </form>
    </section>

    <div id="feed">
    {% for item in items %}
    <article class="card post" data-id="{{ item.id }}" data-cat="{{ item.category }}" data-source="{{ item.source }}"
      data-domain="{{ item.domain }}" data-seen="{{ item.first_seen }}" data-published="{{ item.published }}"
      data-topics="{{ item.topics|join('|') }}" data-weight="{{ item.weight }}" data-study="{{ 1 if item.study else 0 }}"
      data-text="{{ (item.title ~ ' ' ~ item.snippet ~ ' ' ~ item.source ~ ' ' ~ item.topics|join(' '))|lower }}">
      <header class="post-head">
        <span class="avatar" aria-hidden="true">{{ item.source[:2]|upper }}<img src="https://www.google.com/s2/favicons?domain={{ item.domain }}&amp;sz=128" alt="" loading="lazy" onerror="this.remove()"></span>
        <div class="who">
          <button class="src" type="button" title="Nur diese Quelle zeigen">{{ item.source }}</button>
          <span class="sub"><time datetime="{{ item.published }}">{{ item.published[8:10] }}.{{ item.published[5:7] }}.{{ item.published[0:4] }}</time></span>
        </div>
        {% if item.study %}<span class="badge">Studie</span>{% endif %}
      </header>
      <div class="post-body">
        <h2><a href="{{ item.link }}" target="_blank" rel="noopener nofollow external">{{ item.title }}</a></h2>
        {% if item.snippet %}<p>{{ item.snippet }}</p>{% endif %}
      </div>
      {% if item.topics %}<div class="post-body tags-wrap"><div class="tags">{% for t in item.topics %}<button class="tag" type="button" data-topic="{{ t }}">{{ t }}</button>{% endfor %}</div></div>{% endif %}
      {% if item.image %}
      <a class="post-img" href="{{ item.link }}" target="_blank" rel="noopener nofollow external" tabindex="-1" aria-hidden="true">
        <img src="{{ item.image }}" alt="" loading="lazy" decoding="async" onerror="this.parentNode.remove()">
      </a>
      {% endif %}
      <div class="actions">
        <button class="act-favs" type="button" data-act="favs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4V3z"/></svg><span class="lbl">Merken</span></button>
        <button class="act-blog" type="button" data-act="blog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4L16.5 3.5z"/></svg><span class="lbl">Blog-Idee</span></button>
        <button class="more" type="button" data-act="menu" aria-label="Weitere Aktionen"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg></button>
      </div>
    </article>
    {% endfor %}
    </div>
    <div id="listFeed" hidden></div>
    <p class="empty" id="empty" hidden></p>

    {# ---------- Einstellungen ---------- #}
    <section id="admin" hidden>
      {# Quellen: Zeile mit Bewertung, Tippen öffnet Details und Aktionen #}
      <h3 class="group-title">Quellen <span class="n">{{ stats|length }}</span></h3>
      <div class="card group">
        {% for s in stats %}
        <details class="row" data-source="{{ s.name }}">
          <summary>
            <img class="fav" src="https://www.google.com/s2/favicons?domain={{ s.domain }}&amp;sz=64" alt="" loading="lazy" onerror="this.style.visibility='hidden'">
            <div class="row-main"><b>{{ s.name }}</b><span>{{ s.category }} · {{ s.count }} {{ "Beitrag" if s.count == 1 else "Beiträge" }}<span class="muted-flag" hidden> · stumm</span></span></div>
            <div class="votes">
              <button class="vote" type="button" data-vote="-1" aria-pressed="false" aria-label="Weniger von {{ s.name }}" title="Weniger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 14V3h4v11h-4zm0 0-4 8a3 3 0 0 1-3-3v-4H4.5a2 2 0 0 1-2-2.3l1.4-8A2 2 0 0 1 5.9 3H17"/></svg></button>
              <button class="vote" type="button" data-vote="1" aria-pressed="false" aria-label="Mehr von {{ s.name }}" title="Mehr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v11H3V10h4zm0 0 4-8a3 3 0 0 1 3 3v4h5.5a2 2 0 0 1 2 2.3l-1.4 8A2 2 0 0 1 18.1 21H7"/></svg></button>
            </div>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
          </summary>
          <div class="row-body">
            <div class="facts">
              <div><span>Themen-Treffer</span><b>{{ s.topic_share ~ " %" if s.topic_share is not none else "–" }}</b></div>
              <div><span>Letzter Beitrag</span><b>{% if s.latest %}{{ s.latest[8:10] }}.{{ s.latest[5:7] }}.{% else %}–{% endif %}</b></div>
              <div><span>Gemerkt</span><b class="c-saved">0</b></div>
              <div><span>Feed</span><b>{{ s.host }}</b></div>
            </div>
            <div class="row-actions">
              <button class="btn plain" type="button" data-mute="{{ s.name }}">Stummschalten</button>
              <button class="btn plain danger" type="button" data-issue="Quelle entfernen: {{ s.name }}" data-body="name: {{ s.name }}" data-confirm="{{ s.name }} entfernen?">Quelle entfernen</button>
            </div>
          </div>
        </details>
        {% endfor %}
        <details class="row" id="addSource">
          <summary><span class="plus">+</span><div class="row-main"><b>Quelle aufnehmen</b><span>Seite, Blog oder Feed</span></div><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></summary>
          <div class="row-body">
            <form class="form flat" id="sourceForm">
              <input type="url" id="srcUrl" placeholder="https://…" required>
              <div class="row2">
                <select id="srcCat" aria-label="Kategorie">{% for c in categories %}<option{% if c == "News" %} selected{% endif %}>{{ c }}</option>{% endfor %}</select>
                <input type="text" id="srcName" placeholder="Name (optional)">
              </div>
              <button class="btn" type="submit">Auf GitHub aufnehmen</button>
            </form>
          </div>
        </details>
      </div>
      <p class="group-note">Daumen hoch rückt eine Quelle im Feed nach oben, Daumen runter nach unten. Stummgeschaltete Quellen
        erscheinen gar nicht. Gespeichert in diesem Browser. Aufnehmen und Entfernen öffnen einen Auftrag auf GitHub («Create» klicken),
        nach etwa 3 Minuten ist die Änderung da.</p>

      {# Regeln für alle Quellen #}
      <h3 class="group-title">Regeln für alle Quellen</h3>
      <form class="card group" id="rulesForm">
        <label class="setting"><span>Titel mindestens</span><span class="ctl"><input type="number" id="ruleWords" min="0" max="30" value="{{ rules.min_woerter or 0 }}"> Wörter</span></label>
        <label class="setting"><span>Nur Beiträge mit Thema</span>
          <select id="ruleWeight">
            {% for v, label in [(0, "aus"), (1, "irgendein Thema"), (2, "ab «wichtig»"), (3, "nur «sehr wichtig»")] %}
            <option value="{{ v }}"{% if (rules.mindest_gewicht or 0) == v %} selected{% endif %}>{{ label }}</option>{% endfor %}
          </select></label>
        <label class="setting"><span>Stellenanzeigen ausblenden</span><input class="switch" type="checkbox" id="ruleJobs"{% if rules.stellenanzeigen_ausblenden is not sameas false %} checked{% endif %}></label>
        <div class="setting stack"><span>Begriffe im Titel ausschliessen</span>
          <textarea id="ruleExclude" rows="1" placeholder="z.B. webinar, podcast">{{ (rules.ausschliessen or [])|join(', ') }}</textarea></div>
        <div class="setting end"><button class="btn" type="submit">Regeln speichern</button></div>
      </form>
      <p class="group-note">Gelten für jede Quelle gleich. Liefert eine Quelle damit nichts Brauchbares, besser entfernen statt eine Ausnahme machen.</p>

      {# Themen: Tippen öffnet die Bearbeitung #}
      <h3 class="group-title">Themen</h3>
      <div class="card group">
        {% for t in topic_defs %}
        <details class="row">
          <summary>
            <span class="dot w{{ t.gewicht or 1 }}"></span>
            <div class="row-main"><b>{{ t.name }}</b><span>{{ ["", "normal", "wichtig", "sehr wichtig"][t.gewicht or 1] }} · {{ topic_counts[t.name] }} {{ "Beitrag" if topic_counts[t.name] == 1 else "Beiträge" }}</span></div>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
          </summary>
          <div class="row-body">
            <form class="form flat topic-form" data-name="{{ t.name }}">
              <select name="gewicht" aria-label="Gewicht">{% for v, label in [(1, "normal"), (2, "wichtig"), (3, "sehr wichtig")] %}<option value="{{ v }}"{% if (t.gewicht or 1) == v %} selected{% endif %}>{{ label }}</option>{% endfor %}</select>
              <textarea name="stichwoerter" rows="2" aria-label="Stichwörter">{{ t.stichwoerter|join(", ") }}</textarea>
              <div class="row-actions">
                <button class="btn" type="submit">Speichern</button>
                <button class="btn plain danger" type="button" data-issue="Thema: {{ t.name }}" data-body="name: {{ t.name }}&#10;entfernen: ja" data-confirm="Thema {{ t.name }} entfernen?">Entfernen</button>
              </div>
            </form>
          </div>
        </details>
        {% endfor %}
        <details class="row">
          <summary><span class="plus">+</span><div class="row-main"><b>Thema hinzufügen</b><span>Name, Gewicht, Stichwörter</span></div><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></summary>
          <div class="row-body">
            <form class="form flat topic-form" data-name="">
              <input type="text" name="name" placeholder="Name, z.B. YouTube" required>
              <select name="gewicht" aria-label="Gewicht"><option value="1">normal</option><option value="2">wichtig</option><option value="3">sehr wichtig</option></select>
              <textarea name="stichwoerter" rows="2" placeholder="Stichwörter mit Komma, z.B. youtube, video ads, ctv" required></textarea>
              <button class="btn" type="submit">Thema anlegen</button>
            </form>
          </div>
        </details>
      </div>
      <p class="group-note">Ein Beitrag erhält ein Thema, wenn eines der Stichwörter in Titel oder Anriss steht. Leerzeichen um ein
        Stichwort verhindern Teiltreffer (« ki » trifft nicht «Kiosk»).</p>

      {# Suchbegriffe #}
      <h3 class="group-title">Suchbegriffe für Vorschläge</h3>
      <div class="card group">
        {% for b in search_defs %}
        <div class="row line"><div class="row-main"><b>{{ b }}</b></div>
          <button class="x" type="button" data-issue="Suchbegriff: {{ b }}" data-body="begriff: {{ b }}&#10;entfernen: ja" data-confirm="Suchbegriff {{ b }} entfernen?" aria-label="Entfernen">✕</button></div>
        {% endfor %}
        <form class="row line" id="searchForm">
          <input type="text" id="searchTerm" placeholder='Neuer Begriff, z.B. "Consent Mode" Google' required>
          <button class="btn" type="submit">Hinzufügen</button>
        </form>
      </div>
      <p class="group-note">Gesucht wird in Google News in den Ausgaben USA, Grossbritannien, Irland, Deutschland, Österreich und Schweiz.
        «…» sucht die genaue Phrase, OR verbindet Alternativen.</p>

      {% if unknown %}
      <h3 class="group-title">Vorschläge für neue Quellen</h3>
      <div class="card group">
        {% for u in unknown[:25] %}
        <details class="row">
          <summary>
            <img class="fav" src="https://www.google.com/s2/favicons?domain={{ u.domain }}&amp;sz=64" alt="" loading="lazy" onerror="this.style.visibility='hidden'">
            <div class="row-main"><b>{{ u.domain }}</b><span>{{ u.count }} Treffer · zuletzt {{ u.latest[8:10] }}.{{ u.latest[5:7] }}.</span></div>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
          </summary>
          <div class="row-body">
            <ul class="hits">{% for a in u.articles %}<li><a href="{{ a.link }}" target="_blank" rel="noopener nofollow external">{{ a.title }}</a></li>{% endfor %}</ul>
            <div class="row-actions"><button class="btn plain" type="button" data-suggest="https://{{ u.domain }}">Als Quelle aufnehmen</button></div>
          </div>
        </details>
        {% endfor %}
      </div>
      {% endif %}

      <h3 class="group-title">Darstellung</h3>
      <div class="card group"><div class="setting"><span>Farbschema</span>
        <div class="seg" id="themeSeg"><button type="button" data-theme="" aria-pressed="true">Auto</button><button type="button" data-theme="light" aria-pressed="false">Hell</button><button type="button" data-theme="dark" aria-pressed="false">Dunkel</button></div></div></div>

      <h3 class="group-title">Letzter Lauf</h3>
      <div class="card group">
        <div class="setting"><span>Stand</span><span class="n"><time id="generated" datetime="{{ generated }}">{{ generated[:16]|replace("T", " ") }} UTC</time></span></div>
        <div class="setting"><span>Briefing</span><span class="n">{% if briefing.by == "ki" %}von der KI{% else %}automatisch{% endif %}</span></div>
        {% if briefing.by != "ki" and briefing.note %}<div class="setting stack"><span class="n">KI nicht verfügbar: {{ briefing.note }}</span></div>{% endif %}
        {% for e in errors %}<div class="setting stack"><span>{{ e.source }}</span><span class="n">{{ e.error }}</span></div>{% endfor %}
        {% if repo %}<div class="setting end"><a class="btn plain" href="https://github.com/{{ repo }}/actions/workflows/build.yml" target="_blank" rel="noopener nofollow external">Jetzt aktualisieren</a></div>{% endif %}
      </div>
      <p class="group-note">Läuft automatisch alle 3 Stunden. «Jetzt aktualisieren» öffnet GitHub, dort «Run workflow».</p>
    </section>

    <footer>Inhalte gehören den jeweiligen Quellen.</footer>
  </main>
  </div>
</div>

<nav class="tabbar" aria-label="Bereiche">
  <div class="in">
    {% for key, label, icon in tabs %}
    <button type="button" data-tab="{{ key }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ icon }}{{ label }}</button>
    {% endfor %}
    <button type="button" data-tab="settings" aria-selected="false">{{ ico_gear }}Einstellungen</button>
  </div>
</nav>

<div class="ptr" id="ptr" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><path d="M20 4v5h-5"/></svg></div>
<div class="toast" id="toast" hidden><span id="toastText"></span><button type="button" id="toastUndo">Rückgängig</button></div>

<script>
(function () {
  var REPO = "{{ repo }}";
  var store = {
    get: function (k, d) { try { var v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
    set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  };
  var $ = function (id) { return document.getElementById(id); };
  var $$ = function (sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); };
  var DAY = 864e5, BOOST = 2 * DAY, WEIGHT_SHIFT = DAY / 4;

  // Farbschema
  var root = document.documentElement, theme = store.get("psn-theme", "");
  function applyTheme() {
    if (theme) root.setAttribute("data-theme", theme); else root.removeAttribute("data-theme");
    $$("#themeSeg button").forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.theme === theme ? "true" : "false"); });
  }
  applyTheme();
  $$("#themeSeg button").forEach(function (b) {
    b.addEventListener("click", function () { theme = b.dataset.theme; store.set("psn-theme", theme); applyTheme(); });
  });

  // Datumsangaben
  var dateFmt = new Intl.DateTimeFormat("de-CH", { day: "numeric", month: "long" });
  var dayFmt = new Intl.DateTimeFormat("de-CH", { weekday: "long", day: "numeric", month: "long" });
  function fmt(iso) {
    var d = new Date(iso), h = (Date.now() - d) / 36e5;
    if (h < 1) return "Gerade eben";
    if (h < 24) return "Vor " + Math.floor(h) + " Std.";
    if (h < 48) return "Gestern";
    return dateFmt.format(d);
  }
  $$(".post time").forEach(function (t) { t.textContent = fmt(t.dateTime); });
  $$("time.day").forEach(function (t) { t.textContent = dayFmt.format(new Date(t.dateTime + "T12:00:00")); });
  $("generated").textContent = new Intl.DateTimeFormat("de-CH", { dateStyle: "medium", timeStyle: "short" }).format(new Date($("generated").dateTime));

  function hue(s) { var h = 0; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return h; }
  function paintAvatar(post) { post.querySelector(".avatar").style.setProperty("--h", hue(post.dataset.source)); }

  var feed = $("feed"), listFeed = $("listFeed");
  var posts = Array.prototype.slice.call(feed.querySelectorAll(".post"));
  posts.forEach(paintAvatar);
  var seenLine = document.createElement("div");
  seenLine.className = "seen-line"; seenLine.textContent = "Bis hier gelesen";

  // Was seit dem letzten Besuch neu ist, steht oben; darunter die Linie "Bis hier gelesen"
  var lastVisit = store.get("psn-last-visit", null);
  store.set("psn-last-visit", new Date().toISOString());
  function isNew(p) { return !!lastVisit && p.dataset.seen > lastVisit; }

  // Im Browser gespeichert: Bewertung je Quelle (1 = mehr, -1 = weniger, -2 = stumm), Gemerkt, Blog-Ideen
  var MUTED = -2;
  var votes = store.get("psn-votes", {});
  if (store.get("psn-votes-version", 1) < 2) {  // früher bedeutete -1 «stumm»
    Object.keys(votes).forEach(function (k) { if (votes[k] < 0) votes[k] = MUTED; });
    store.set("psn-votes", votes); store.set("psn-votes-version", 2);
  }
  function setVote(src, value) {
    if (value) votes[src] = value; else delete votes[src];
    store.set("psn-votes", votes); render();
  }
  var lists = { favs: store.get("psn-favs", {}), blog: store.get("psn-blog", {}) };

  function snapshot(post) {
    var a = post.querySelector("h2 a"), p = post.querySelector(".post-body p"), img = post.querySelector(".post-img img");
    return { id: post.dataset.id, title: a.textContent, link: a.href, source: post.dataset.source, domain: post.dataset.domain,
      category: post.dataset.cat, published: post.dataset.published, snippet: p ? p.textContent : "",
      image: img ? img.src : null, topics: post.dataset.topics, saved: new Date().toISOString() };
  }

  var state = { tab: "feed", list: "favs", admin: false, topic: "", source: "", q: "" };
  var TABS = {
    feed: function (p) { return p.dataset.cat !== "Community"; },
    studies: function (p) { return p.dataset.study === "1"; },
    community: function (p) { return p.dataset.cat === "Community"; }
  };
  var EMPTY = {
    feed: "Keine Beiträge für diese Auswahl.", studies: "Keine Studien für diese Auswahl.", community: "Keine Community-Beiträge für diese Auswahl.",
    favs: "Noch nichts gemerkt. Über «Merken» bei einem Beitrag oder «+ Link» landet es hier.",
    blog: "Noch keine Blog-Ideen. Über «Blog-Idee» bei einem Beitrag oder «+ Link» landet es hier."
  };

  function score(p) {
    var v = votes[p.dataset.source] || 0;
    return new Date(p.dataset.published).getTime() + (v === 1 ? BOOST : v === -1 ? -BOOST : 0) + (+p.dataset.weight || 0) * WEIGHT_SHIFT;
  }
  function matches(p) {
    var terms = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    return TABS[state.tab](p) && votes[p.dataset.source] !== MUTED
      && (!state.topic || p.dataset.topics.split("|").indexOf(state.topic) !== -1)
      && (!state.source || p.dataset.source === state.source)
      && terms.every(function (t) { return p.dataset.text.indexOf(t) !== -1; });
  }
  function decorate(p) {
    p.classList.toggle("is-fav", !!lists.favs[p.dataset.id]);
    p.classList.toggle("is-blog", !!lists.blog[p.dataset.id]);
  }

  function buildSavedPost(f) {
    var live = feed.querySelector('.post[data-id="' + CSS.escape(f.id) + '"]');
    if (live) { var c = live.cloneNode(true); c.hidden = false; return c; }
    // Nicht (mehr) im Feed: aus dem gespeicherten Stand aufbauen
    var tpl = posts[0].cloneNode(true);
    tpl.hidden = false;
    Object.assign(tpl.dataset, { id: f.id, source: f.source, cat: f.category, published: f.published, topics: f.topics || "", domain: f.domain || "" });
    var av = tpl.querySelector(".avatar"), favicon = av.querySelector("img");
    av.firstChild.textContent = f.source.slice(0, 2).toUpperCase();
    if (favicon) { if (f.domain) favicon.src = "https://www.google.com/s2/favicons?domain=" + encodeURIComponent(f.domain) + "&sz=128"; else favicon.remove(); }
    tpl.querySelector(".src").textContent = f.source;
    tpl.querySelector(".sub").textContent = f.category === "Abgelegt" ? "Selbst abgelegt" : fmt(f.published);
    var a = tpl.querySelector("h2 a"); a.textContent = f.title; a.href = f.link;
    var p = tpl.querySelector(".post-body p"); if (p) { p.textContent = f.snippet || ""; p.hidden = !f.snippet; }
    ["tags-wrap", "badge", "post-img"].forEach(function (cls) { var el = tpl.querySelector("." + cls); if (el) el.remove(); });
    if (f.topics) {
      var wrap = document.createElement("div"), box = document.createElement("div");
      wrap.className = "post-body tags-wrap"; box.className = "tags";
      f.topics.split("|").forEach(function (t) {
        var b = document.createElement("button"); b.className = "tag"; b.type = "button"; b.dataset.topic = t; b.textContent = t; box.appendChild(b);
      });
      wrap.appendChild(box); tpl.querySelector(".actions").before(wrap);
    }
    return tpl;
  }

  function renderAdmin() {
    $$("#admin details[data-source]").forEach(function (row) {
      var name = row.dataset.source, v = votes[name] || 0;
      row.querySelectorAll(".vote").forEach(function (b) { b.setAttribute("aria-pressed", +b.dataset.vote === v ? "true" : "false"); });
      row.classList.toggle("is-muted", v === MUTED);
      row.querySelector(".muted-flag").hidden = v !== MUTED;
      row.querySelector("[data-mute]").textContent = v === MUTED ? "Wieder anzeigen" : "Stummschalten";
      row.querySelector(".c-saved").textContent = ["favs", "blog"].reduce(function (sum, l) {
        return sum + Object.keys(lists[l]).filter(function (id) { return lists[l][id].source === name; }).length;
      }, 0);
    });
  }

  function render() {
    var tab = state.tab, saved = tab === "saved", shown = 0, admin = state.admin;
    var filtered = !!(state.topic || state.source || state.q);
    var nFavs = Object.keys(lists.favs).length, nBlog = Object.keys(lists.blog).length;
    $("nFavs").textContent = nFavs; $("nBlog").textContent = nBlog;
    $("nSavedSide").textContent = nFavs + nBlog || "";
    $$("[data-tab]").forEach(function (b) {
      b.setAttribute("aria-selected", (admin ? b.dataset.tab === "settings" : b.dataset.tab === tab) ? "true" : "false");
    });
    $("briefing").hidden = admin || tab !== "feed" || filtered;
    $$(".topic-nav [data-topic]").forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.topic === state.topic ? "true" : "false"); });
    $("admin").hidden = !admin;
    $("chips").hidden = admin || saved;
    var communityBrief = $("communityBrief");
    if (communityBrief) communityBrief.hidden = admin || tab !== "community" || filtered;
    $("savedHead").hidden = admin || !saved;
    feed.hidden = admin || saved;
    listFeed.hidden = admin || !saved;
    $("activeFilter").hidden = admin || saved || !(state.topic || state.source);
    $("clearFilter").textContent = (state.source ? state.source : "#" + state.topic) + "  ✕";

    if (admin) {
      renderAdmin();
    } else if (saved) {
      listFeed.innerHTML = "";
      Object.keys(lists[state.list]).map(function (id) { return lists[state.list][id]; })
        .sort(function (a, b) { return b.saved.localeCompare(a.saved); })
        .forEach(function (f) { var p = buildSavedPost(f); paintAvatar(p); decorate(p); listFeed.appendChild(p); shown++; });
    } else {
      posts.sort(function (a, b) {
        var na = isNew(a), nb = isNew(b);
        return na !== nb ? (na ? -1 : 1) : score(b) - score(a);
      });
      var lineAfter = null;
      posts.forEach(function (p) {
        decorate(p);
        var ok = matches(p);
        p.hidden = !ok;
        if (ok) { shown++; if (isNew(p)) lineAfter = p; }
        feed.appendChild(p);
      });
      var lastShown = posts.filter(function (p) { return !p.hidden; }).pop();
      if (lineAfter && !filtered && lineAfter !== lastShown) lineAfter.after(seenLine); else seenLine.remove();
    }
    $("empty").hidden = admin || shown > 0;
    $("empty").textContent = EMPTY[saved ? state.list : tab];
  }

  function go(changes) { Object.assign(state, changes); render(); window.scrollTo(0, 0); }
  function filterTab() { return TABS[state.tab] ? state.tab : "feed"; }

  $$("[data-tab]").forEach(function (b) {
    b.addEventListener("click", function () {
      if (b.dataset.tab === "settings") go({ admin: true }); else go({ tab: b.dataset.tab, admin: false });
    });
  });
  // Zwei Suchfelder (Handy oben, Desktop in der Seitenleiste) mit demselben Zustand
  function setQuery(value) {
    $("q").value = $("qSide").value = value;
    state.q = value; state.admin = false; state.tab = filterTab(); render();
  }
  ["q", "qSide"].forEach(function (id) { $(id).addEventListener("input", function (e) { setQuery(e.target.value); }); });
  $("qSide").addEventListener("keydown", function (e) { if (e.key === "Escape") { setQuery(""); e.target.blur(); } });
  // Lupe klappt das Suchfeld auf; Abbrechen oder Esc schliesst es und hebt die Suche auf, "/" öffnet es
  function openSearch() { $("top").classList.add("searching"); $("q").focus(); }
  function closeSearch() {
    $("top").classList.remove("searching");
    if (state.q) setQuery("");
  }
  $("searchBtn").addEventListener("click", openSearch);
  $("searchCancel").addEventListener("click", closeSearch);
  $("q").addEventListener("keydown", function (e) { if (e.key === "Escape") closeSearch(); });
  document.addEventListener("keydown", function (e) {
    if (e.key === "/" && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) {
      e.preventDefault();
      if (window.matchMedia("(max-width: 900px)").matches) openSearch(); else $("qSide").focus();
    }
  });
  // Kopf wird beim Scrollen kompakter und bekommt eine feine Linie
  var top = $("top");
  window.addEventListener("scroll", function () { top.classList.toggle("scrolled", window.scrollY > 8); }, { passive: true });
  $("clearFilter").addEventListener("click", function () { go({ topic: "", source: "" }); });
  $$("#seg button").forEach(function (b) {
    b.addEventListener("click", function () {
      $$("#seg button").forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      go({ list: b.dataset.list });
    });
  });

  // Hinweis unten mit "Rückgängig"
  var toastTimer, undoFn;
  function toast(text, undo) {
    $("toastText").textContent = text; undoFn = undo; $("toastUndo").hidden = !undo; $("toast").hidden = false;
    clearTimeout(toastTimer); toastTimer = setTimeout(function () { $("toast").hidden = true; }, 4000);
  }
  $("toastUndo").addEventListener("click", function () { if (undoFn) undoFn(); $("toast").hidden = true; });

  function closeMenus() { $$(".menu").forEach(function (m) { m.remove(); }); }
  function openMenu(post, anchor) {
    closeMenus();
    var src = post.dataset.source, menu = document.createElement("div");
    menu.className = "menu";
    [[1, "Mehr von " + src, "Mehr von " + src + " – aufheben", src + " erscheint weiter oben"],
     [-1, "Weniger von " + src, "Weniger von " + src + " – aufheben", src + " erscheint weiter unten"],
     [MUTED, src + " stummschalten", null, src + " stummgeschaltet"]].forEach(function (opt) {
      var b = document.createElement("button");
      b.type = "button";
      b.textContent = votes[src] === opt[0] && opt[2] ? opt[2] : opt[1];
      b.addEventListener("click", function () {
        var before = votes[src] || 0, next = before === opt[0] ? 0 : opt[0];
        closeMenus(); setVote(src, next);
        toast(next ? opt[3] : "Zurückgesetzt", function () { setVote(src, before); });
      });
      menu.appendChild(b);
    });
    anchor.parentNode.appendChild(menu);
  }

  document.addEventListener("click", function (e) {
    if (!e.target.closest(".menu") && !e.target.closest("[data-act=menu]")) closeMenus();
    var suggest = e.target.closest("[data-suggest]");
    if (suggest) { $("addSource").open = true; $("srcUrl").value = suggest.dataset.suggest; $("srcUrl").scrollIntoView({ block: "center" }); $("srcUrl").focus(); return; }
    var qBtn = e.target.closest("[data-q]");
    if (qBtn) { $("q").value = $("qSide").value = qBtn.dataset.q; $("top").classList.add("searching"); go({ q: qBtn.dataset.q, topic: "", source: "", tab: "feed", admin: false }); return; }
    var topicBtn = e.target.closest("[data-topic]");
    if (topicBtn) { go({ topic: topicBtn.dataset.topic, source: "", tab: filterTab(), admin: false }); return; }
    var srcBtn = e.target.closest(".src");
    if (srcBtn) { go({ source: srcBtn.closest(".post").dataset.source, topic: "", tab: filterTab() }); return; }
    var btn = e.target.closest("[data-act]");
    if (!btn) return;
    var post = btn.closest(".post"), act = btn.dataset.act;
    if (act === "menu") { openMenu(post, btn); return; }
    var list = lists[act], id = post.dataset.id, adding = !list[id];
    if (adding) list[id] = snapshot(post); else delete list[id];
    store.set("psn-" + act, list);
    render();
    toast(adding ? (act === "favs" ? "Gemerkt" : "Als Blog-Idee gemerkt") : "Entfernt");
  });

  // Links von anderswo ablegen
  $("addBtn").addEventListener("click", function () { $("addForm").hidden = false; $("addUrl").focus(); });
  $("addCancel").addEventListener("click", function () { $("addForm").reset(); $("addForm").hidden = true; });
  $("addForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var url = $("addUrl").value.trim(), host;
    try { host = new URL(url).hostname.replace(/^www\./, ""); } catch (err) { return; }
    var now = new Date().toISOString();
    lists[state.list]["manual:" + url] = { id: "manual:" + url, link: url, source: host, domain: host, category: "Abgelegt",
      title: $("addTitle").value.trim() || url.replace(/^https?:\/\/(www\.)?/, "").slice(0, 120),
      published: now, snippet: "", image: null, topics: $("addTopic").value, saved: now };
    store.set("psn-" + state.list, lists[state.list]);
    $("addForm").reset(); $("addForm").hidden = true;
    render(); toast("Abgelegt");
  });
  $("copyList").addEventListener("click", function () {
    var list = lists[state.list];
    var text = Object.keys(list).map(function (id) { var f = list[id]; return "- " + f.title + " (" + f.source + ")\n  " + f.link; }).join("\n");
    if (!text) { toast("Liste ist leer"); return; }
    navigator.clipboard.writeText(text).then(function () { toast("Liste kopiert"); });
  });

  // Änderungen an Quellen, Themen und Suchbegriffen: vorbereiteten Auftrag (Issue) auf GitHub öffnen;
  // die Action settings.yml übernimmt ihn in sources.yaml und baut die Seite neu
  function openIssue(title, body) {
    if (!REPO) { toast("Repository unbekannt"); return; }
    body += "\n\n(Wird automatisch von der Action «Einstellungen übernehmen» verarbeitet.)";
    window.open("https://github.com/" + REPO + "/issues/new?title=" + encodeURIComponent(title) + "&body=" + encodeURIComponent(body), "_blank", "noopener");
    toast("Auf GitHub «Create» klicken – nach etwa 3 Minuten ist es übernommen");
  }
  $("sourceForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var url = $("srcUrl").value.trim();
    openIssue("Quelle: " + url, "url: " + url + "\nkategorie: " + $("srcCat").value + "\nname: " + $("srcName").value.trim());
    $("sourceForm").reset();
  });
  // Jedes Thema hat sein eigenes Formular; das leere Formular legt ein neues Thema an
  $$(".topic-form").forEach(function (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var name = form.dataset.name || form.elements.name.value.trim();
      openIssue("Thema: " + name, "name: " + name + "\ngewicht: " + form.elements.gewicht.value + "\nstichwoerter: " + form.elements.stichwoerter.value.trim());
    });
  });
  // Textfelder wachsen mit dem Inhalt (Rückfall für Browser ohne field-sizing)
  function autosize(el) { el.style.height = "auto"; el.style.height = el.scrollHeight + 2 + "px"; }
  $$("#admin textarea").forEach(function (t) { t.addEventListener("input", function () { autosize(t); }); });
  $$("#admin details").forEach(function (d) {
    d.addEventListener("toggle", function () { if (d.open) d.querySelectorAll("textarea").forEach(autosize); });
  });
  $("rulesForm").addEventListener("submit", function (e) {
    e.preventDefault();
    openIssue("Regeln: für alle Quellen", "min_woerter: " + $("ruleWords").value + "\nmindest_gewicht: " + $("ruleWeight").value
      + "\nstellenanzeigen_ausblenden: " + ($("ruleJobs").checked ? "ja" : "nein") + "\nausschliessen: " + $("ruleExclude").value.trim());
  });
  $("searchForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var term = $("searchTerm").value.trim();
    openIssue("Suchbegriff: " + term, "begriff: " + term);
    $("searchForm").reset();
  });
  document.querySelector("#admin").addEventListener("click", function (e) {
    var issue = e.target.closest("[data-issue]");
    if (issue && confirm(issue.dataset.confirm)) openIssue(issue.dataset.issue, issue.dataset.body);
    // Daumen in der Quellen-Zeile: ohne die Zeile auf- oder zuzuklappen
    var vote = e.target.closest(".vote");
    if (vote) {
      e.preventDefault();
      var src = vote.closest("[data-source]").dataset.source, v = +vote.dataset.vote;
      setVote(src, votes[src] === v ? 0 : v);
      toast(votes[src] === 1 ? src + ": mehr davon" : votes[src] === -1 ? src + ": weniger davon" : src + ": zurückgesetzt");
    }
    var mute = e.target.closest("[data-mute]");
    if (mute) {
      var name = mute.dataset.mute;
      setVote(name, votes[name] === MUTED ? 0 : MUTED);
      toast(votes[name] === MUTED ? name + " stummgeschaltet" : name + " wieder sichtbar");
    }
  });

  // Nach unten ziehen zum Neuladen: nur in der App vom Home-Bildschirm (dort fehlt es); ?ptr=1 zum Testen
  (function () {
    var standalone = window.matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
    if (!standalone && !/[?&]ptr=1/.test(location.search)) return;
    var ptr = $("ptr"), icon = ptr.querySelector("svg"), startY = null, pull = 0, TRIGGER = 70, MAX = 110;
    function place(offset, animate) {
      ptr.style.transition = animate ? "" : "none";
      ptr.style.transform = "translateY(" + (offset - 70) + "px)";
      ptr.style.opacity = Math.min(offset / TRIGGER, 1);
    }
    document.addEventListener("touchstart", function (e) {
      startY = window.scrollY <= 0 && !root.classList.contains("locked") ? e.touches[0].clientY : null;
      pull = 0;
    }, { passive: true });
    document.addEventListener("touchmove", function (e) {
      if (startY === null) return;
      pull = Math.min(Math.max(0, e.touches[0].clientY - startY) * 0.5, MAX);
      place(pull, false);
      icon.style.transform = "rotate(" + pull * 3 + "deg)";
      ptr.classList.toggle("ready", pull >= TRIGGER);
    }, { passive: true });
    document.addEventListener("touchend", function () {
      if (startY === null) return;
      startY = null;
      if (pull >= TRIGGER) {
        place(TRIGGER, true);
        icon.style.transform = "";
        ptr.classList.add("loading");
        setTimeout(function () { location.reload(); }, 250);
      } else {
        place(0, true);
        ptr.classList.remove("ready");
      }
    });
  })();

  render();
})();
</script>
</body>
</html>
