<!doctype html>
<html lang="de-CH">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#242526" media="(prefers-color-scheme: dark)">
<title>Radar</title>
<meta name="description" content="Newsradar für Paid Search: Neuigkeiten, Studien und Trends aus ausgewählten Quellen.">
<link rel="icon" href="logo.svg" type="image/svg+xml">
<link rel="icon" href="favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="manifest" href="site.webmanifest">
<meta name="apple-mobile-web-app-title" content="Radar">
<meta property="og:type" content="website">
<meta property="og:title" content="Radar">
<meta property="og:description" content="Newsradar für Paid Search">
{% if site_url %}<meta property="og:url" content="{{ site_url }}">
<meta property="og:image" content="{{ site_url }}og.png">{% endif %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% if password_hash %}
<script>
  // Passwort-Sperre: blendet die Seite aus, bis das Passwort einmal eingegeben wurde
  try { if (localStorage.getItem("psn-auth") !== "{{ password_hash }}") document.documentElement.classList.add("locked"); }
  catch (e) { document.documentElement.classList.add("locked"); }
</script>
{% endif %}
<style>
/* Farben und Flächen angelehnt an Facebook (Meta): hellgrauer Grund, weisse Karten, Meta-Blau */
:root {
  --bg: #f0f2f5; --card: #ffffff; --text: #080809; --label2: #65686c; --label3: #8a8d91;
  --fill: #e4e6eb; --hover: #f2f2f2; --sep: #e4e6eb; --accent: #0866ff; --accent-soft: #ebf5ff;
  --green: #31a24c; --orange: #f7923b; --purple: #9360f7; --red: #e41e3f; --teal: #1ba9a0;
  --shadow: 0 1px 2px rgba(0,0,0,.12); --shadow-lg: 0 12px 28px rgba(0,0,0,.18), 0 2px 4px rgba(0,0,0,.1);
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #18191a; --card: #242526; --text: #e4e6eb; --label2: #b0b3b8; --label3: #8a8d91;
    --fill: #3a3b3c; --hover: #3a3b3c; --sep: #3e4042; --accent: #2d88ff; --accent-soft: #263951;
    --shadow: 0 1px 2px rgba(0,0,0,.3); --shadow-lg: 0 12px 28px rgba(0,0,0,.45);
  }
}
:root[data-theme="dark"] {
  --bg: #18191a; --card: #242526; --text: #e4e6eb; --label2: #b0b3b8; --label3: #8a8d91;
  --fill: #3a3b3c; --hover: #3a3b3c; --sep: #3e4042; --accent: #2d88ff; --accent-soft: #263951;
  --shadow: 0 1px 2px rgba(0,0,0,.3); --shadow-lg: 0 12px 28px rgba(0,0,0,.45); color-scheme: dark;
}
:root[data-theme="light"] { color-scheme: light; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.45 Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-feature-settings: "cv11", "ss01"; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%; }
button, input, select { font: inherit; color: inherit; }
a { color: var(--accent); }
svg { flex: none; }

/* Kopfzeile: Logo links, Suche in der Mitte, Zahnrad rechts */
.navbar { position: sticky; top: 0; z-index: 20; height: 56px; background: var(--card); box-shadow: var(--shadow);
  display: grid; grid-template-columns: 1fr minmax(0, 600px) 1fr; align-items: center; gap: 16px; padding: 0 16px; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); justify-self: start; }
.brand img { width: 40px; height: 40px; border-radius: 10px; }
.brand b { font-weight: 800; font-size: 1.25rem; letter-spacing: -.03em; }
.search { position: relative; width: 100%; }
.search svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 17px; height: 17px; color: var(--label2); }
.search input { width: 100%; height: 40px; background: var(--bg); border: 0; border-radius: 999px; padding: 0 16px 0 40px; font-size: 16px; }
.search input::placeholder { color: var(--label2); }
.search input:focus { outline: 2px solid var(--accent); }
.round { justify-self: end; width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--fill); display: grid; place-items: center; cursor: pointer; }
.round:hover { filter: brightness(.95); }
.round[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent); }
.round svg { width: 20px; height: 20px; }

/* Raster: links Navigation, Mitte Feed, rechts Briefing */
.shell { display: grid; grid-template-columns: 300px minmax(0, 600px) 340px; grid-template-areas: "left head right" "left main right";
  grid-template-rows: auto 1fr; column-gap: 32px; justify-content: space-between; max-width: 1400px; margin: 0 auto; padding: 0 16px; }
.left { grid-area: left; position: sticky; top: 56px; align-self: start; max-height: calc(100vh - 56px); overflow: auto; padding: 16px 0 32px; scrollbar-width: none; }
.right { grid-area: right; position: sticky; top: 56px; align-self: start; max-height: calc(100vh - 56px); overflow: auto; padding: 20px 0 32px; scrollbar-width: none; }
.head { grid-area: head; padding: 20px 0 0; }
main { grid-area: main; min-width: 0; padding-bottom: 60px; }

.nav button { display: flex; align-items: center; gap: 12px; width: 100%; background: none; border: 0; border-radius: 8px;
  padding: 8px; cursor: pointer; font-size: .95rem; font-weight: 500; text-align: left; }
.nav button:hover { background: var(--hover); }
.nav button[aria-selected="true"], .nav button[aria-pressed="true"] { background: var(--card); box-shadow: var(--shadow); font-weight: 600; }
.nav .ic { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: #fff; flex: none; }
.nav .ic svg { width: 20px; height: 20px; }
.ic-feed { background: var(--accent); } .ic-studies { background: var(--green); } .ic-community { background: var(--orange); } .ic-saved { background: var(--purple); }
.nav .n { margin-left: auto; color: var(--label2); font-size: .82rem; font-weight: 500; }
.nav-title { font-size: 1.05rem; font-weight: 700; color: var(--label2); margin: 18px 8px 4px; }
.nav .hash { width: 36px; height: 36px; border-radius: 8px; display: grid; place-items: center; background: var(--fill); font-weight: 700; color: var(--label2); flex: none; }
.nav .hash.w3 { background: #fde2e4; color: var(--red); } .nav .hash.w2 { background: #fdebd8; color: #c96a12; }
:root[data-theme="dark"] .nav .hash.w3 { background: #4a2a2e; } :root[data-theme="dark"] .nav .hash.w2 { background: #4a3a26; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .nav .hash.w3 { background: #4a2a2e; } :root:not([data-theme="light"]) .nav .hash.w2 { background: #4a3a26; } }

.eyebrow { font-size: .78rem; font-weight: 600; color: var(--label2); text-transform: uppercase; letter-spacing: .04em; margin: 0; }
.page-title { font-size: 1.75rem; font-weight: 800; letter-spacing: -.03em; line-height: 1.15; margin: 2px 0 14px; }

/* Themen-Chips (nur schmale Bildschirme) */
.chips { display: none; gap: 8px; overflow-x: auto; margin: 0 -16px 12px; padding: 2px 16px 4px; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex: none; border: 0; background: var(--fill); border-radius: 999px; padding: 8px 14px; cursor: pointer; font-size: .9rem; font-weight: 600; white-space: nowrap; }
.chip[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent); }
.chip .n { opacity: .7; font-weight: 500; font-size: .85em; margin-left: 4px; }

.card { background: var(--card); border-radius: 12px; box-shadow: var(--shadow); margin-bottom: 16px; }
.active-filter { display: flex; gap: 8px; align-items: center; margin: 0 0 12px; font-size: .92rem; color: var(--label2); }
.active-filter button { background: var(--accent-soft); color: var(--accent); border: 0; border-radius: 999px; padding: 6px 12px; cursor: pointer; font-weight: 600; }
.link { background: none; border: 0; padding: 0; color: var(--accent); cursor: pointer; font-size: inherit; font-weight: 600; }
.muted, .n { color: var(--label2); }

/* Briefing (rechte Spalte) */
.side-card { padding: 16px; }
.side-card h2 { font-size: 1.05rem; font-weight: 700; margin: 0; }
.side-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
.side-card .date { color: var(--label2); font-size: .82rem; display: block; margin-top: 1px; }
.b-sec { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--sep); }
.b-sec:first-child { margin-top: 12px; }
.b-sec h3 { font-size: .74rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--label2); margin: 0 0 6px; }
.b-item { display: grid; gap: 2px; padding: 8px; margin: 0 -8px; border-radius: 8px; }
.b-item:hover { background: var(--hover); }
.b-topic { justify-self: start; background: none; border: 0; padding: 0; color: var(--accent); font-weight: 700; font-size: .8rem; cursor: pointer; }
.b-title { color: var(--text); text-decoration: none; font-weight: 600; font-size: .92rem; line-height: 1.35;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.b-title:hover { text-decoration: underline; }
.b-item .n { font-size: .8rem; }
.b-item .n .link { font-size: .8rem; }
.trend-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.trend-chips .chip { font-size: .85rem; padding: 6px 12px; }

/* Beiträge */
.post { overflow: hidden; }
.post-head { display: flex; gap: 10px; align-items: center; padding: 12px 16px 8px; }
.avatar { position: relative; width: 40px; height: 40px; border-radius: 10px; flex: none; display: grid; place-items: center;
  font-weight: 700; font-size: .8rem; color: #fff; background: hsl(var(--h, 210) 55% 50%); overflow: hidden; box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }
.avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #fff; }
.who { min-width: 0; flex: 1; line-height: 1.3; }
.who .src { display: block; background: none; border: 0; padding: 0; font-weight: 600; font-size: .95rem; cursor: pointer;
  max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: left; }
.who .src:hover { text-decoration: underline; }
.who .sub { color: var(--label2); font-size: .8rem; }
.badge { border-radius: 6px; padding: 3px 8px; font-size: .74rem; font-weight: 600; background: #e7f3e8; color: #1e7a32; }
:root[data-theme="dark"] .badge { background: #26402c; color: #7fd28f; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .badge { background: #26402c; color: #7fd28f; } }
.post-body { padding: 0 16px 10px; }
.post-body h2 { font-size: 1.08rem; font-weight: 700; letter-spacing: -.01em; line-height: 1.32; margin: 0 0 4px; }
.post-body h2 a { color: inherit; text-decoration: none; }
.post-body h2 a:hover { text-decoration: underline; }
.post-body p { margin: 0; font-size: .94rem; overflow-wrap: anywhere; }
.tags { display: flex; flex-wrap: wrap; gap: 6px; }
.tag { background: none; border: 0; padding: 0; color: var(--accent); font-size: .88rem; font-weight: 600; cursor: pointer; }
.tag::before { content: "#"; }
.tag:hover { text-decoration: underline; }
.post-img { display: block; background: var(--fill); }
.post-img img { width: 100%; max-height: 380px; aspect-ratio: 1.91 / 1; object-fit: cover; display: block; }
.actions { position: relative; display: flex; gap: 4px; margin: 0 12px; padding: 4px 0; border-top: 1px solid var(--sep); }
.post-img + .actions, .tags-wrap + .actions { margin-top: 0; }
.actions > button { flex: 1; display: flex; gap: 8px; justify-content: center; align-items: center; background: none; border: 0;
  padding: 8px 4px; min-height: 40px; color: var(--label2); font-size: .92rem; font-weight: 600; cursor: pointer; border-radius: 6px; }
.actions > button.more { flex: 0 0 48px; }
.actions > button:hover { background: var(--hover); }
.actions svg { width: 20px; height: 20px; }
.post.is-fav .act-favs { color: var(--purple); }
.post.is-blog .act-blog { color: var(--teal); }
.post.is-fav .act-favs svg path, .post.is-blog .act-blog svg path { fill: currentColor; }
.menu { position: absolute; right: 0; bottom: 46px; z-index: 5; background: var(--card); border-radius: 10px; box-shadow: var(--shadow-lg); padding: 6px; min-width: 260px; }
.menu button { display: flex; gap: 10px; align-items: center; width: 100%; text-align: left; background: none; border: 0; padding: 10px; border-radius: 6px; cursor: pointer; font-size: .93rem; font-weight: 600; }
.menu button:hover { background: var(--hover); }
.seen-line { display: flex; align-items: center; gap: 12px; color: var(--label2); font-size: .82rem; font-weight: 600; margin: 8px 0 24px; }
.seen-line::before, .seen-line::after { content: ""; flex: 1; border-top: 1px solid var(--sep); }
.empty { color: var(--label2); padding: 48px 20px; text-align: center; }

/* Gemerkt */
.seg { display: inline-flex; gap: 4px; }
.seg button { background: var(--fill); border: 0; border-radius: 999px; padding: 8px 14px; cursor: pointer; font-weight: 600; font-size: .9rem; }
.seg button[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent); }
.list-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
.form { padding: 16px; display: grid; gap: 10px; }
.form input, .form select { width: 100%; background: var(--bg); border: 1px solid var(--sep); border-radius: 8px; padding: 10px 12px; font-size: 16px; }
.form input:focus, .form select:focus { outline: 2px solid var(--accent); border-color: transparent; }
.form .row { display: flex; gap: 10px; flex-wrap: wrap; }
.form .row > * { flex: 1 1 160px; }
.form label { font-size: .85rem; color: var(--label2); font-weight: 500; }
.form label input, .form label select { margin-top: 4px; }
.form label input[type=number] { width: 90px; }
.form .check { display: flex; gap: 8px; align-items: center; color: var(--text); font-size: .93rem; }
.form .check input { width: auto; margin: 0; }
.btn { background: var(--accent); color: #fff; border: 0; border-radius: 6px; padding: 9px 16px; font-weight: 600; cursor: pointer; }
.btn.plain { background: var(--fill); color: var(--text); }

/* Einstellungen */
.admin { padding: 16px; }
.admin h2 { font-size: 1.1rem; font-weight: 700; margin: 0 0 4px; }
.admin .lead { color: var(--label2); font-size: .86rem; margin: 0 0 12px; }
.admin .form { padding: 0; }
.table { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: .87rem; }
th, td { text-align: left; padding: 9px 10px 9px 0; border-bottom: 1px solid var(--sep); vertical-align: top; }
th { color: var(--label2); font-weight: 600; font-size: .78rem; white-space: nowrap; }
.num { text-align: right; }
.link.danger { color: var(--red); }
.actions-cell { white-space: nowrap; }
.actions-cell .link + .link { margin-left: 12px; }
.vote-up { color: var(--green); font-weight: 600; } .vote-down { color: var(--red); font-weight: 600; }
.hits { margin: 6px 0 0; padding-left: 18px; font-size: .85rem; }
.admin ul.plain { list-style: none; padding: 0; margin: 0; font-size: .93rem; }
.admin ul.plain li { display: flex; justify-content: space-between; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--sep); }

/* Tab-Leiste unten (Handy) */
.tabbar { display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; background: var(--card); box-shadow: 0 -1px 0 var(--sep);
  padding-bottom: env(safe-area-inset-bottom); }
.tabbar .in { display: flex; }
.tabbar button { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; background: none; border: 0;
  padding: 8px 0 6px; color: var(--label2); font-size: .7rem; font-weight: 600; cursor: pointer; border-top: 3px solid transparent; }
.tabbar button[aria-selected="true"] { color: var(--accent); border-top-color: var(--accent); }
.tabbar svg { width: 24px; height: 24px; }

.toast { position: fixed; left: 24px; bottom: 24px; z-index: 30; background: var(--card); color: var(--text); border-radius: 8px;
  padding: 12px 16px; font-size: .92rem; font-weight: 500; display: flex; gap: 16px; align-items: center; box-shadow: var(--shadow-lg); white-space: nowrap; }
.toast button { background: none; border: 0; color: var(--accent); font-weight: 700; cursor: pointer; }
footer { color: var(--label2); font-size: .8rem; padding: 4px 0 24px; }

/* Passwort-Sperre */
.gate { display: none; }
html.locked .navbar, html.locked .shell, html.locked .tabbar { display: none; }
html.locked .gate { display: grid; place-items: center; min-height: 100vh; padding: 24px; }
.gate form { width: 100%; max-width: 360px; text-align: center; background: var(--card); border-radius: 12px; box-shadow: var(--shadow-lg); padding: 28px 20px 20px; }
.gate img { width: 64px; height: 64px; border-radius: 14px; }
.gate h1 { font-size: 1.5rem; font-weight: 800; letter-spacing: -.02em; margin: 12px 0 2px; }
.gate p { color: var(--label2); margin: 0 0 18px; font-size: .92rem; }
.gate input { width: 100%; background: var(--card); border: 1px solid var(--sep); border-radius: 6px; padding: 13px 14px; font-size: 16px; }
.gate input:focus { outline: 2px solid var(--accent); border-color: transparent; }
.gate .btn { width: 100%; margin-top: 10px; padding: 12px; font-size: 1.05rem; }
.gate .err { color: var(--red); font-size: .88rem; margin-top: 10px; min-height: 1.3em; }

/* Bis 1250 px: rechte Spalte wandert über den Feed */
@media (max-width: 1250px) {
  .shell { grid-template-columns: 260px minmax(0, 600px); grid-template-areas: "left head" "left right" "left main"; grid-template-rows: auto auto 1fr; justify-content: center; }
  .right { position: static; max-height: none; overflow: visible; padding: 0; }
  .navbar { grid-template-columns: 260px minmax(0, 600px) 1fr; }
}
/* Bis 900 px: Handy-Aufbau mit Tab-Leiste und Chips */
@media (max-width: 900px) {
  .shell { grid-template-columns: minmax(0, 600px); grid-template-areas: "head" "right" "main"; }
  .left { display: none; }
  .chips { display: flex; }
  .tabbar { display: block; }
  .navbar { grid-template-columns: auto 1fr auto; gap: 10px; }
  main { padding-bottom: calc(90px + env(safe-area-inset-bottom)); }
  .toast { left: 50%; transform: translateX(-50%); bottom: calc(80px + env(safe-area-inset-bottom)); }
}
@media (max-width: 520px) {
  .shell { padding: 0; }
  .head, .chips, .active-filter, .list-head, footer, .empty { padding-left: 12px; padding-right: 12px; }
  .chips { margin: 0 0 12px; }
  main .card, .right .card { border-radius: 0; margin-bottom: 8px; }
  .brand b { font-size: 1.1rem; }
  .actions .lbl { display: none; }
  .page-title { font-size: 1.5rem; }
}
</style>
</head>
<body>
{% set ico_feed %}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm2 4v2h12V8H6zm0 4v2h12v-2H6zm0 4v1h8v-1H6z"/></svg>{% endset %}
{% set ico_studies %}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 13h3v7H4zM10.5 4h3v16h-3zM17 9h3v11h-3z"/></svg>{% endset %}
{% set ico_community %}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3c5 0 9 3.6 9 8s-4 8-9 8c-1.1 0-2.2-.2-3.2-.5L4 20l1.3-3.7C3.9 14.9 3 13 3 11c0-4.4 4-8 9-8z"/></svg>{% endset %}
{% set ico_saved %}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg>{% endset %}
{% set tabs = [("feed", "Feed", ico_feed), ("studies", "Studien", ico_studies), ("community", "Community", ico_community), ("saved", "Gemerkt", ico_saved)] %}

{% if password_hash %}
<div class="gate">
  <form id="gateForm">
    <img src="logo.svg" alt="">
    <h1>Radar</h1>
    <p>Bitte Passwort eingeben.</p>
    <input type="password" id="gatePw" autocomplete="current-password" placeholder="Passwort" aria-label="Passwort" autofocus>
    <button class="btn" type="submit">Öffnen</button>
    <div class="err" id="gateErr"></div>
  </form>
</div>
<script>
  (function () {
    var HASH = "{{ password_hash }}";
    document.getElementById("gateForm").addEventListener("submit", function (e) {
      e.preventDefault();
      var pw = document.getElementById("gatePw").value;
      crypto.subtle.digest("SHA-256", new TextEncoder().encode(pw)).then(function (buf) {
        var hex = Array.prototype.map.call(new Uint8Array(buf), function (b) { return b.toString(16).padStart(2, "0"); }).join("");
        if (hex === HASH) {
          try { localStorage.setItem("psn-auth", HASH); } catch (err) {}
          document.documentElement.classList.remove("locked");
        } else {
          document.getElementById("gateErr").textContent = "Falsches Passwort.";
        }
      });
    });
  })();
</script>
{% endif %}

<header class="navbar">
  <a class="brand" href="./" aria-label="Radar"><img src="logo.svg" alt=""><b>Radar</b></a>
  <label class="search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="search" id="q" placeholder="In Radar suchen" aria-label="Suche">
  </label>
  <button class="round" id="adminBtn" type="button" aria-pressed="false" title="Einstellungen" aria-label="Einstellungen">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65a.5.5 0 0 0 .12-.64l-2-3.46a.5.5 0 0 0-.61-.22l-2.49 1a7.3 7.3 0 0 0-1.69-.98l-.38-2.65A.49.49 0 0 0 14 2h-4a.49.49 0 0 0-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1a.5.5 0 0 0-.61.22l-2 3.46a.49.49 0 0 0 .12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65a.5.5 0 0 0-.12.64l2 3.46a.5.5 0 0 0 .61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1a.5.5 0 0 0 .61-.22l2-3.46a.5.5 0 0 0-.12-.64l-2.11-1.65zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z"/></svg>
  </button>
</header>

<div class="shell">
  {# ---------- Linke Spalte: Bereiche und Themen ---------- #}
  <aside class="left">
    <nav class="nav" aria-label="Bereiche">
      {% for key, label, icon in tabs %}
      <button type="button" data-tab="{{ key }}" aria-selected="{{ 'true' if loop.first else 'false' }}"><span class="ic ic-{{ key }}">{{ icon }}</span>{{ label }}{% if key == "saved" %}<span class="n" id="nSavedSide"></span>{% endif %}</button>
      {% endfor %}
    </nav>
    <p class="nav-title">Themen</p>
    <nav class="nav topic-nav" aria-label="Themen">
      <button type="button" data-topic="" aria-pressed="true"><span class="hash">#</span>Alle Themen</button>
      {% for t in topics if topic_counts[t] %}
      <button type="button" data-topic="{{ t }}" aria-pressed="false" title="{{ ['', 'normal', 'wichtig', 'sehr wichtig'][weights[t]] }}"><span class="hash w{{ weights[t] }}">#</span>{{ t }}<span class="n">{{ topic_counts[t] }}</span></button>
      {% endfor %}
    </nav>
  </aside>

  <div class="head">
    <p class="eyebrow"><time class="today"></time></p>
    <h1 class="page-title" id="pageTitle">Feed</h1>
    <div class="chips topic-nav" id="chips" role="group" aria-label="Themen">
      <button class="chip" type="button" data-topic="" aria-pressed="true">Alle</button>
      {% for t in topics if topic_counts[t] %}
      <button class="chip" type="button" data-topic="{{ t }}" aria-pressed="false">{{ t }}<span class="n">{{ topic_counts[t] }}</span></button>
      {% endfor %}
    </div>
  </div>

  {# ---------- Rechte Spalte: Briefing ---------- #}
  <aside class="right">
    {% set brief = yesterday.topics[:3] %}
    {% if brief or trends or stories %}
    <section class="card side-card" id="briefing">
      <div class="side-head">
        <div><h2>Briefing</h2>{% if brief %}<span class="date">für <time class="day" datetime="{{ yesterday.date }}">{{ yesterday.date }}</time></span>{% endif %}</div>
        <button class="link" type="button" id="briefToggle">Einklappen</button>
      </div>
      <div id="briefBody">
        {% if brief %}
        <div class="b-sec">
          <h3>Gestern wichtig</h3>
          {% for row in brief %}
          {% set top = row.articles[0] %}
          <div class="b-item">
            <button class="b-topic" type="button" data-topic="{{ row.topic }}">#{{ row.topic }}</button>
            <a class="b-title" href="{{ top.link }}" target="_blank" rel="noopener nofollow external">{{ top.title }}</a>
            <span class="n">{{ top.source }}{% if row.count > 1 %} · <button class="link" type="button" data-topic="{{ row.topic }}">{{ row.count - 1 }} weitere</button>{% endif %}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {% if trends %}
        <div class="b-sec">
          <h3>Im Trend</h3>
          <div class="trend-chips">{% for t in trends %}<button class="chip" type="button" data-q="{{ t.term }}" title="{{ t.count }} Beiträge von {{ t.sources }} Quellen in den letzten 3 Tagen">{{ t.term }}</button>{% endfor %}</div>
        </div>
        {% endif %}
        {% if stories %}
        <div class="b-sec">
          <h3>Mehrfach berichtet</h3>
          {% for c in stories[:2] %}
          <div class="b-item"><a class="b-title" href="{{ c.articles[0].link }}" target="_blank" rel="noopener nofollow external">{{ c.title }}</a><span class="n">{{ c.sources }} Quellen</span></div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    {% if community %}
    <section class="card side-card" id="communityBrief" hidden>
      <h2>Diese Woche in der Community</h2>
      <div class="trend-chips" style="margin-top:10px">{% for t, n in community %}<button class="chip" type="button" data-topic="{{ t }}">{{ t }} · {{ n }}</button>{% endfor %}</div>
    </section>
    {% endif %}
  </aside>

  <main>
    <p class="active-filter" id="activeFilter" hidden>Gefiltert: <button type="button" id="clearFilter"></button></p>

    {# ---------- Gemerkt ---------- #}
    <section id="savedHead" hidden>
      <div class="list-head">
        <div class="seg" id="seg">
          <button type="button" data-list="favs" aria-pressed="true">Gemerkt <span class="n" id="nFavs">0</span></button>
          <button type="button" data-list="blog" aria-pressed="false">Blog-Ideen <span class="n" id="nBlog">0</span></button>
        </div>
        <div>
          <button class="btn plain" type="button" id="copyList">Kopieren</button>
          <button class="btn" type="button" id="addBtn">+ Link</button>
        </div>
      </div>
      <form class="card form" id="addForm" hidden>
        <input type="url" id="addUrl" placeholder="Link zu einem Artikel von anderswo" required>
        <input type="text" id="addTitle" placeholder="Titel (optional)">
        <select id="addTopic"><option value="">Thema (optional)</option>{% for t in topics %}<option>{{ t }}</option>{% endfor %}</select>
        <div><button class="btn" type="submit">Ablegen</button> <button class="link" type="button" id="addCancel">Abbrechen</button></div>
      </form>
    </section>

    <div id="feed">
    {% for item in items %}
    <article class="card post" data-id="{{ item.id }}" data-cat="{{ item.category }}" data-source="{{ item.source }}"
      data-domain="{{ item.domain }}" data-seen="{{ item.first_seen }}" data-published="{{ item.published }}"
      data-topics="{{ item.topics|join('|') }}" data-weight="{{ item.weight }}" data-study="{{ 1 if item.study else 0 }}"
      data-text="{{ (item.title ~ ' ' ~ item.snippet ~ ' ' ~ item.source ~ ' ' ~ item.topics|join(' '))|lower }}">
      <header class="post-head">
        <span class="avatar" aria-hidden="true">{{ item.source[:2]|upper }}<img src="https://www.google.com/s2/favicons?domain={{ item.domain }}&amp;sz=128" alt="" loading="lazy" onerror="this.remove()"></span>
        <div class="who">
          <button class="src" type="button" title="Nur diese Quelle zeigen">{{ item.source }}</button>
          <span class="sub"><time datetime="{{ item.published }}">{{ item.published[8:10] }}.{{ item.published[5:7] }}.{{ item.published[0:4] }}</time></span>
        </div>
        {% if item.study %}<span class="badge">Studie</span>{% endif %}
      </header>
      <div class="post-body">
        <h2><a href="{{ item.link }}" target="_blank" rel="noopener nofollow external">{{ item.title }}</a></h2>
        {% if item.snippet %}<p>{{ item.snippet }}</p>{% endif %}
      </div>
      {% if item.topics %}<div class="post-body tags-wrap"><div class="tags">{% for t in item.topics %}<button class="tag" type="button" data-topic="{{ t }}">{{ t }}</button>{% endfor %}</div></div>{% endif %}
      {% if item.image %}
      <a class="post-img" href="{{ item.link }}" target="_blank" rel="noopener nofollow external" tabindex="-1" aria-hidden="true">
        <img src="{{ item.image }}" alt="" loading="lazy" decoding="async" onerror="this.parentNode.remove()">
      </a>
      {% endif %}
      <div class="actions">
        <button class="act-favs" type="button" data-act="favs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4V3z"/></svg><span class="lbl">Merken</span></button>
        <button class="act-blog" type="button" data-act="blog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4L16.5 3.5z"/></svg><span class="lbl">Blog-Idee</span></button>
        <button class="more" type="button" data-act="menu" aria-label="Weitere Aktionen"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg></button>
      </div>
    </article>
    {% endfor %}
    </div>
    <div id="listFeed" hidden></div>
    <p class="empty" id="empty" hidden></p>

    {# ---------- Einstellungen ---------- #}
    <section id="admin" hidden>
      <div class="card admin">
        <h2>Quelle aufnehmen</h2>
        <p class="lead">Link zu einer Seite oder einem Artikel eingeben. Der Knopf öffnet GitHub mit einem vorbereiteten Auftrag;
          dort auf «Create» klicken. Eine Action sucht den Feed, trägt die Quelle in <code>sources.yaml</code> ein und baut die Seite neu.
          Nach etwa 3 Minuten ist sie im Feed, das Ergebnis steht als Kommentar im Auftrag.</p>
        <form class="form" id="sourceForm">
          <input type="url" id="srcUrl" placeholder="https://… Seite, Blog oder Feed" required>
          <div class="row">
            <select id="srcCat" aria-label="Kategorie">{% for c in categories %}<option{% if c == "News" %} selected{% endif %}>{{ c }}</option>{% endfor %}</select>
            <input type="text" id="srcName" placeholder="Name (optional)">
          </div>
          <div><button class="btn" type="submit">Auf GitHub aufnehmen</button></div>
        </form>
      </div>

      <div class="card admin">
        <h2>Quellen</h2>
        <p class="lead">Feste Quellen, letzte {{ max_age_days }} Tage. «Themen» = Anteil der Beiträge mit Themen-Treffer.
          Bewertung und Gemerkt stammen aus diesem Browser.</p>
        <div class="table"><table>
          <thead><tr><th>Quelle</th><th class="num">Beiträge</th><th class="num">Themen</th><th>Letzter</th><th>Bewertung</th><th class="num">Gemerkt</th><th></th></tr></thead>
          <tbody>
          {% for s in stats %}
            <tr data-source="{{ s.name }}">
              <td><strong>{{ s.name }}</strong><br><span class="n">{{ s.category }} · {{ s.host }}</span></td>
              <td class="num">{{ s.count }}</td>
              <td class="num">{{ s.topic_share ~ " %" if s.topic_share is not none else "–" }}</td>
              <td>{% if s.latest %}<time datetime="{{ s.latest }}">{{ s.latest[8:10] }}.{{ s.latest[5:7] }}.</time>{% else %}–{% endif %}</td>
              <td class="c-vote">–</td><td class="num c-saved">0</td>
              <td><button class="link danger" type="button" data-issue="Quelle entfernen: {{ s.name }}" data-body="name: {{ s.name }}" data-confirm="{{ s.name }} entfernen?">Entfernen</button></td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      </div>

      <div class="card admin">
        <h2>Regeln für alle Quellen</h2>
        <p class="lead">Gelten für jede Quelle gleich, auch für die Google-News-Suchen. Liefert eine Quelle damit nichts
          Brauchbares, besser entfernen statt eine Ausnahme machen.</p>
        <form class="form" id="rulesForm">
          <div class="row">
            <label>Titel mindestens (Wörter)<br><input type="number" id="ruleWords" min="0" max="30" value="{{ rules.min_woerter or 0 }}"></label>
            <label>Nur Beiträge mit Thema<br><select id="ruleWeight">
              {% for v, label in [(0, "aus (alle Beiträge)"), (1, "irgendein Thema"), (2, "ab «wichtig»"), (3, "nur «sehr wichtig»")] %}
              <option value="{{ v }}"{% if (rules.mindest_gewicht or 0) == v %} selected{% endif %}>{{ label }}</option>{% endfor %}
            </select></label>
          </div>
          <label class="check"><input type="checkbox" id="ruleJobs"{% if rules.stellenanzeigen_ausblenden is not sameas false %} checked{% endif %}> Stellenanzeigen ausblenden</label>
          <input type="text" id="ruleExclude" value="{{ (rules.ausschliessen or [])|join(', ') }}" placeholder="Begriffe im Titel ausschliessen, mit Komma getrennt (z.B. webinar, podcast)">
          <div><button class="btn" type="submit">Regeln auf GitHub speichern</button></div>
        </form>
      </div>

      <div class="card admin">
        <h2>Themen</h2>
        <p class="lead">Ein Beitrag erhält ein Thema, wenn eines der Stichwörter in Titel oder Anriss steht. Das Gewicht steuert
          Briefing und Reihenfolge (3 = sehr wichtig). Leerzeichen um ein Stichwort verhindern Teiltreffer (« ki »).</p>
        <div class="table"><table>
          <thead><tr><th>Thema</th><th>Gewicht</th><th>Stichwörter</th><th></th></tr></thead>
          <tbody>
          {% for t in topic_defs %}
            <tr>
              <td><strong>{{ t.name }}</strong><br><span class="n">{{ topic_counts[t.name] }} Beiträge</span></td>
              <td>{{ ["", "normal", "wichtig", "sehr wichtig"][t.gewicht or 1] }}</td>
              <td class="n">{{ t.stichwoerter|join(", ") }}</td>
              <td class="actions-cell">
                <button class="link" type="button" data-edit-topic="{{ t.name }}" data-weight="{{ t.gewicht or 1 }}" data-words="{{ t.stichwoerter|join(', ') }}">Bearbeiten</button>
                <button class="link danger" type="button" data-issue="Thema: {{ t.name }}" data-body="name: {{ t.name }}&#10;entfernen: ja" data-confirm="Thema {{ t.name }} entfernen?">Entfernen</button>
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
        <form class="form" id="topicForm" style="margin-top:14px">
          <div class="row">
            <input type="text" id="topicName" placeholder="Thema, z.B. YouTube" required>
            <select id="topicWeight" aria-label="Gewicht"><option value="1">normal</option><option value="2">wichtig</option><option value="3">sehr wichtig</option></select>
          </div>
          <input type="text" id="topicWords" placeholder="Stichwörter mit Komma getrennt, z.B. youtube, video ads, ctv">
          <div><button class="btn" type="submit">Thema auf GitHub speichern</button> <span class="n">Neu oder bestehendes ändern (gleicher Name)</span></div>
        </form>
      </div>

      <div class="card admin">
        <h2>Suchbegriffe für Vorschläge</h2>
        <p class="lead">Mit diesen Begriffen sucht Radar in Google News nach Seiten, die noch keine Quelle sind
          (Liste «Vorschläge für neue Quellen»). «…» sucht die genaue Phrase, OR verbindet Alternativen.</p>
        <ul class="plain">
          {% for b in search_defs %}
          <li><span>{{ b.begriff }} <span class="n">· {{ "Schweiz (de)" if b.sprache == "de" else "USA (en)" }}</span></span>
            <button class="link danger" type="button" data-issue="Suchbegriff: {{ b.begriff }}" data-body="begriff: {{ b.begriff }}&#10;sprache: {{ b.sprache or 'en' }}&#10;entfernen: ja" data-confirm="Suchbegriff {{ b.begriff }} entfernen?">Entfernen</button></li>
          {% endfor %}
        </ul>
        <form class="form" id="searchForm" style="margin-top:14px">
          <div class="row">
            <input type="text" id="searchTerm" placeholder='z.B. "Consent Mode" Google' required>
            <select id="searchLang" aria-label="Sprache"><option value="en">USA (en)</option><option value="de">Schweiz (de)</option></select>
          </div>
          <div><button class="btn" type="submit">Suchbegriff auf GitHub hinzufügen</button></div>
        </form>
      </div>

      <div class="card admin">
        <h2>Stummgeschaltete Quellen</h2>
        <ul class="plain" id="mutedList"></ul>
        <p class="lead" id="mutedEmpty">Keine. Über «⋯» bei einem Beitrag lässt sich eine Quelle stummschalten.</p>
      </div>

      {% if unknown %}
      <div class="card admin">
        <h2>Vorschläge für neue Quellen</h2>
        <p class="lead">Seiten, die bei den Google-News-Suchbegriffen auftauchen und noch keine feste Quelle sind, häufigste zuerst.</p>
        <div class="table"><table>
          <thead><tr><th>Seite</th><th class="num">Treffer</th><th>Zuletzt</th><th></th></tr></thead>
          <tbody>
          {% for u in unknown[:40] %}
            <tr><td><a href="https://{{ u.domain }}" target="_blank" rel="noopener nofollow external">{{ u.domain }}</a>
                <details><summary class="n">Artikel zeigen</summary><ul class="hits">
                  {% for a in u.articles %}<li><a href="{{ a.link }}" target="_blank" rel="noopener nofollow external">{{ a.title }}</a></li>{% endfor %}
                </ul></details></td>
              <td class="num">{{ u.count }}</td>
              <td><time datetime="{{ u.latest }}">{{ u.latest[8:10] }}.{{ u.latest[5:7] }}.</time></td>
              <td><button class="link" type="button" data-suggest="https://{{ u.domain }}">Aufnehmen</button></td></tr>
          {% endfor %}
          </tbody>
        </table></div>
      </div>
      {% endif %}

      <div class="card admin">
        <h2>Darstellung</h2>
        <div class="seg" id="themeSeg"><button type="button" data-theme="" aria-pressed="true">Automatisch</button><button type="button" data-theme="light" aria-pressed="false">Hell</button><button type="button" data-theme="dark" aria-pressed="false">Dunkel</button></div>
      </div>

      <div class="card admin">
        <h2>Letzter Lauf</h2>
        <p class="lead">Stand: <time id="generated" datetime="{{ generated }}">{{ generated[:16]|replace("T", " ") }} UTC</time> · {{ stats|length }} feste Quellen.
          Läuft automatisch alle 3 Stunden.</p>
        {% if repo %}<p><a class="btn" href="https://github.com/{{ repo }}/actions/workflows/build.yml" target="_blank" rel="noopener nofollow external">Jetzt aktualisieren</a>
          <span class="n">öffnet GitHub, dort «Run workflow»</span></p>{% endif %}
        {% if errors %}
        <ul class="plain">{% for e in errors %}<li><span>{{ e.source }}</span><span class="n">{{ e.error }}</span></li>{% endfor %}</ul>
        {% else %}<p class="lead">Alle Quellen erreichbar.</p>{% endif %}
      </div>
    </section>

    <footer>Inhalte gehören den jeweiligen Quellen.</footer>
  </main>
</div>

<nav class="tabbar" aria-label="Bereiche">
  <div class="in">
    {% for key, label, icon in tabs %}
    <button type="button" data-tab="{{ key }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ icon }}{{ label }}</button>
    {% endfor %}
  </div>
</nav>

<div class="toast" id="toast" hidden><span id="toastText"></span><button type="button" id="toastUndo">Rückgängig</button></div>

<script>
(function () {
  var REPO = "{{ repo }}";
  var store = {
    get: function (k, d) { try { var v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
    set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  };
  var $ = function (id) { return document.getElementById(id); };
  var $$ = function (sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); };
  var DAY = 864e5, BOOST = 2 * DAY, WEIGHT_SHIFT = DAY / 4;
  var TITLES = { feed: "Feed", studies: "Studien", community: "Community", saved: "Gemerkt", admin: "Einstellungen" };

  // Farbschema
  var root = document.documentElement, theme = store.get("psn-theme", "");
  function applyTheme() {
    if (theme) root.setAttribute("data-theme", theme); else root.removeAttribute("data-theme");
    $$("#themeSeg button").forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.theme === theme ? "true" : "false"); });
  }
  applyTheme();
  $$("#themeSeg button").forEach(function (b) {
    b.addEventListener("click", function () { theme = b.dataset.theme; store.set("psn-theme", theme); applyTheme(); });
  });

  // Datumsangaben
  var dateFmt = new Intl.DateTimeFormat("de-CH", { day: "numeric", month: "long" });
  var dayFmt = new Intl.DateTimeFormat("de-CH", { weekday: "long", day: "numeric", month: "long" });
  function fmt(iso) {
    var d = new Date(iso), h = (Date.now() - d) / 36e5;
    if (h < 1) return "Gerade eben";
    if (h < 24) return "Vor " + Math.floor(h) + " Std.";
    if (h < 48) return "Gestern";
    return dateFmt.format(d);
  }
  $$(".post time").forEach(function (t) { t.textContent = fmt(t.dateTime); });
  $$("time.day").forEach(function (t) { t.textContent = dayFmt.format(new Date(t.dateTime + "T12:00:00")); });
  $$("time.today").forEach(function (t) { t.textContent = dayFmt.format(new Date()); });
  $("generated").textContent = new Intl.DateTimeFormat("de-CH", { dateStyle: "medium", timeStyle: "short" }).format(new Date($("generated").dateTime));

  function hue(s) { var h = 0; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return h; }
  function paintAvatar(post) { post.querySelector(".avatar").style.setProperty("--h", hue(post.dataset.source)); }

  var feed = $("feed"), listFeed = $("listFeed");
  var posts = Array.prototype.slice.call(feed.querySelectorAll(".post"));
  posts.forEach(paintAvatar);
  var seenLine = document.createElement("div");
  seenLine.className = "seen-line"; seenLine.textContent = "Bis hier gelesen";

  // Was seit dem letzten Besuch neu ist, steht oben; darunter die Linie "Bis hier gelesen"
  var lastVisit = store.get("psn-last-visit", null);
  store.set("psn-last-visit", new Date().toISOString());
  function isNew(p) { return !!lastVisit && p.dataset.seen > lastVisit; }

  // Im Browser gespeichert: Bewertung je Quelle (+1 mehr, -1 stumm), Gemerkt, Blog-Ideen
  var votes = store.get("psn-votes", {});
  var lists = { favs: store.get("psn-favs", {}), blog: store.get("psn-blog", {}) };
  var briefOpen = store.get("psn-brief-open", true);

  function snapshot(post) {
    var a = post.querySelector("h2 a"), p = post.querySelector(".post-body p"), img = post.querySelector(".post-img img");
    return { id: post.dataset.id, title: a.textContent, link: a.href, source: post.dataset.source, domain: post.dataset.domain,
      category: post.dataset.cat, published: post.dataset.published, snippet: p ? p.textContent : "",
      image: img ? img.src : null, topics: post.dataset.topics, saved: new Date().toISOString() };
  }

  var state = { tab: "feed", list: "favs", admin: false, topic: "", source: "", q: "" };
  var TABS = {
    feed: function (p) { return p.dataset.cat !== "Community"; },
    studies: function (p) { return p.dataset.study === "1"; },
    community: function (p) { return p.dataset.cat === "Community"; }
  };
  var EMPTY = {
    feed: "Keine Beiträge für diese Auswahl.", studies: "Keine Studien für diese Auswahl.", community: "Keine Community-Beiträge für diese Auswahl.",
    favs: "Noch nichts gemerkt. Über «Merken» bei einem Beitrag oder «+ Link» landet es hier.",
    blog: "Noch keine Blog-Ideen. Über «Blog-Idee» bei einem Beitrag oder «+ Link» landet es hier."
  };

  function score(p) {
    return new Date(p.dataset.published).getTime() + (votes[p.dataset.source] > 0 ? BOOST : 0) + (+p.dataset.weight || 0) * WEIGHT_SHIFT;
  }
  function matches(p) {
    var terms = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    return TABS[state.tab](p) && !(votes[p.dataset.source] < 0)
      && (!state.topic || p.dataset.topics.split("|").indexOf(state.topic) !== -1)
      && (!state.source || p.dataset.source === state.source)
      && terms.every(function (t) { return p.dataset.text.indexOf(t) !== -1; });
  }
  function decorate(p) {
    p.classList.toggle("is-fav", !!lists.favs[p.dataset.id]);
    p.classList.toggle("is-blog", !!lists.blog[p.dataset.id]);
  }

  function buildSavedPost(f) {
    var live = feed.querySelector('.post[data-id="' + CSS.escape(f.id) + '"]');
    if (live) { var c = live.cloneNode(true); c.hidden = false; return c; }
    // Nicht (mehr) im Feed: aus dem gespeicherten Stand aufbauen
    var tpl = posts[0].cloneNode(true);
    tpl.hidden = false;
    Object.assign(tpl.dataset, { id: f.id, source: f.source, cat: f.category, published: f.published, topics: f.topics || "", domain: f.domain || "" });
    var av = tpl.querySelector(".avatar"), favicon = av.querySelector("img");
    av.firstChild.textContent = f.source.slice(0, 2).toUpperCase();
    if (favicon) { if (f.domain) favicon.src = "https://www.google.com/s2/favicons?domain=" + encodeURIComponent(f.domain) + "&sz=128"; else favicon.remove(); }
    tpl.querySelector(".src").textContent = f.source;
    tpl.querySelector(".sub").textContent = f.category === "Abgelegt" ? "Selbst abgelegt" : fmt(f.published);
    var a = tpl.querySelector("h2 a"); a.textContent = f.title; a.href = f.link;
    var p = tpl.querySelector(".post-body p"); if (p) { p.textContent = f.snippet || ""; p.hidden = !f.snippet; }
    ["tags-wrap", "badge", "post-img"].forEach(function (cls) { var el = tpl.querySelector("." + cls); if (el) el.remove(); });
    if (f.topics) {
      var wrap = document.createElement("div"), box = document.createElement("div");
      wrap.className = "post-body tags-wrap"; box.className = "tags";
      f.topics.split("|").forEach(function (t) {
        var b = document.createElement("button"); b.className = "tag"; b.type = "button"; b.dataset.topic = t; b.textContent = t; box.appendChild(b);
      });
      wrap.appendChild(box); tpl.querySelector(".actions").before(wrap);
    }
    return tpl;
  }

  function renderAdmin() {
    $$("#admin tr[data-source]").forEach(function (tr) {
      var name = tr.dataset.source, v = votes[name] || 0, cell = tr.querySelector(".c-vote");
      cell.textContent = v > 0 ? "▲ mehr" : v < 0 ? "stumm" : "–";
      cell.className = "c-vote " + (v > 0 ? "vote-up" : v < 0 ? "vote-down" : "");
      tr.querySelector(".c-saved").textContent = ["favs", "blog"].reduce(function (sum, l) {
        return sum + Object.keys(lists[l]).filter(function (id) { return lists[l][id].source === name; }).length;
      }, 0);
    });
    var muted = Object.keys(votes).filter(function (n) { return votes[n] < 0; }).sort(), ul = $("mutedList");
    ul.innerHTML = "";
    muted.forEach(function (name) {
      var li = document.createElement("li"), b = document.createElement("button");
      li.appendChild(document.createTextNode(name));
      b.className = "link"; b.type = "button"; b.textContent = "Zurückholen";
      b.addEventListener("click", function () { delete votes[name]; store.set("psn-votes", votes); render(); });
      li.appendChild(b); ul.appendChild(li);
    });
    $("mutedEmpty").hidden = muted.length > 0;
  }

  function render() {
    var tab = state.tab, saved = tab === "saved", shown = 0, admin = state.admin;
    var filtered = !!(state.topic || state.source || state.q);
    var nFavs = Object.keys(lists.favs).length, nBlog = Object.keys(lists.blog).length;
    $("nFavs").textContent = nFavs; $("nBlog").textContent = nBlog;
    $("nSavedSide").textContent = nFavs + nBlog || "";
    $("pageTitle").textContent = TITLES[admin ? "admin" : tab];
    $("adminBtn").setAttribute("aria-pressed", admin ? "true" : "false");
    $$("[data-tab]").forEach(function (b) { b.setAttribute("aria-selected", !admin && b.dataset.tab === tab ? "true" : "false"); });
    $$(".topic-nav [data-topic]").forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.topic === state.topic ? "true" : "false"); });
    $("admin").hidden = !admin;
    $("chips").hidden = admin || saved;
    var briefing = $("briefing"), communityBrief = $("communityBrief");
    if (briefing) {
      briefing.hidden = admin || tab !== "feed" || filtered;
      $("briefBody").hidden = !briefOpen;
      $("briefToggle").textContent = briefOpen ? "Einklappen" : "Aufklappen";
    }
    if (communityBrief) communityBrief.hidden = admin || tab !== "community" || filtered;
    $("savedHead").hidden = admin || !saved;
    feed.hidden = admin || saved;
    listFeed.hidden = admin || !saved;
    $("activeFilter").hidden = admin || saved || !(state.topic || state.source);
    $("clearFilter").textContent = (state.source ? state.source : "#" + state.topic) + "  ✕";

    if (admin) {
      renderAdmin();
    } else if (saved) {
      listFeed.innerHTML = "";
      Object.keys(lists[state.list]).map(function (id) { return lists[state.list][id]; })
        .sort(function (a, b) { return b.saved.localeCompare(a.saved); })
        .forEach(function (f) { var p = buildSavedPost(f); paintAvatar(p); decorate(p); listFeed.appendChild(p); shown++; });
    } else {
      posts.sort(function (a, b) {
        var na = isNew(a), nb = isNew(b);
        return na !== nb ? (na ? -1 : 1) : score(b) - score(a);
      });
      var lineAfter = null;
      posts.forEach(function (p) {
        decorate(p);
        var ok = matches(p);
        p.hidden = !ok;
        if (ok) { shown++; if (isNew(p)) lineAfter = p; }
        feed.appendChild(p);
      });
      var lastShown = posts.filter(function (p) { return !p.hidden; }).pop();
      if (lineAfter && !filtered && lineAfter !== lastShown) lineAfter.after(seenLine); else seenLine.remove();
    }
    $("empty").hidden = admin || shown > 0;
    $("empty").textContent = EMPTY[saved ? state.list : tab];
  }

  function go(changes) { Object.assign(state, changes); render(); window.scrollTo(0, 0); }
  function filterTab() { return TABS[state.tab] ? state.tab : "feed"; }

  $$("[data-tab]").forEach(function (b) { b.addEventListener("click", function () { go({ tab: b.dataset.tab, admin: false }); }); });
  $("adminBtn").addEventListener("click", function () { go({ admin: !state.admin }); });
  $("q").addEventListener("input", function (e) { state.q = e.target.value; state.admin = false; render(); });
  $("clearFilter").addEventListener("click", function () { go({ topic: "", source: "" }); });
  var briefToggle = $("briefToggle");
  if (briefToggle) briefToggle.addEventListener("click", function () { briefOpen = !briefOpen; store.set("psn-brief-open", briefOpen); render(); });
  $$("#seg button").forEach(function (b) {
    b.addEventListener("click", function () {
      $$("#seg button").forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      go({ list: b.dataset.list });
    });
  });

  // Hinweis unten mit "Rückgängig"
  var toastTimer, undoFn;
  function toast(text, undo) {
    $("toastText").textContent = text; undoFn = undo; $("toastUndo").hidden = !undo; $("toast").hidden = false;
    clearTimeout(toastTimer); toastTimer = setTimeout(function () { $("toast").hidden = true; }, 4000);
  }
  $("toastUndo").addEventListener("click", function () { if (undoFn) undoFn(); $("toast").hidden = true; });

  function closeMenus() { $$(".menu").forEach(function (m) { m.remove(); }); }
  function openMenu(post, anchor) {
    closeMenus();
    var src = post.dataset.source, menu = document.createElement("div");
    menu.className = "menu";
    var boost = document.createElement("button"), mute = document.createElement("button");
    boost.type = mute.type = "button";
    boost.textContent = votes[src] > 0 ? "«Mehr von " + src + "» aufheben" : "Mehr von " + src + " anzeigen";
    mute.textContent = src + " stummschalten";
    boost.addEventListener("click", function () {
      if (votes[src] > 0) delete votes[src]; else votes[src] = 1;
      store.set("psn-votes", votes); closeMenus(); render();
      toast(votes[src] > 0 ? src + " erscheint weiter oben" : "Zurückgesetzt");
    });
    mute.addEventListener("click", function () {
      var before = votes[src];
      votes[src] = -1; store.set("psn-votes", votes); closeMenus(); render();
      toast(src + " stummgeschaltet", function () {
        if (before === undefined) delete votes[src]; else votes[src] = before;
        store.set("psn-votes", votes); render();
      });
    });
    menu.appendChild(boost); menu.appendChild(mute);
    anchor.parentNode.appendChild(menu);
  }

  document.addEventListener("click", function (e) {
    if (!e.target.closest(".menu") && !e.target.closest("[data-act=menu]")) closeMenus();
    var suggest = e.target.closest("[data-suggest]");
    if (suggest) { $("srcUrl").value = suggest.dataset.suggest; $("srcUrl").scrollIntoView({ block: "center" }); $("srcUrl").focus(); return; }
    var qBtn = e.target.closest("[data-q]");
    if (qBtn) { $("q").value = qBtn.dataset.q; go({ q: qBtn.dataset.q, topic: "", source: "", tab: "feed", admin: false }); return; }
    var topicBtn = e.target.closest("[data-topic]");
    if (topicBtn) { go({ topic: topicBtn.dataset.topic, source: "", tab: filterTab(), admin: false }); return; }
    var srcBtn = e.target.closest(".src");
    if (srcBtn) { go({ source: srcBtn.closest(".post").dataset.source, topic: "", tab: filterTab() }); return; }
    var btn = e.target.closest("[data-act]");
    if (!btn) return;
    var post = btn.closest(".post"), act = btn.dataset.act;
    if (act === "menu") { openMenu(post, btn); return; }
    var list = lists[act], id = post.dataset.id, adding = !list[id];
    if (adding) list[id] = snapshot(post); else delete list[id];
    store.set("psn-" + act, list);
    render();
    toast(adding ? (act === "favs" ? "Gemerkt" : "Als Blog-Idee gemerkt") : "Entfernt");
  });

  // Links von anderswo ablegen
  $("addBtn").addEventListener("click", function () { $("addForm").hidden = false; $("addUrl").focus(); });
  $("addCancel").addEventListener("click", function () { $("addForm").reset(); $("addForm").hidden = true; });
  $("addForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var url = $("addUrl").value.trim(), host;
    try { host = new URL(url).hostname.replace(/^www\./, ""); } catch (err) { return; }
    var now = new Date().toISOString();
    lists[state.list]["manual:" + url] = { id: "manual:" + url, link: url, source: host, domain: host, category: "Abgelegt",
      title: $("addTitle").value.trim() || url.replace(/^https?:\/\/(www\.)?/, "").slice(0, 120),
      published: now, snippet: "", image: null, topics: $("addTopic").value, saved: now };
    store.set("psn-" + state.list, lists[state.list]);
    $("addForm").reset(); $("addForm").hidden = true;
    render(); toast("Abgelegt");
  });
  $("copyList").addEventListener("click", function () {
    var list = lists[state.list];
    var text = Object.keys(list).map(function (id) { var f = list[id]; return "- " + f.title + " (" + f.source + ")\n  " + f.link; }).join("\n");
    if (!text) { toast("Liste ist leer"); return; }
    navigator.clipboard.writeText(text).then(function () { toast("Liste kopiert"); });
  });

  // Änderungen an Quellen, Themen und Suchbegriffen: vorbereiteten Auftrag (Issue) auf GitHub öffnen;
  // die Action settings.yml übernimmt ihn in sources.yaml und baut die Seite neu
  function openIssue(title, body) {
    if (!REPO) { toast("Repository unbekannt"); return; }
    body += "\n\n(Wird automatisch von der Action «Einstellungen übernehmen» verarbeitet.)";
    window.open("https://github.com/" + REPO + "/issues/new?title=" + encodeURIComponent(title) + "&body=" + encodeURIComponent(body), "_blank", "noopener");
    toast("Auf GitHub «Create» klicken – nach etwa 3 Minuten ist es übernommen");
  }
  $("sourceForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var url = $("srcUrl").value.trim();
    openIssue("Quelle: " + url, "url: " + url + "\nkategorie: " + $("srcCat").value + "\nname: " + $("srcName").value.trim());
    $("sourceForm").reset();
  });
  $("topicForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var name = $("topicName").value.trim();
    openIssue("Thema: " + name, "name: " + name + "\ngewicht: " + $("topicWeight").value + "\nstichwoerter: " + $("topicWords").value.trim());
    $("topicForm").reset();
  });
  $("rulesForm").addEventListener("submit", function (e) {
    e.preventDefault();
    openIssue("Regeln: für alle Quellen", "min_woerter: " + $("ruleWords").value + "\nmindest_gewicht: " + $("ruleWeight").value
      + "\nstellenanzeigen_ausblenden: " + ($("ruleJobs").checked ? "ja" : "nein") + "\nausschliessen: " + $("ruleExclude").value.trim());
  });
  $("searchForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var term = $("searchTerm").value.trim();
    openIssue("Suchbegriff: " + term, "begriff: " + term + "\nsprache: " + $("searchLang").value);
    $("searchForm").reset();
  });
  document.querySelector("#admin").addEventListener("click", function (e) {
    var issue = e.target.closest("[data-issue]");
    if (issue && confirm(issue.dataset.confirm)) openIssue(issue.dataset.issue, issue.dataset.body);
    var edit = e.target.closest("[data-edit-topic]");
    if (edit) {
      $("topicName").value = edit.dataset.editTopic; $("topicWeight").value = edit.dataset.weight; $("topicWords").value = edit.dataset.words;
      $("topicName").scrollIntoView({ block: "center" }); $("topicWords").focus();
    }
  });

  render();
})();
</script>
</body>
</html>
